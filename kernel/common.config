# Deliberate Apple-platform capabilities, applied to every supported Mac.
# Dockchannel console/earlycon: expose firmware-provided serial diagnostics.
# SYSFB_SIMPLEFB: generic boot framebuffer fallback, subject to DT sysfb gating.
# DMA heaps and UDMABUF: userspace buffer allocation/import interfaces.
# Thermal netlink and NVMe hwmon: userspace telemetry interfaces.
# Trusted keys stay built in; SEP loads after its persistent root storage is ready.
# These are shared additions, not claims of M1/M2/M3 hardware qualification.
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
CONFIG_THERMAL_NETLINK=y
CONFIG_NVME_HWMON=y
CONFIG_TRUSTED_KEYS=y
CONFIG_APPLE_SEP=m
# MAX98360A speaker codec, also matched by the MAX98357A driver.
CONFIG_SND_SOC_MAX98357A=m

# Built-in Mac hardware must remain available in every distribution profile.
CONFIG_VIDEO_APPLE_ISP=m
CONFIG_VIDEO_APPLE_AVD=m
CONFIG_SND_SOC_APPLE_MACAUDIO=m
CONFIG_SND_SOC_APPLE_MCA=m
CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
CONFIG_HID_APPLE_MTP_HAPTIC=m
CONFIG_SPI_HID_APPLE_OF=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_SND_USB_AUDIO=m

# USB4/Thunderbolt hosts, host-to-host networking and streaming.
CONFIG_USB4=m
CONFIG_USB4_APPLE_SOC=m
# The CIO reset provider must exist before the USB4 routers probe.
CONFIG_RESET_APPLE_CIO=y
CONFIG_USB4_CONFIGFS=m
CONFIG_USB4_NET=m
CONFIG_USB4_STREAM=m

# PCIe devices carried through Thunderbolt docks and enclosures.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGBVF=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_IXGBEVF=m
CONFIG_I40E=m
CONFIG_I40EVF=m
CONFIG_ICE=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKY2=m
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=m
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_ATA=m
CONFIG_SATA_AHCI=m
CONFIG_SATA_SIL24=m
CONFIG_SCSI_MPT3SAS=m
CONFIG_MEGARAID_SAS=m
# Hidden Kconfig option: built-in XHCI resolves its PCI driver to y.
# This also retains the shared Apple ASMedia firmware loader.
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m

# Shared prerequisites for built-in consumers, also required by Fedora.
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_INET_DIAG=y
CONFIG_SPI_HID_APPLE_CORE=y

# Match the Fedora fleet's audio and USB-C alternate-mode capabilities.
CONFIG_SND_SEQUENCER=m
CONFIG_TYPEC_TBT_ALTMODE=m
CONFIG_TYPEC_NVIDIA_ALTMODE=m

# Set the real clock before userspace starts writing the system journal.
# https://github.com/aurora-silicon/linux/pull/554
CONFIG_MFD_MACSMC=y
CONFIG_RTC_DRV_MACSMC=y
CONFIG_RTC_HCTOSYS=y
CONFIG_SPMI_APPLE=y
CONFIG_NVMEM_APPLE_SPMI=y

# A distribution ESP and compressed firmware must be readable early in boot.
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="ascii"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# NixOS requirements over kernel/config, the resolved configuration
# alarm-aurora ships (see kernel/provenance.json). Most entries already hold
# there and only guard against a future base dropping them; LOCALVERSION is
# the one value NixOS changes, because modDirVersion must be exactly 7.3.0.
CONFIG_MODULES=y
CONFIG_RUST=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_LOOP=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_XTS=y
CONFIG_BTRFS_FS=m
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_FUSE_FS=m
CONFIG_VIRTIO_PCI=m
CONFIG_INPUT_UINPUT=m
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="ascii"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
# Keep the shared distribution keyring without embedding certificates.
CONFIG_SYSTEM_DATA_VERIFICATION=y
CONFIG_SYSTEM_TRUSTED_KEYS=""
# Encrypted roots and cryptsetup:
CONFIG_DM_INTEGRITY=m
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
# Bluetooth: images enable bluetooth.service, and bluez needs /dev/uhid for
# HID-over-GATT keyboards and mice.
CONFIG_BT_LE=y
CONFIG_UHID=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
# The NixOS firewall is on by default, and nixpkgs' iptables is the nf_tables
# variant. Listing the rpfilter match here also tells the firewall module that
# reverse-path filtering is available, as the previous configuration did.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_REJECT=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP_NF_MATCH_RPFILTER=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
# systemd-oomd is on by default in NixOS and needs pressure stall information.
CONFIG_PSI=y
# exFAT removable media.
CONFIG_EXFAT_FS=m
# NixOS's sensor service carries the HID sensor hub in the initrd.
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_CUSTOM_SENSOR=m

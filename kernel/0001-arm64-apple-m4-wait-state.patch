From 3f0822d73dbe341d8073a9db05b316cb564dc92f Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sun, 18 Oct 2026 19:49:10 -0400
Subject: [PATCH] arm64: handle Apple M4+ wait state without boot flags

Use a shared Apple M4-and-later MIDR predicate for the state-saving WFI path, covering base, Pro and Max parts. Apply the WFxT override after early boot-argument parsing so timed waits outside that path no longer depend on arm64.nowfxt. Keep ordinary WFI enabled.

Assisted-by: LLM
Signed-off-by: Diljit Singh <hey@djdev.me>
---
 arch/arm64/include/asm/apple-idle.h   |  2 +-
 arch/arm64/include/asm/cputype.h      |  8 ++++++++
 arch/arm64/kernel/idle-apple.S        |  2 +-
 arch/arm64/kernel/idle.c              | 19 ++++---------------
 arch/arm64/kernel/pi/idreg-override.c |  8 ++++++++
 5 files changed, 22 insertions(+), 17 deletions(-)

diff --git a/arch/arm64/include/asm/apple-idle.h b/arch/arm64/include/asm/apple-idle.h
index 56f5d32e3..c3b72f957 100644
--- a/arch/arm64/include/asm/apple-idle.h
+++ b/arch/arm64/include/asm/apple-idle.h
@@ -2,7 +2,7 @@
 #ifndef __ASM_APPLE_IDLE_H
 #define __ASM_APPLE_IDLE_H
 
-/* WFI that preserves x18-x30 on affected Apple cores (T8140 and T8152). */
+/* WFI that preserves x18-x30 on affected Apple cores. */
 void apple_cpu_wfi(void);
 
 #endif
diff --git a/arch/arm64/include/asm/cputype.h b/arch/arm64/include/asm/cputype.h
index 809e39962..4a3fd1fab 100644
--- a/arch/arm64/include/asm/cputype.h
+++ b/arch/arm64/include/asm/cputype.h
@@ -153,6 +153,7 @@
 #define APPLE_CPU_PART_M2_AVALANCHE_PRO	0x035
 #define APPLE_CPU_PART_M2_BLIZZARD_MAX	0x038
 #define APPLE_CPU_PART_M2_AVALANCHE_MAX	0x039
+#define APPLE_CPU_PART_M4_DONAN_E		0x052
 #define APPLE_CPU_PART_TAHITI_E		0x060
 #define APPLE_CPU_PART_TAHITI_P		0x061
 #define APPLE_CPU_PART_T8142_E		0x062
@@ -283,6 +284,13 @@ static inline u32 __attribute_const__ read_cpuid_id(void)
 	return read_cpuid(MIDR_EL1);
 }
 
+/* Apple part numbers from Donan onward identify the M4 and later generations. */
+static inline bool midr_is_apple_m4_or_later(u32 midr)
+{
+	return MIDR_IMPLEMENTOR(midr) == ARM_CPU_IMP_APPLE &&
+	       MIDR_PARTNUM(midr) >= APPLE_CPU_PART_M4_DONAN_E;
+}
+
 /*
  * Represent a range of MIDR values for a given CPU model and a
  * range of variant/revision values.
diff --git a/arch/arm64/kernel/idle-apple.S b/arch/arm64/kernel/idle-apple.S
index 02c3e4f64..4f31e8410 100644
--- a/arch/arm64/kernel/idle-apple.S
+++ b/arch/arm64/kernel/idle-apple.S
@@ -3,7 +3,7 @@
 #include <asm/assembler.h>
 
 /*
- * T8140 secondaries can resume from WFI with cleared general registers.
+ * Affected Apple cores can resume from WFI with cleared general registers.
  * SP and stack memory survive. Preserve the AAPCS64 callee-saved registers
  * and x18 (which may hold the shadow call stack), including the return PC.
  * This follows the stateless-wait approach used during m1n1 M5 Windows
diff --git a/arch/arm64/kernel/idle.c b/arch/arm64/kernel/idle.c
index 14cde8592..f63255103 100644
--- a/arch/arm64/kernel/idle.c
+++ b/arch/arm64/kernel/idle.c
@@ -41,26 +41,15 @@ early_param("idle", setup_idle);
 
 #ifdef CONFIG_ARCH_APPLE
 /*
- * Apple T8140 (A18 Pro), T8142 (M5), and T8152 (M6) CPUs can return from
- * WFI with general-purpose registers cleared. T8140 also loses FP/SIMD
- * state; conservatively preserve it on all three parts. The key is enabled once
- * at boot on those parts; everywhere else the check is a patched-out branch.
+ * Preserve general-purpose and FP/SIMD state across WFI on M4 and later
+ * Apple cores. The key is enabled once at boot; elsewhere the check is a
+ * patched-out branch.
  */
 static DEFINE_STATIC_KEY_FALSE(apple_wfi_loses_regs);
 
-static const struct midr_range apple_wfi_loses_regs_cpus[] __initconst = {
-	MIDR_ALL_VERSIONS(MIDR_APPLE_TAHITI_E),
-	MIDR_ALL_VERSIONS(MIDR_APPLE_TAHITI_P),
-	MIDR_ALL_VERSIONS(MIDR_APPLE_T8142_E),
-	MIDR_ALL_VERSIONS(MIDR_APPLE_T8142_P),
-	MIDR_ALL_VERSIONS(MIDR_APPLE_T8152_E),
-	MIDR_ALL_VERSIONS(MIDR_APPLE_T8152_P),
-	{}
-};
-
 static int __init apple_wfi_quirk_init(void)
 {
-	if (is_midr_in_range_list(apple_wfi_loses_regs_cpus)) {
+	if (midr_is_apple_m4_or_later(read_cpuid_id())) {
 		static_branch_enable(&apple_wfi_loses_regs);
 		pr_info("Apple: preserving registers across WFI\n");
 	}
diff --git a/arch/arm64/kernel/pi/idreg-override.c b/arch/arm64/kernel/pi/idreg-override.c
index 622dc2034..d5705d1b9 100644
--- a/arch/arm64/kernel/pi/idreg-override.c
+++ b/arch/arm64/kernel/pi/idreg-override.c
@@ -12,6 +12,7 @@
 
 #include <asm/cacheflush.h>
 #include <asm/cpufeature.h>
+#include <asm/cputype.h>
 #include <asm/setup.h>
 
 #include "pi.h"
@@ -445,6 +446,13 @@ void __init init_feature_override(u64 boot_status, const void *fdt,
 
 	parse_cmdline(fdt, chosen);
 
+	/*
+	 * Timed waits bypass the register-saving idle path on Apple M4+ cores.
+	 * Apply this after boot arguments so they cannot re-enable WFxT.
+	 */
+	if (IS_ENABLED(CONFIG_ARCH_APPLE) && midr_is_apple_m4_or_later(read_cpuid_id()))
+		__parse_cmdline("id_aa64isar2.wfxt=0", false);
+
 	for (i = 0; i < ARRAY_SIZE(regs); i++) {
 		reg = prel64_pointer(regs[i].reg);
 		override = prel64_pointer(reg->override);
-- 
2.55.0


{ config, lib, pkgs, ... }:
# Signed UKIs for the secure boot path (aurora-secboot, aurora-platform secboot/).
#
# The default path is untouched: U-Boot > EFI/BOOT/BOOTAA64.EFI = GRUB. With
# aurora.secureBoot.enable every bootloader install also builds one UKI per
# listed generation (kernel, initrd with its secrets, command line with
# init=, lockdown=<lockdown>) under ESP/EFI/Linux, signed with the db key in
# keyDir when there is one. Keys live in keyDir, never in the Nix store, as
# lanzaboote does. With securePath the default generation's UKI becomes
# EFI/BOOT/BOOTAA64.EFI (aurora-secboot enable); turning it off puts GRUB back.
let
  cfg = config.aurora.secureBoot;
  esp = config.boot.loader.efi.efiSysMountPoint;
  yesNo = b: if b then "yes" else "no";
  configFile = pkgs.writeText "aurora-secboot.conf" ''
    # Generated by NixOS from aurora.secureBoot; change it in the system configuration.
    KEY_OWNER=${cfg.keyOwner}
    SECURE_PATH=${yesNo cfg.securePath}
    LOCKDOWN=${cfg.lockdown}
    KEY_DIR=${cfg.keyDir}
    ESP=${esp}
    UKI_BUILD=${cfg.ukiBuild}
  '';
  secboot = "${cfg.package}/bin/aurora-secboot --config ${configFile}";
  # The aura build installed.nix puts at the front of Stage 2, whose
  # share/aura holds the Stage 1 images and aura's signing tools that
  # `aurora-secboot stage1 build` and its stage2 hook use.
  aura = pkgs.m1n1.override (lib.optionalAttrs (config.boot.m1n1CustomLogo != null) {
    customLogo = config.boot.m1n1CustomLogo;
  });
  # aurora-secboot as installed and as the Stage 2 updater runs it: with this
  # system's aura unless AURORA_SECBOOT_AURA_DIR says otherwise (sudo drops
  # session variables, so a wrapper rather than environment.variables).
  withAura = pkgs.symlinkJoin {
    name = "aurora-secboot-with-aura";
    paths = [ cfg.package ];
    nativeBuildInputs = [ pkgs.makeWrapper ];
    postBuild = ''
      wrapProgram $out/bin/aurora-secboot --set-default AURORA_SECBOOT_AURA_DIR ${aura}/share/aura
    '';
  };
  # install-grub.sh passes the configuration it makes the default as $1.
  install = pkgs.writeShellApplication {
    name = "aurora-secboot-install";
    runtimeInputs = [ pkgs.coreutils pkgs.gnused pkgs.findutils ];
    text = ''
      default=''${1:-}
      # The environment overrides are for checks/secure-boot.nix.
      esp=''${AURORA_SECBOOT_ESP:-${esp}}
      profiles=''${AURORA_SECBOOT_PROFILES:-/nix/var/nix/profiles}
      tmp=''${AURORA_SECBOOT_TMP:-/run}
      linux=$esp/EFI/Linux
      keys=''${AURORA_SECBOOT_KEY_DIR:-${lib.escapeShellArg cfg.keyDir}}
      build=${cfg.ukiBuild}
      if [[ $build == auto ]]; then
        if [[ -e $keys/db.key ]]; then build=yes; else build=no; fi
      fi

      # The default configuration and the newest ${toString cfg.generations} system generations.
      mapfile -t generations < <(
        find "$profiles" -maxdepth 1 -name 'system-*-link' -printf '%f\n' |
          sed -E 's/^system-([0-9]+)-link$/\1/' | sort -n | tail -n ${toString cfg.generations} |
          while read -r n; do readlink -f "$profiles/system-$n-link"; done
      )
      [[ -n $default ]] && generations+=("$(readlink -f "$default")")

      name() { echo "aurora-nixos-$(basename "$1" | cut -d- -f1).efi"; }
      declare -A keep=()
      if [[ $build == yes ]]; then
        mkdir -p "$linux"
        work=$(mktemp -d -p "$tmp" aurora-secboot.XXXXXX)
        trap 'rm -rf "$work"' EXIT
        for g in "''${generations[@]}"; do
          out=$linux/$(name "$g")
          [[ -n ''${keep[$out]:-} ]] && continue
          keep[$out]=1
          # Unchanged and still signed with the current key: nothing to do.
          if [[ -e $out ]] && { [[ ! -e $keys/db.crt ]] || ${secboot} uki verify "$out" >/dev/null 2>&1; }; then
            continue
          fi
          kver=
          for d in "$g"/kernel-modules/lib/modules/*; do kver=''${d##*/}; break; done
          cp "$g/initrd" "$work/initrd"
          # boot.initrd.secrets, as install-grub.pl appends them.
          if [[ -x $g/append-initrd-secrets ]]; then
            "$g/append-initrd-secrets" "$work/initrd"
          fi
          cp "$g/kernel-params" "$work/cmdline"
          # The generation's own os-release: /etc is still the running one's.
          osrel=()
          if [[ -e $g/etc/os-release ]]; then
            osrel=(--os-release "$g/etc/os-release")
          fi
          # A failed UKI leaves GRUB's entries as they are; with securePath,
          # enable below refuses a default generation without one.
          if ! ${secboot} uki build "$kver" --image "$g/kernel" --initrd "$work/initrd" \
              --cmdline-file "$work/cmdline" --init "$g/init" "''${osrel[@]}" --output "$out"; then
            echo "aurora-secboot: no UKI for $g" >&2
            unset "keep[$out]"
          fi
          rm -f "$work/initrd" "$work/cmdline"
        done
      fi

      # UKIs of generations no longer listed (all of them when nothing is built).
      if [[ -d $linux ]]; then
        find "$linux" -maxdepth 1 -name 'aurora-nixos-*.efi' -print0 |
          while IFS= read -r -d "" f; do
            [[ -n ''${keep[$f]:-} ]] || rm -f "$f"
          done
      fi

      ${if cfg.securePath then ''
        if [[ -z $default ]]; then
          echo "aurora-secboot: no default configuration to install as EFI/BOOT/BOOTAA64.EFI" >&2
          exit 1
        fi
        ${secboot} enable --uki "$linux/$(name "$(readlink -f "$default")")"
      '' else ''
        # Back to GRUB if a previous generation turned the secure path on.
        if [[ -e $esp/EFI/BOOT/BOOTAA64.EFI.aurora-shim ]]; then
          ${secboot} disable
        fi
      ''}
    '';
  };
in {
  options.aurora.secureBoot = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Build a signed unified kernel image (UKI) for each boot generation at
        every bootloader install, with aurora-secboot: the generation's kernel,
        its initrd (boot.initrd.secrets included) and its kernel parameters
        plus init= and lockdown=, minus debug and shell parameters. UKIs go to
        ESP/EFI/Linux/aurora-nixos-<hash>.efi and are signed with the db key in
        keyDir. The keys stay in keyDir and never enter the Nix store. GRUB
        stays the boot loader unless securePath is set. Writes
        /etc/aurora/secboot.conf; `aurora-secboot status` reports the chain.
      '';
    };
    keyOwner = lib.mkOption {
      type = lib.types.enum [ "aurora" "owner" "both" ];
      default = "aurora";
      description = ''
        Who signs this Mac's boot chain, as chosen at install: Aurora's release
        keys (no private key on the machine, locally built UKIs stay unsigned),
        the owner's keys made on the machine (`aurora-secboot keys create`), or
        both.
      '';
    };
    securePath = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Boot the default generation's signed UKI directly: it becomes
        ESP/EFI/BOOT/BOOTAA64.EFI, with GRUB kept as BOOTAA64.EFI.aurora-shim
        and put back when this is turned off. Needs owner keys (keyOwner
        "owner" or "both") and a UKI that verifies against db.crt; the
        bootloader install fails otherwise. Signatures are only checked once
        U-Boot and Stage 1 enforce them.
      '';
    };
    lockdown = lib.mkOption {
      type = lib.types.enum [ "integrity" "confidentiality" ];
      default = "integrity";
      description = ''
        Kernel lockdown level on the UKI command line. integrity refuses
        unsigned modules, unsigned kexec images and raw memory or I/O port
        access; confidentiality also blocks reading kernel memory.
      '';
    };
    keyDir = lib.mkOption {
      type = lib.types.str;
      default = "/var/lib/aurora/secboot/keys";
      description = ''
        Directory with the signing keys (db.key/db.crt, KEK, PK and the Stage 2
        key), root only. It must not be in the Nix store.
      '';
    };
    ukiBuild = lib.mkOption {
      type = lib.types.enum [ "auto" "yes" "no" ];
      default = "auto";
      description = ''
        Build UKIs at bootloader installs: auto builds them only when keyDir
        has db.key (so they are signed), yes builds unsigned ones too, no
        builds none and removes the ones this module made.
      '';
    };
    generations = lib.mkOption {
      type = lib.types.ints.positive;
      default = 3;
      description = ''
        Number of newest system generations that keep a UKI, besides the
        default one. Each UKI holds a kernel and an initrd, so this bounds the
        space taken on the ESP.
      '';
    };
    adoptInstallerKey = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        At first boot, move the Stage 2 key the installer left on the ESP
        (aurora/secboot/stage2.key, owner-managed installs) into keyDir and
        wipe the ESP copy (aurora-secboot-adopt.service). Works without
        enable, so the key never stays on the unencrypted ESP.
      '';
    };
    package = lib.mkPackageOption pkgs "aurora-secboot" { };
  };

  config = lib.mkMerge [
    (lib.mkIf (cfg.enable || cfg.adoptInstallerKey) {
      environment.systemPackages = [ withAura ];
      systemd.tmpfiles.settings.aurora-secboot.${cfg.keyDir}.d = {
        mode = "0700";
        user = "root";
        group = "root";
      };
    })
    (lib.mkIf cfg.adoptInstallerKey {
      systemd.services.aurora-secboot-adopt = {
        description = "Move the installer's Stage 2 key off the ESP";
        wantedBy = [ "multi-user.target" ];
        after = [ "local-fs.target" "systemd-tmpfiles-setup.service" ];
        unitConfig = {
          ConditionPathExists = "${esp}/aurora/secboot/stage2.key";
          RequiresMountsFor = [ esp cfg.keyDir ];
        };
        restartIfChanged = false;
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          UMask = "0077";
          ExecStart = "${secboot} keys adopt";
        };
      };
    })
    (lib.mkIf cfg.enable {
      # Present only while the module is on: the other hooks do nothing without it.
      environment.etc."aurora/secboot.conf".source = configFile;
      assertions = [
        {
          assertion = !(cfg.securePath && cfg.keyOwner == "aurora");
          message = "aurora.secureBoot.securePath needs keyOwner = \"owner\" or \"both\": "
            + "no Aurora-signed UKIs exist yet, and under keyOwner = \"aurora\" this Mac holds no key to sign its own.";
        }
        {
          assertion = !(lib.hasPrefix builtins.storeDir cfg.keyDir);
          message = "aurora.secureBoot.keyDir must not be in the Nix store, which every user can read.";
        }
      ];
      # After GRUB and the core image rebuild, so BOOTAA64.EFI is final.
      boot.loader.grub.extraInstallCommands = lib.mkAfter ''
        ${install}/bin/aurora-secboot-install "''${1:-}"
      '';
      system.build.auroraSecureBootInstall = install;
      # installed.nix hands each Stage 2 to this one's `stage2 hook`, which
      # signs it with the owner's Stage 2 key when STAGE2_SIGN allows.
      system.build.auroraStage2Signer = "${withAura}/bin/aurora-secboot";
      system.build.auroraSecureBootConfig = configFile;
    })
  ];
}

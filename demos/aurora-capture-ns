#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Start an opt-in capture filter with pinned libraries and checked weights."""
import argparse
import os
import subprocess
import sys

parser = argparse.ArgumentParser(add_help=False)
parser.add_argument('--engine', choices=('auto', 'cpu', 'ane', 'gpu'), default='auto')
parser.add_argument('--model', choices=('rnnoise', 'df3'))
args, rest = parser.parse_known_args()
if args.engine not in ('auto', 'cpu'):
    parser.error('this capture build has CPU models only; use --engine cpu')
if '-h' not in rest and '--help' not in rest:
    if not args.model:
        parser.error('--model rnnoise or --model df3 is required')
    if '--print-config' not in rest:
        try:
            model = subprocess.check_output(['@FETCH@', args.model], text=True).strip()
        except (OSError, subprocess.CalledProcessError):
            parser.exit(1, 'aurora-capture-ns: model fetch failed; no source started\n')
        os.environ['AURORA_RNNOISE_MODEL' if args.model == 'rnnoise' else 'AURORA_DF_MODEL'] = model
    print('engine=cpu (RNNoise/libDF; native ANE model unavailable)', file=sys.stderr)
os.environ['AURORA_RNNOISE_LIBRARY'] = '@RNNOISE@'
os.environ['AURORA_DF_LIBRARY'] = '@LIBDF@'
if args.model:
    rest += ['--model', args.model]
os.execv(sys.executable, [sys.executable, '@LAUNCHER@', '--plugin', '@PLUGIN@', *rest])

From db9233fd6a45a801eca13bd0123d23c2992fd4fc Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 1 Nov 2026 23:38:59 +1100
Subject: [PATCH] ply-terminal: Keep terminal input nonblocking

The terminal is opened with O_NONBLOCK, but is made blocking before
being watched by the event loop. A readiness notification does not
reserve input: another reader can consume it, or the terminal settings
can change before the keyboard handler reads it. A blocking read then
stops the entire daemon, including replies to boot clients.

Keep a separate nonblocking open file description for terminal input
and use it for the input watch and keyboard reads. The existing buffer
reader already treats EAGAIN as no data. Keep the original descriptor
blocking so terminal output retains its existing write semantics.

Close both descriptors on disconnect and defer reopening until the
old event source has been removed, avoiding descriptor reuse while
that source is still being dispatched.

Add a PTY test for stale readiness, canonical-mode input, independent
output flags, and close/reopen cleanup.
---
 src/libply-splash-core/ply-keyboard.c |  4 +--
 src/libply-splash-core/ply-terminal.c | 52 +++++++++++++++++++++++----
 src/libply-splash-core/ply-terminal.h |  1 +
 3 files changed, 48 insertions(+), 9 deletions(-)

diff --git a/src/libply-splash-core/ply-keyboard.c b/src/libply-splash-core/ply-keyboard.c
index d3fb83bb..19e6348a 100644
--- a/src/libply-splash-core/ply-keyboard.c
+++ b/src/libply-splash-core/ply-keyboard.c
@@ -417,7 +417,7 @@ on_terminal_data (ply_keyboard_t *keyboard)
         if (ply_kernel_command_line_has_argument ("plymouth.debug-key-events"))
                 ply_trace ("New keyboard data from terminal");
 
-        terminal_fd = ply_terminal_get_fd (keyboard->provider.if_terminal->terminal);
+        terminal_fd = ply_terminal_get_input_fd (keyboard->provider.if_terminal->terminal);
         ply_buffer_append_from_fd (keyboard->provider.if_terminal->key_buffer,
                                    terminal_fd);
         on_key_event (keyboard, keyboard->provider.if_terminal->key_buffer);
@@ -430,7 +430,7 @@ ply_keyboard_watch_for_terminal_input (ply_keyboard_t *keyboard)
 
         assert (keyboard != NULL);
 
-        terminal_fd = ply_terminal_get_fd (keyboard->provider.if_terminal->terminal);
+        terminal_fd = ply_terminal_get_input_fd (keyboard->provider.if_terminal->terminal);
 
         if (terminal_fd < 0 || !ply_terminal_is_open (keyboard->provider.if_terminal->terminal)) {
                 ply_trace ("terminal associated with keyboard isn't open");
diff --git a/src/libply-splash-core/ply-terminal.c b/src/libply-splash-core/ply-terminal.c
index 4d9d10d4..44cf1b66 100644
--- a/src/libply-splash-core/ply-terminal.c
+++ b/src/libply-splash-core/ply-terminal.c
@@ -81,6 +81,7 @@ struct _ply_terminal
         char                *name;
         const char          *keymap;
         int                  fd;
+        int                  input_fd;
         int                  vt_number;
         int                  initial_vt_number;
         int                  number_of_reopen_tries;
@@ -137,6 +138,7 @@ ply_terminal_new (const char *device_name,
                 asprintf (&terminal->name, "/dev/%s", device_name);
 
         terminal->fd = -1;
+        terminal->input_fd = -1;
         terminal->vt_number = -1;
         terminal->initial_vt_number = -1;
         terminal->keymap = keymap;
@@ -429,10 +431,19 @@ on_tty_disconnected (ply_terminal_t *terminal)
 {
         ply_trace ("tty disconnected (fd %d)", terminal->fd);
         terminal->fd_watch = NULL;
+        close (terminal->input_fd);
+        terminal->input_fd = -1;
+        close (terminal->fd);
         terminal->fd = -1;
         terminal->number_of_reopen_tries = 0;
 
-        ply_terminal_reopen_device (terminal);
+        /* Let the event loop remove the disconnected source before reusing
+         * its descriptor number for the new input watch.
+         */
+        ply_event_loop_watch_for_timeout (terminal->loop,
+                                          PLY_TERMINAL_REOPEN_INTERVAL,
+                                          (ply_event_loop_timeout_handler_t) ply_terminal_reopen_device,
+                                          terminal);
 }
 
 bool
@@ -597,10 +608,26 @@ ply_terminal_open_device (ply_terminal_t *terminal)
         assert (terminal != NULL);
         assert (terminal->name != NULL);
         assert (terminal->fd < 0);
+        assert (terminal->input_fd < 0);
         assert (terminal->fd_watch == NULL);
 
         terminal->fd = open (terminal->name, O_RDWR | O_NOCTTY | O_NONBLOCK);
 
+        if (terminal->fd >= 0) {
+                /* Use a separate open file description so input can remain
+                 * nonblocking without changing the semantics of terminal writes.
+                 * dup() would share the O_NONBLOCK flag with the output fd.
+                 */
+                terminal->input_fd = open (terminal->name, O_RDONLY | O_NOCTTY | O_NONBLOCK | O_CLOEXEC);
+                if (terminal->input_fd < 0) {
+                        int saved_errno = errno;
+
+                        close (terminal->fd);
+                        terminal->fd = -1;
+                        errno = saved_errno;
+                }
+        }
+
         if (terminal->fd < 0) {
                 ply_trace ("Unable to open terminal device '%s': %m", terminal->name);
 
@@ -620,7 +647,7 @@ ply_terminal_open_device (ply_terminal_t *terminal)
 
         ply_set_fd_as_blocking (terminal->fd);
 
-        terminal->fd_watch = ply_event_loop_watch_fd (terminal->loop, terminal->fd,
+        terminal->fd_watch = ply_event_loop_watch_fd (terminal->loop, terminal->input_fd,
                                                       PLY_EVENT_LOOP_FD_STATUS_HAS_DATA,
                                                       (ply_event_handler_t) on_tty_input,
                                                       (ply_event_handler_t) on_tty_disconnected,
@@ -686,6 +713,12 @@ ply_terminal_get_fd (ply_terminal_t *terminal)
         return terminal->fd;
 }
 
+int
+ply_terminal_get_input_fd (ply_terminal_t *terminal)
+{
+        return terminal->input_fd;
+}
+
 bool
 ply_terminal_is_vt (ply_terminal_t *terminal)
 {
@@ -714,6 +747,11 @@ ply_terminal_close (ply_terminal_t *terminal)
 
         terminal->is_open = false;
 
+        if (terminal->loop != NULL)
+                ply_event_loop_stop_watching_for_timeout (terminal->loop,
+                                                          (ply_event_loop_timeout_handler_t)
+                                                          ply_terminal_reopen_device, terminal);
+
         ply_terminal_stop_watching_for_vt_changes (terminal);
 
         ply_trace ("restoring color palette");
@@ -733,6 +771,8 @@ ply_terminal_close (ply_terminal_t *terminal)
         ply_trace ("setting buffered input");
         ply_terminal_set_buffered_input (terminal);
 
+        close (terminal->input_fd);
+        terminal->input_fd = -1;
         close (terminal->fd);
         terminal->fd = -1;
 }
@@ -880,11 +920,9 @@ ply_terminal_free (ply_terminal_t *terminal)
                                                        ply_terminal_detach_from_event_loop,
                                                        terminal);
 
-                if (terminal->number_of_reopen_tries > 0) {
-                        ply_event_loop_stop_watching_for_timeout (terminal->loop,
-                                                                  (ply_event_loop_timeout_handler_t)
-                                                                  ply_terminal_reopen_device, terminal);
-                }
+                ply_event_loop_stop_watching_for_timeout (terminal->loop,
+                                                          (ply_event_loop_timeout_handler_t)
+                                                          ply_terminal_reopen_device, terminal);
         }
 
         if (terminal->is_open)
diff --git a/src/libply-splash-core/ply-terminal.h b/src/libply-splash-core/ply-terminal.h
index b1cbfe46..13ae3849 100644
--- a/src/libply-splash-core/ply-terminal.h
+++ b/src/libply-splash-core/ply-terminal.h
@@ -62,6 +62,7 @@ void ply_terminal_free (ply_terminal_t *terminal);
 
 bool ply_terminal_open (ply_terminal_t *terminal);
 int ply_terminal_get_fd (ply_terminal_t *terminal);
+int ply_terminal_get_input_fd (ply_terminal_t *terminal);
 bool ply_terminal_is_vt (ply_terminal_t *terminal);
 bool ply_terminal_is_open (ply_terminal_t *terminal);
 bool ply_terminal_is_active (ply_terminal_t *terminal);
-- 

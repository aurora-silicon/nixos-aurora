#!/bin/sh
# aurora-m5-platform-config: deep sleep on the MacBook Pro (M5 Pro, J714s). Every other Mac returns at once.
# The T6050 sleep driver admits a sleep only with an armed PMU RTC alarm (t6050_sleep_check_alarm returns
# -EBUSY otherwise). Before a suspend with none armed, arm one SAFETY_S (/etc/aurora-m5-sleep.conf, default
# 3600, the RTC driver's limit) ahead: a far safety wake (with the lid still closed, logind suspends again).
# After the wake, clear it if it is ours and still pending. An alarm someone else armed (rtcwake, a test) is
# left as it is.
tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | grep -qx 'apple,j714s' || exit 0
R=; for r in /sys/class/rtc/rtc*; do case "$(cat $r/name 2>/dev/null)" in apple-pmu-rtc*) R=$r ;; esac; done
[ -n "$R" ] || exit 0
M=/run/aurora-m5-sleep-alarm
A=$(cat $R/wakealarm 2>/dev/null); NOW=$(cat $R/since_epoch 2>/dev/null || date +%s)
case "$1" in
pre)
    rm -f $M
    # an alarm at least 5 s ahead (rtcwake, a test) is kept; a stale one (due or past) is replaced
    if [ -n "$A" ] && [ "$A" -ge $((NOW + 5)) ] 2>/dev/null; then logger -t aurora-m5-sleep "RTC alarm already armed for $A (in $((A - NOW)) s): kept"; exit 0; fi
    [ -z "$A" ] || { echo 0 > $R/wakealarm; logger -t aurora-m5-sleep "stale RTC alarm $A (now $NOW) cleared"; }
    S=$(sed -n 's/^SAFETY_S=\([0-9][0-9]*\)$/\1/p' /etc/aurora-m5-sleep.conf 2>/dev/null | tail -1)
    [ -n "$S" ] && [ "$S" -ge 30 ] && [ "$S" -le 3600 ] || S=3600
    if echo "+$S" > $R/wakealarm; then
        cat $R/wakealarm > $M; logger -t aurora-m5-sleep "safety RTC alarm armed ${S} s ahead ($(cat $M))"
    else
        logger -t aurora-m5-sleep "safety RTC alarm could not be armed: the sleep will be refused"
    fi ;;
post)
    [ -s $M ] || exit 0
    # the RTC class keeps reporting a fired alarm: clear ours either way so the next suspend arms a fresh one
    if [ "$NOW" -ge "$(($(cat $M) - 1))" ] 2>/dev/null; then W="the safety alarm was due (woken at or after it)"; else W="woken $(($(cat $M) - NOW)) s before the safety alarm"; fi
    [ "$A" = "$(cat $M)" ] && echo 0 > $R/wakealarm
    logger -t aurora-m5-sleep "$W; alarm $(cat $M) cleared"
    rm -f $M ;;
esac
exit 0

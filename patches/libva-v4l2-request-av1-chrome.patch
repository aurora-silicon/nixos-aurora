-static void av1_fill_frame(struct v4l2r_context *ctx)
+/*
+ * Tile dimensions in superblocks and their mode-info start positions.
+ * VA-API: with uniform_tile_spacing_flag the width/height_in_sbs_minus_1
+ * arrays "should be ignored" and generated by the driver from tile_cols/rows
+ * (Chrome leaves them zero), and the last tile's size need not be specified.
+ * V4L2 requires all of them, so derive them as AV1 spec 5.9.15 does.
+ * Returns false when the client geometry is inconsistent with the frame.
+ */
+static bool av1_tile_dims(unsigned int count, unsigned int sb_count, bool uniform,
+			  const uint16_t *va_minus1, unsigned int sb_shift,
+			  unsigned int max_sb, uint32_t *starts, uint32_t *minus1)
+{
+	unsigned int start = 0;
+
+	/* max_sb: largest legal tile extent in superblocks (spec MAX_TILE_WIDTH
+	 * for columns, maxTileHeightSb for non-uniform rows; 0 = no limit). */
+	if (!count || count > 64 || !sb_count)
+		return false;
+	if (uniform) {
+		unsigned int tile_sb = 0;
+
+		/* Recover TileColsLog2/TileRowsLog2: the smallest log2 whose
+		 * uniform layout yields the client's tile count. */
+		for (unsigned int k = 0; k <= 6 && !tile_sb; k++) {
+			unsigned int w = (sb_count + (1u << k) - 1) >> k;
+
+			if (w && (sb_count + w - 1) / w == count)
+				tile_sb = w;
+		}
+		if (!tile_sb)
+			return false;
+		if (max_sb && tile_sb > max_sb)
+			return false;
+		for (unsigned int i = 0; i < count; i++) {
+			unsigned int w = sb_count - i * tile_sb;
+
+			starts[i] = (i * tile_sb) << sb_shift;
+			minus1[i] = (w < tile_sb ? w : tile_sb) - 1;
+		}
+		return true;
+	}
+	for (unsigned int i = 0; i < count; i++) {
+		unsigned int w;
+
+		if (start >= sb_count)
+			return false;
+		if (i + 1 == count)
+			w = sb_count - start;
+		else if (i < 63)
+			w = va_minus1[i] + 1u;
+		else
+			return false;
+		if (w > sb_count - start || (max_sb && w > max_sb))
+			return false;
+		starts[i] = start << sb_shift;
+		minus1[i] = w - 1;
+		start += w;
+	}
+	return true;
+}
+
+static bool av1_fill_frame(struct v4l2r_context *ctx)
 {
 	struct av1_context *codec = ctx->codec_priv;
 	const VADecPictureParameterBufferAV1 *pic = &codec->va_pic;
@@ -173,7 +237,7 @@ static void av1_fill_frame(struct v4l2r_context *ctx)
 	/* Superblock size in units of 4x4 mode info blocks (log2). */
 	unsigned int sb_shift =
 		pic->seq_info_fields.fields.use_128x128_superblock ? 5 : 4;
-	uint32_t mi_start;
+	bool valid = true;
 	/* tile_cols/tile_rows are client-supplied uint8_t; clamp to the control
 	 * array bounds so the loops and terminator stores below cannot run off
 	 * the end of tile_info on a malformed frame. */
@@ -292,32 +356,41 @@ static void av1_fill_frame(struct v4l2r_context *ctx)
 	if (pic->pic_info_fields.bits.uniform_tile_spacing_flag)
 		frame->tile_info.flags |= V4L2_AV1_TILE_INFO_FLAG_UNIFORM_TILE_SPACING;
 
-	/* VA carries at most 63 explicit tile dimensions (width/height_in_sbs
-	 * arrays); the final tile size is derived from the mi_*_starts
-	 * terminator, so bound the reads to the VA array size. */
-	mi_start = 0;
-	for (unsigned int i = 0; i < tile_cols; i++) {
-		frame->tile_info.mi_col_starts[i] = mi_start;
-		if (i < 63) {
-			frame->tile_info.width_in_sbs_minus_1[i] =
-				pic->width_in_sbs_minus_1[i];
-			mi_start += (pic->width_in_sbs_minus_1[i] + 1) << sb_shift;
-		}
-	}
-	frame->tile_info.mi_col_starts[tile_cols] =
-		2 * ((frame_width + 7) >> 3);
-
-	mi_start = 0;
-	for (unsigned int i = 0; i < tile_rows; i++) {
-		frame->tile_info.mi_row_starts[i] = mi_start;
-		if (i < 63) {
-			frame->tile_info.height_in_sbs_minus_1[i] =
-				pic->height_in_sbs_minus_1[i];
-			mi_start += (pic->height_in_sbs_minus_1[i] + 1) << sb_shift;
-		}
+	{
+		uint32_t mi_cols = 2 * ((frame_width + 7) >> 3);
+		uint32_t mi_rows = 2 * ((frame_height + 7) >> 3);
+		uint32_t sb_mask = (1u << sb_shift) - 1;
+		bool uniform = pic->pic_info_fields.bits.uniform_tile_spacing_flag;
+
+		/* AV1 5.9.15: MAX_TILE_WIDTH 4096 and MAX_TILE_AREA 4096*2304 luma
+		 * samples; one superblock is 1 << (sb_shift + 2) samples wide. */
+		unsigned int sb_log2 = sb_shift + 2;
+		unsigned int max_w_sb = 4096 >> sb_log2;
+		unsigned int max_area_sb = (4096 * 2304) >> (2 * sb_log2);
+		unsigned int widest = 0, max_h_sb = 0;
+
+		if (!av1_tile_dims(tile_cols, (mi_cols + sb_mask) >> sb_shift, uniform,
+				   pic->width_in_sbs_minus_1, sb_shift, max_w_sb,
+				   frame->tile_info.mi_col_starts,
+				   frame->tile_info.width_in_sbs_minus_1))
+			valid = false;
+		for (unsigned int i = 0; valid && i < tile_cols; i++)
+			if (frame->tile_info.width_in_sbs_minus_1[i] + 1 > widest)
+				widest = frame->tile_info.width_in_sbs_minus_1[i] + 1;
+		/* Non-uniform rows: maxTileHeightSb = max(maxTileAreaSb / widestTileSb, 1).
+		 * Uniform rows are constrained through log2 counts, whose rounding the
+		 * VA tile counts cannot reproduce exactly, so no area bound there. */
+		if (valid && !uniform)
+			max_h_sb = widest ? (max_area_sb / widest ?: 1) : 1;
+		if (valid &&
+		    !av1_tile_dims(tile_rows, (mi_rows + sb_mask) >> sb_shift, uniform,
+				   pic->height_in_sbs_minus_1, sb_shift, max_h_sb,
+				   frame->tile_info.mi_row_starts,
+				   frame->tile_info.height_in_sbs_minus_1))
+			valid = false;
+		frame->tile_info.mi_col_starts[tile_cols] = mi_cols;
+		frame->tile_info.mi_row_starts[tile_rows] = mi_rows;
 	}
-	frame->tile_info.mi_row_starts[tile_rows] =
-		2 * ((frame_height + 7) >> 3);
 
 	if (pic->qmatrix_fields.bits.using_qmatrix)
 		frame->quantization.flags |= V4L2_AV1_QUANTIZATION_FLAG_USING_QMATRIX;
@@ -507,6 +580,7 @@ static void av1_fill_frame(struct v4l2r_context *ctx)
 			}
 		}
 	}
+	return valid;
 }
 

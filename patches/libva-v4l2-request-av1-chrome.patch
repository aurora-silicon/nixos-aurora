+	if (!codec->have_pic || !codec->num_tiles || codec->data_before_params ||
+	    codec->slices_consumed != codec->nb_va_slices)
 		return VA_STATUS_ERROR_OPERATION_FAILED;
 
 	/* Normally the previous frame was submitted when this frame's picture
@@ -946,6 +1037,16 @@ static VAStatus av1_end_picture(struct v4l2r_context *ctx)
 		ctx->pic.target->status = VASurfaceRendering;

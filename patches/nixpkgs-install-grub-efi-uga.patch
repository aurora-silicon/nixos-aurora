nixpkgs install-grub.pl: write insmod efi_uga only for x86 EFI targets

UGA is an x86-only EFI protocol. install-grub.pl loaded efi_gop and efi_uga
on every EFI GRUB, so arm64-efi systems printed "error: ... file
'/grub/arm64-efi/efi_uga.mod' not found." at every boot. Carried by
modules/nixpkgs-grub.nix until nixpkgs writes efi_uga for x86 EFI only.

--- a/nixos/modules/system/boot/loader/grub/install-grub.pl
+++ b/nixos/modules/system/boot/loader/grub/install-grub.pl
@@ -81,6 +81,9 @@
 my $fsIdentifier = get("fsIdentifier");
 my $grubEfi = get("grubEfi");
 my $grubTargetEfi = get("grubTargetEfi");
+# UGA is an x86-only EFI protocol: other EFI GRUB targets (arm64-efi,
+# riscv64-efi, ...) have no efi_uga module to load.
+my $efiUga = $grubTargetEfi =~ /^(i386|x86_64)-efi$/ ? "\n      insmod efi_uga" : "";
 my $bootPath = get("bootPath");
 my $storePath = get("storePath");
 my $canTouchEfiVariables = get("canTouchEfiVariables");
@@ -336,8 +339,7 @@
 
     # Setup the graphics stack for bios and efi systems
     if [ \"\${grub_platform}\" = \"efi\" ]; then
-      insmod efi_gop
-      insmod efi_uga
+      insmod efi_gop$efiUga
     else
       insmod vbe
     fi

+GST_DEBUG_CATEGORY_STATIC (gst_v4l2_prores_enc_debug);
+#define GST_CAT_DEFAULT gst_v4l2_prores_enc_debug
+
+static GstStaticCaps src_template_caps =
+GST_STATIC_CAPS ("video/x-prores, "
+    "variant = (string) { proxy, lt, standard, hq, 4444, 4444xq }");
+
+#define gst_v4l2_prores_enc_parent_class parent_class
+G_DEFINE_TYPE (GstV4l2ProResEnc, gst_v4l2_prores_enc,
+    GST_TYPE_V4L2_VIDEO_ENC);
+
+static void
+gst_v4l2_prores_enc_init (GstV4l2ProResEnc * self)
+{
+}
+
+static void
+gst_v4l2_prores_enc_class_init (GstV4l2ProResEncClass * klass)
+{
+  GstElementClass *element_class;
+  GstV4l2VideoEncClass *baseclass;
+
+  parent_class = g_type_class_peek_parent (klass);
+
+  element_class = (GstElementClass *) klass;
+  baseclass = (GstV4l2VideoEncClass *) (klass);
+
+  GST_DEBUG_CATEGORY_INIT (gst_v4l2_prores_enc_debug, "v4l2proresenc", 0,
+      "V4L2 ProRes Encoder");
+
+  gst_element_class_set_static_metadata (element_class,
+      "V4L2 ProRes Encoder",
+      "Codec/Encoder/Video/Hardware",
+      "Encode Apple ProRes video streams via V4L2 API",
+      "Ryan Murray <ryan@aurorasilicon.org>");
+
+  baseclass->codec_name = "ProRes";
+}
+
+/* Probing functions */
+gboolean
+gst_v4l2_is_prores_enc (GstCaps * sink_caps, GstCaps * src_caps)
+{
+  return gst_v4l2_is_video_enc (sink_caps, src_caps,
+      gst_static_caps_get (&src_template_caps));
+}
+
+void
+gst_v4l2_prores_enc_register (GstPlugin * plugin, const gchar * basename,
+    const gchar * device_path, gint video_fd, GstCaps * sink_caps,
+    GstCaps * src_caps)
+{
+  const GstV4l2Codec *codec = gst_v4l2_prores_get_codec ();
+  gst_v4l2_video_enc_register (plugin, GST_TYPE_V4L2_PRORES_ENC,
+      "prores", basename, device_path, codec, video_fd, sink_caps,
+      gst_static_caps_get (&src_template_caps), src_caps);
+}

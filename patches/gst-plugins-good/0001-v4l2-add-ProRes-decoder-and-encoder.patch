+ * Free Software Foundation, Inc., 51 Franklin St, Fifth Floor,
+ * Boston, MA 02110-1301, USA.
+ *
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "gstv4l2prorescodec.h"
+
+#include <gst/gst.h>
+#include "ext/v4l2-controls.h"
+
+/* The ProRes profile control is not part of the upstream V4L2 uAPI yet */
+#ifndef V4L2_CID_MPEG_VIDEO_PRORES_PROFILE
+#define V4L2_CID_MPEG_VIDEO_PRORES_PROFILE (V4L2_CID_CODEC_BASE + 658)
+enum v4l2_mpeg_video_prores_profile
+{
+  V4L2_MPEG_VIDEO_PRORES_PROFILE_PROXY = 0,
+  V4L2_MPEG_VIDEO_PRORES_PROFILE_LT = 1,
+  V4L2_MPEG_VIDEO_PRORES_PROFILE_STANDARD = 2,
+  V4L2_MPEG_VIDEO_PRORES_PROFILE_HQ = 3,
+  V4L2_MPEG_VIDEO_PRORES_PROFILE_4444 = 4,
+  V4L2_MPEG_VIDEO_PRORES_PROFILE_4444_XQ = 5,
+};
+#endif
+
+/* The profile strings are the "variant" values used by qtdemux and qtmux */
+static gint
+v4l2_profile_from_string (const gchar * profile)
+{
+  gint v4l2_profile = -1;
+
+  if (g_str_equal (profile, "proxy"))
+    v4l2_profile = V4L2_MPEG_VIDEO_PRORES_PROFILE_PROXY;
+  else if (g_str_equal (profile, "lt"))
+    v4l2_profile = V4L2_MPEG_VIDEO_PRORES_PROFILE_LT;
+  else if (g_str_equal (profile, "standard"))
+    v4l2_profile = V4L2_MPEG_VIDEO_PRORES_PROFILE_STANDARD;
+  else if (g_str_equal (profile, "hq"))
+    v4l2_profile = V4L2_MPEG_VIDEO_PRORES_PROFILE_HQ;
+  else if (g_str_equal (profile, "4444"))
+    v4l2_profile = V4L2_MPEG_VIDEO_PRORES_PROFILE_4444;
+  else if (g_str_equal (profile, "4444xq"))
+    v4l2_profile = V4L2_MPEG_VIDEO_PRORES_PROFILE_4444_XQ;
+  else
+    GST_WARNING ("Unsupported profile string '%s'", profile);
+
+  return v4l2_profile;
+}
+
+static const gchar *
+v4l2_profile_to_string (gint v4l2_profile)
+{
+  switch (v4l2_profile) {
+    case V4L2_MPEG_VIDEO_PRORES_PROFILE_PROXY:
+      return "proxy";
+    case V4L2_MPEG_VIDEO_PRORES_PROFILE_LT:
+      return "lt";
+    case V4L2_MPEG_VIDEO_PRORES_PROFILE_STANDARD:
+      return "standard";
+    case V4L2_MPEG_VIDEO_PRORES_PROFILE_HQ:
+      return "hq";
+    case V4L2_MPEG_VIDEO_PRORES_PROFILE_4444:
+      return "4444";
+    case V4L2_MPEG_VIDEO_PRORES_PROFILE_4444_XQ:
+      return "4444xq";
+    default:
+      GST_WARNING ("Unsupported V4L2 profile %i", v4l2_profile);
+      break;
+  }
+
+  return NULL;
+}
+
+const GstV4l2Codec *
+gst_v4l2_prores_get_codec (void)
+{
+  static GstV4l2Codec *codec = NULL;
+  if (g_once_init_enter (&codec)) {
+    static GstV4l2Codec c;
+    c.profile_cid = V4L2_CID_MPEG_VIDEO_PRORES_PROFILE;
+    c.profile_to_string = v4l2_profile_to_string;
+    c.profile_from_string = v4l2_profile_from_string;
+    c.profile_field = "variant";
+    g_once_init_leave (&codec, &c);
+  }
+  return codec;
+}

diff --git a/plugins/color/gsd-ambient-white-point.c b/plugins/color/gsd-ambient-white-point.c
new file mode 100644
index 0000000..456c16d
--- /dev/null
+++ b/plugins/color/gsd-ambient-white-point.c
@@ -0,0 +1,296 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "gsd-ambient-white-point.h"
+#include "gsd-ambient-policy.h"
+#include <math.h>
+#include <time.h>
+
+struct _GsdAmbientWhitePoint {
+        GObject parent;
+        GSettings *settings;
+        char *sensor_root;
+        gint64 last_sample;
+        GDBusProxy *display;
+        GCancellable *cancellable;
+        GsdAmbientPolicy policy;
+        guint timer;
+        guint generation;
+        gboolean running;
+        gboolean pending;
+        gboolean supported;
+        gboolean paused;
+        gboolean inhibited;
+};
+G_DEFINE_TYPE (GsdAmbientWhitePoint, gsd_ambient_white_point, G_TYPE_OBJECT)
+static guint changed_signal;
+static gboolean poll_sensor (gpointer data);
+
+typedef struct {
+        guint generation;
+        gint64 requested_at;
+} SampleRequest;
+
+static gint64
+sample_clock (void)
+{
+#ifdef CLOCK_BOOTTIME
+        struct timespec value;
+        /* Include suspend in sample age on Linux, where IIO is available. */
+        if (clock_gettime (CLOCK_BOOTTIME, &value) == 0)
+                return value.tv_sec * G_USEC_PER_SEC + value.tv_nsec / 1000;
+#endif
+        return g_get_monotonic_time ();
+}
+
+static gboolean
+enabled (GsdAmbientWhitePoint *self)
+{
+        return g_settings_get_boolean (self->settings, "ambient-white-point-enabled");
+}
+
+static void
+reset (GsdAmbientWhitePoint *self)
+{
+        self->generation++;
+        gsd_ambient_policy_reset (&self->policy);
+        g_signal_emit (self, changed_signal, 0);
+}
+
+/* sysfs reads may wait for hardware. Keep them off the GSD main loop, with
+ * just one outstanding read. GTask retains the object until completion. */
+static void
+read_sensor (GTask *task, gpointer source, gpointer task_data, GCancellable *cancellable)
+{
+        double *temperature = g_new (double, 1);
+        GsdAmbientWhitePoint *self = source;
+        if (gsd_ambient_read_temperature (self->sensor_root, temperature))
+                g_task_return_pointer (task, temperature, g_free);
+        else {
+                g_free (temperature);
+                g_task_return_pointer (task, NULL, NULL);
+        }
+}
+
+static void
+sensor_ready (GObject *object, GAsyncResult *result, gpointer data)
+{
+        GsdAmbientWhitePoint *self = GSD_AMBIENT_WHITE_POINT (object);
+        GTask *task = G_TASK (result);
+        g_autofree double *temperature = g_task_propagate_pointer (task, NULL);
+        SampleRequest *request = g_task_get_task_data (task);
+
+        self->pending = FALSE;
+        if (!self->running || !enabled (self) || !self->supported || self->paused || self->inhibited ||
+            request->generation != self->generation)
+                return;
+        if (sample_clock () - request->requested_at >= 15 * G_USEC_PER_SEC) {
+                reset (self);
+                return;
+        }
+        self->last_sample = sample_clock ();
+        gsd_ambient_policy_update (&self->policy, temperature != NULL,
+                                   temperature ? *temperature : 0);
+        g_signal_emit (self, changed_signal, 0);
+}
+
+static gboolean
+poll_sensor (gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+        g_autoptr(GTask) task = NULL;
+        SampleRequest *request;
+
+        if (self->policy.valid && sample_clock () - self->last_sample >= 15 * G_USEC_PER_SEC)
+                reset (self);
+        if (!self->running || !enabled (self) || !self->supported || self->paused || self->inhibited || self->pending)
+                return G_SOURCE_CONTINUE;
+        self->pending = TRUE;
+        task = g_task_new (self, NULL, sensor_ready, NULL);
+        request = g_new (SampleRequest, 1);
+        request->generation = self->generation;
+        request->requested_at = sample_clock ();
+        g_task_set_task_data (task, request, g_free);
+        g_task_run_in_thread (task, read_sensor);
+        return G_SOURCE_CONTINUE;
+}
+
+static void
+setting_changed (GSettings *settings, const char *key, gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+        self->paused = FALSE;
+        reset (self);
+        poll_sensor (self);
+}
+
+static void
+update_supported (GsdAmbientWhitePoint *self)
+{
+        g_autoptr(GVariant) value = g_dbus_proxy_get_cached_property (self->display, "NightLightSupported");
+        g_autofree char *owner = g_dbus_proxy_get_name_owner (self->display);
+        gboolean supported = owner && value && g_variant_is_of_type (value, G_VARIANT_TYPE_BOOLEAN) &&
+                             g_variant_get_boolean (value);
+        /* Invalidate the sample also on owner changes. Never reuse a reading
+         * after compositor loss, disable/re-enable, or shutdown. */
+        self->supported = supported;
+        reset (self);
+        poll_sensor (self);
+}
+
+static void
+properties_changed (GDBusProxy *proxy, GVariant *properties, const char * const *invalidated, gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+        g_autoptr(GVariant) value = g_variant_lookup_value (properties, "NightLightSupported", NULL);
+        if (value || g_strv_contains (invalidated, "NightLightSupported"))
+                update_supported (self);
+}
+
+static void
+owner_changed (GObject *object, GParamSpec *pspec, gpointer data)
+{
+        update_supported (data);
+}
+
+typedef struct {
+        GsdAmbientWhitePoint *self;
+        GCancellable *cancellable;
+} ProxyRequest;
+
+static void
+proxy_ready (GObject *object, GAsyncResult *result, gpointer data)
+{
+        ProxyRequest *request = data;
+        GsdAmbientWhitePoint *self = request->self;
+        g_autoptr(GError) error = NULL;
+        GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+        if (self->running && self->cancellable == request->cancellable && proxy) {
+                self->display = proxy;
+                g_signal_connect (proxy, "g-properties-changed", G_CALLBACK (properties_changed), self);
+                g_signal_connect (proxy, "notify::g-name-owner", G_CALLBACK (owner_changed), self);
+                update_supported (self);
+        } else
+                g_clear_object (&proxy);
+        g_object_unref (request->cancellable);
+        g_object_unref (self);
+        g_free (request);
+}
+
+void
+gsd_ambient_white_point_start (GsdAmbientWhitePoint *self)
+{
+        ProxyRequest *request;
+        if (self->running)
+                return;
+        self->running = TRUE;
+        self->cancellable = g_cancellable_new ();
+        request = g_new (ProxyRequest, 1);
+        request->self = g_object_ref (self);
+        request->cancellable = g_object_ref (self->cancellable);
+        g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+                                 NULL, "org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
+                                 "org.gnome.Mutter.DisplayConfig", self->cancellable,
+                                 proxy_ready, request);
+        self->timer = g_timeout_add_seconds (5, poll_sensor, self);
+}
+
+void
+gsd_ambient_white_point_stop (GsdAmbientWhitePoint *self)
+{
+        self->running = FALSE;
+        g_clear_handle_id (&self->timer, g_source_remove);
+        if (self->cancellable)
+                g_cancellable_cancel (self->cancellable);
+        g_clear_object (&self->cancellable);
+        if (self->display)
+                g_signal_handlers_disconnect_by_data (self->display, self);
+        g_clear_object (&self->display);
+        self->supported = FALSE;
+        reset (self);
+}
+
+void
+gsd_ambient_white_point_set_inhibited (GsdAmbientWhitePoint *self, gboolean inhibited)
+{
+        if (self->inhibited == inhibited)
+                return;
+        self->inhibited = inhibited;
+        /* Start the next ownership period from neutral. Otherwise a target
+         * accumulated during Night Light would jump when its fade finishes. */
+        reset (self);
+        poll_sensor (self);
+}
+
+void
+gsd_ambient_white_point_pause (GsdAmbientWhitePoint *self)
+{
+        /* A manual D-Bus temperature takes precedence until the user toggles
+         * ambient adaptation. Do not rewrite either user's persistent setting. */
+        self->paused = TRUE;
+        reset (self);
+}
+
+gboolean
+gsd_ambient_white_point_get_available (GsdAmbientWhitePoint *self)
+{
+        return self->running && self->supported && self->policy.valid;
+}
+
+gboolean
+gsd_ambient_white_point_get_paused (GsdAmbientWhitePoint *self)
+{
+        return self->paused;
+}
+
+gboolean
+gsd_ambient_white_point_get_active (GsdAmbientWhitePoint *self)
+{
+        return enabled (self) && !self->paused && !self->inhibited && gsd_ambient_white_point_get_available (self);
+}
+
+guint
+gsd_ambient_white_point_get_temperature (GsdAmbientWhitePoint *self)
+{
+        return (guint) round (self->policy.temperature);
+}
+
+static void
+gsd_ambient_white_point_dispose (GObject *object)
+{
+        GsdAmbientWhitePoint *self = GSD_AMBIENT_WHITE_POINT (object);
+        gsd_ambient_white_point_stop (self);
+        g_clear_object (&self->settings);
+        G_OBJECT_CLASS (gsd_ambient_white_point_parent_class)->dispose (object);
+}
+
+static void
+gsd_ambient_white_point_finalize (GObject *object)
+{
+        GsdAmbientWhitePoint *self = GSD_AMBIENT_WHITE_POINT (object);
+        g_free (self->sensor_root);
+        G_OBJECT_CLASS (gsd_ambient_white_point_parent_class)->finalize (object);
+}
+
+static void
+gsd_ambient_white_point_class_init (GsdAmbientWhitePointClass *klass)
+{
+        G_OBJECT_CLASS (klass)->dispose = gsd_ambient_white_point_dispose;
+        G_OBJECT_CLASS (klass)->finalize = gsd_ambient_white_point_finalize;
+        changed_signal = g_signal_new ("changed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST,
+                                       0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+}
+
+static void
+gsd_ambient_white_point_init (GsdAmbientWhitePoint *self)
+{
+        gsd_ambient_policy_reset (&self->policy);
+        self->settings = g_settings_new ("org.gnome.settings-daemon.plugins.color");
+        g_signal_connect (self->settings, "changed::ambient-white-point-enabled", G_CALLBACK (setting_changed), self);
+}
+
+GsdAmbientWhitePoint *
+gsd_ambient_white_point_new (const char *sensor_root)
+{
+        GsdAmbientWhitePoint *self = g_object_new (GSD_TYPE_AMBIENT_WHITE_POINT, NULL);
+        self->sensor_root = g_strdup (sensor_root);
+        return self;
+}

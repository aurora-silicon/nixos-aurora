+        gdouble night = gsd_night_light_get_temperature (manager->nlight);
+        gboolean active;
+        guint temperature;
+
+        gsd_ambient_white_point_set_inhibited (manager->ambient,
+                gsd_night_light_get_active (manager->nlight) ||
+                gsd_night_light_get_forced (manager->nlight) ||
+                fabs (night - GSD_COLOR_TEMPERATURE_DEFAULT) >= 0.5);
+        temperature = gsd_ambient_select_temperature (
+                gsd_ambient_white_point_get_temperature (manager->ambient), night,
+                gsd_ambient_white_point_get_active (manager->ambient),
+                gsd_night_light_get_active (manager->nlight),

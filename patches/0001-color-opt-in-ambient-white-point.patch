diff --git a/plugins/color/ambient-policy-test.c b/plugins/color/ambient-policy-test.c
new file mode 100644
index 0000000..657e2b6
--- /dev/null
+++ b/plugins/color/ambient-policy-test.c
@@ -0,0 +1,218 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "gsd-ambient-policy.h"
+#include <glib/gstdio.h>
+#include <math.h>
+
+static char *root;
+static char *device;
+
+static void
+write_value (const char *name, const char *value)
+{
+        g_autofree char *path = g_build_filename (device, name, NULL);
+        g_assert_true (g_file_set_contents (path, value, -1, NULL));
+}
+
+static void
+remove_value (const char *name)
+{
+        g_autofree char *path = g_build_filename (device, name, NULL);
+        g_unlink (path);
+}
+
+static void
+test_sensor (void)
+{
+        double value = -1;
+        const char *invalid[] = { "", "nan", "inf", "-1", "0", "999", "10001", "6500 K", "1e9999", "4000\n5000" };
+        g_autofree char *second = NULL;
+        g_autofree char *second_raw = NULL;
+
+        /* Brightness and chip temperature never stand in for CCT. */
+        write_value ("in_illuminance_raw", "5000");
+        write_value ("in_temp_input", "5000");
+        write_value ("in_cct_input", "5000");
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+        write_value ("in_colortemp_raw", " 5200\n");
+        g_assert_true (gsd_ambient_read_temperature (root, &value));
+        g_assert_cmpfloat (value, ==, 5200);
+        for (guint i = 0; i < G_N_ELEMENTS (invalid); i++) {
+                write_value ("in_colortemp_raw", invalid[i]);
+                g_assert_false (gsd_ambient_read_temperature (root, &value));
+        }
+        write_value ("in_colortemp_raw", "2590");
+        write_value ("in_colortemp_offset", "10");
+        write_value ("in_colortemp_scale", "2");
+        g_assert_true (gsd_ambient_read_temperature (root, &value));
+        g_assert_cmpfloat (value, ==, 5200);
+        write_value ("in_colortemp_scale", "0");
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+        write_value ("in_colortemp_scale", "broken");
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+        remove_value ("in_colortemp_scale");
+        remove_value ("in_colortemp_offset");
+        write_value ("in_colortemp_raw", "5000");
+        second = g_build_filename (root, "iio:device1", NULL);
+        second_raw = g_build_filename (second, "in_colortemp_raw", NULL);
+        g_mkdir (second, 0700);
+        g_file_set_contents (second_raw, "5500", -1, NULL);
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+        g_unlink (second_raw);
+        g_rmdir (second);
+        remove_value ("in_colortemp_raw");
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+        remove_value ("in_illuminance_raw");
+        remove_value ("in_temp_input");
+        remove_value ("in_cct_input");
+}
+
+static void
+test_input_only (void)
+{
+        double value = -1;
+        const char *invalid[] = { "", "nan", "inf", "-1", "0", "999", "10001", "6500 K", "1e9999", "4000\n5000" };
+
+        /* A processed-only device needs neither raw nor scale/offset. */
+        write_value ("in_colortemp_input", " 5200.5\n");
+        g_assert_true (gsd_ambient_read_temperature (root, &value));
+        g_assert_cmpfloat (value, ==, 5200.5);
+        for (guint i = 0; i < G_N_ELEMENTS (invalid); i++) {
+                write_value ("in_colortemp_input", invalid[i]);
+                g_assert_false (gsd_ambient_read_temperature (root, &value));
+        }
+        write_value ("in_colortemp_input", "1000");
+        g_assert_true (gsd_ambient_read_temperature (root, &value));
+        g_assert_cmpfloat (value, ==, 1000);
+        write_value ("in_colortemp_input", "10000");
+        g_assert_true (gsd_ambient_read_temperature (root, &value));
+        g_assert_cmpfloat (value, ==, 10000);
+        remove_value ("in_colortemp_input");
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+}
+
+static void
+test_input_preferred (void)
+{
+        double value = -1;
+
+        write_value ("in_colortemp_input", "5500");
+        write_value ("in_colortemp_raw", "2590");
+        write_value ("in_colortemp_offset", "10");
+        write_value ("in_colortemp_scale", "2");
+        g_assert_true (gsd_ambient_read_temperature (root, &value));
+        g_assert_cmpfloat (value, ==, 5500);
+        /* A present but invalid input must fail, even with valid raw data. */
+        write_value ("in_colortemp_input", "broken");
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+        /* An unreadable processed channel must not fall back either. */
+        remove_value ("in_colortemp_input");
+        g_autofree char *input = g_build_filename (device, "in_colortemp_input", NULL);
+        g_assert_cmpint (g_mkdir (input, 0700), ==, 0);
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+        g_assert_cmpint (g_rmdir (input), ==, 0);
+        /* Removing input restores the original IIO raw conversion. */
+        g_assert_true (gsd_ambient_read_temperature (root, &value));
+        g_assert_cmpfloat (value, ==, 5200);
+        write_value ("in_colortemp_input", "5500");
+        write_value ("in_colortemp_raw", "broken");
+        write_value ("in_colortemp_offset", "broken");
+        write_value ("in_colortemp_scale", "broken");
+        g_assert_true (gsd_ambient_read_temperature (root, &value));
+        g_assert_cmpfloat (value, ==, 5500);
+        remove_value ("in_colortemp_input");
+        remove_value ("in_colortemp_raw");
+        remove_value ("in_colortemp_offset");
+        remove_value ("in_colortemp_scale");
+}
+
+static void
+test_input_ambiguity (void)
+{
+        double value = -1;
+        g_autofree char *second = g_build_filename (root, "iio:device1", NULL);
+        g_autofree char *second_input = g_build_filename (second, "in_colortemp_input", NULL);
+        g_autofree char *second_raw = g_build_filename (second, "in_colortemp_raw", NULL);
+
+        write_value ("in_colortemp_input", "5200");
+        g_assert_cmpint (g_mkdir (second, 0700), ==, 0);
+        g_assert_true (g_file_set_contents (second_input, "5500", -1, NULL));
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+        g_unlink (second_input);
+        g_assert_true (g_file_set_contents (second_raw, "5500", -1, NULL));
+        g_assert_false (gsd_ambient_read_temperature (root, &value));
+        g_unlink (second_raw);
+        g_rmdir (second);
+        remove_value ("in_colortemp_input");
+}
+
+static void
+test_policy (void)
+{
+        GsdAmbientPolicy policy;
+        gsd_ambient_policy_reset (&policy);
+        g_assert_false (policy.valid);
+        g_assert_cmpfloat (policy.temperature, ==, 6500);
+        for (guint i = 0; i < 100; i++) {
+                double before = policy.temperature;
+                gsd_ambient_policy_update (&policy, TRUE, 2700);
+                g_assert_true (policy.valid);
+                g_assert_cmpfloat (fabs (before - policy.temperature), <=, 100);
+                g_assert_cmpfloat (policy.temperature, >=, 4000);
+        }
+        g_assert_cmpfloat (policy.temperature, ==, 4000);
+        gsd_ambient_policy_update (&policy, TRUE, 4020);
+        g_assert_cmpfloat (policy.temperature, ==, 4000);
+        for (guint i = 0; i < 100; i++)
+                gsd_ambient_policy_update (&policy, TRUE, 10000);
+        g_assert_cmpfloat (policy.temperature, ==, 6500);
+        gsd_ambient_policy_update (&policy, TRUE, NAN);
+        g_assert_false (policy.valid);
+        gsd_ambient_policy_update (&policy, TRUE, 5000);
+        gsd_ambient_policy_update (&policy, FALSE, 5000);
+        g_assert_false (policy.valid);
+        g_assert_cmpfloat (policy.temperature, ==, 6500);
+}
+
+static void
+test_priority (void)
+{
+        const struct { double night; gboolean available, scheduled, preview, active; guint expected; } cases[] = {
+                { 6500, TRUE, FALSE, FALSE, TRUE, 5000 },
+                { 6500, FALSE, FALSE, FALSE, FALSE, 6500 },
+                { 6500, TRUE, TRUE, FALSE, FALSE, 6500 },
+                { 2700, TRUE, TRUE, FALSE, FALSE, 2700 },
+                { 2700, TRUE, FALSE, TRUE, FALSE, 2700 },
+                { 6500, TRUE, FALSE, TRUE, FALSE, 6500 },
+                { 6400, TRUE, FALSE, FALSE, FALSE, 6400 },
+        };
+        for (guint i = 0; i < G_N_ELEMENTS (cases); i++) {
+                gboolean active;
+                guint output = gsd_ambient_select_temperature (5000, cases[i].night,
+                        cases[i].available, cases[i].scheduled, cases[i].preview, &active);
+                g_assert_cmpint (active, ==, cases[i].active);
+                g_assert_cmpuint (output, ==, cases[i].expected);
+        }
+}
+
+int
+main (int argc, char **argv)
+{
+        int result;
+        g_test_init (&argc, &argv, NULL);
+        root = g_dir_make_tmp ("ambient-policy-XXXXXX", NULL);
+        g_assert_nonnull (root);
+        device = g_build_filename (root, "iio:device0", NULL);
+        g_mkdir (device, 0700);
+        g_test_add_func ("/ambient/sensor-validation", test_sensor);
+        g_test_add_func ("/ambient/input-only", test_input_only);
+        g_test_add_func ("/ambient/input-preferred", test_input_preferred);
+        g_test_add_func ("/ambient/input-ambiguity", test_input_ambiguity);
+        g_test_add_func ("/ambient/filter-and-fallback", test_policy);
+        g_test_add_func ("/ambient/night-light-priority", test_priority);
+        result = g_test_run ();
+        g_rmdir (device);
+        g_rmdir (root);
+        g_free (device);
+        g_free (root);
+        return result;
+}
diff --git a/plugins/color/ambient-service-test.c b/plugins/color/ambient-service-test.c
new file mode 100644
index 0000000..6f80729
--- /dev/null
+++ b/plugins/color/ambient-service-test.c
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "gsd-ambient-white-point.h"
+#include <glib/gstdio.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+static gboolean supported = TRUE;
+static GDBusConnection *connection;
+static GsdAmbientWhitePoint *ambient;
+
+static GVariant *
+get_property (GDBusConnection *c, const char *sender, const char *path,
+              const char *interface, const char *property, GError **error, gpointer data)
+{
+        return g_variant_new_boolean (supported);
+}
+static const GDBusInterfaceVTable vtable = { .get_property = get_property };
+
+static void
+wait_active_for (gboolean expected, guint seconds)
+{
+        gint64 deadline = g_get_monotonic_time () + seconds * G_USEC_PER_SEC;
+        while (gsd_ambient_white_point_get_active (ambient) != expected &&
+               g_get_monotonic_time () < deadline) {
+                while (g_main_context_iteration (NULL, FALSE));
+                g_usleep (1000);
+        }
+        g_assert_cmpint (gsd_ambient_white_point_get_active (ambient), ==, expected);
+}
+
+static void
+wait_active (gboolean expected)
+{
+        wait_active_for (expected, 8);
+}
+
+static void
+set_supported (gboolean value)
+{
+        GVariantBuilder properties;
+        supported = value;
+        g_variant_builder_init (&properties, G_VARIANT_TYPE_VARDICT);
+        g_variant_builder_add (&properties, "{sv}", "NightLightSupported", g_variant_new_boolean (value));
+        g_dbus_connection_emit_signal (connection, NULL, "/org/gnome/Mutter/DisplayConfig",
+                                       "org.freedesktop.DBus.Properties", "PropertiesChanged",
+                                       g_variant_new ("(sa{sv}as)", "org.gnome.Mutter.DisplayConfig", &properties, NULL), NULL);
+}
+
+static void
+test_lifecycle (void)
+{
+        g_autoptr(GSettings) settings = g_settings_new ("org.gnome.settings-daemon.plugins.color");
+        g_autofree char *root = g_dir_make_tmp ("ambient-service-XXXXXX", NULL);
+        g_autofree char *device = g_build_filename (root, "iio:device0", NULL);
+        g_autofree char *input = g_build_filename (device, "in_colortemp_input", NULL);
+        g_autoptr(GDBusNodeInfo) info = g_dbus_node_info_new_for_xml (
+                "<node><interface name='org.gnome.Mutter.DisplayConfig'>"
+                "<property name='NightLightSupported' type='b' access='read'/>"
+                "</interface></node>", NULL);
+        guint registration, owner;
+
+        g_mkdir (device, 0700);
+        g_file_set_contents (input, "5000", -1, NULL);
+        connection = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+        g_assert_nonnull (connection);
+        registration = g_dbus_connection_register_object (connection, "/org/gnome/Mutter/DisplayConfig",
+                                                          info->interfaces[0], &vtable, NULL, NULL, NULL);
+        g_assert_cmpuint (registration, !=, 0);
+        owner = g_bus_own_name_on_connection (connection, "org.gnome.Mutter.DisplayConfig",
+                                              G_BUS_NAME_OWNER_FLAGS_NONE, NULL, NULL, NULL, NULL);
+        ambient = gsd_ambient_white_point_new (root);
+        g_assert_false (g_settings_get_boolean (settings, "ambient-white-point-enabled"));
+        gsd_ambient_white_point_start (ambient);
+        g_assert_false (gsd_ambient_white_point_get_active (ambient));
+        g_settings_set_boolean (settings, "ambient-white-point-enabled", TRUE);
+        wait_active (TRUE);
+        g_assert_true (gsd_ambient_white_point_get_available (ambient));
+        g_assert_cmpuint (gsd_ambient_white_point_get_temperature (ambient), ==, 6400);
+        set_supported (FALSE);
+        wait_active (FALSE);
+        g_assert_false (gsd_ambient_white_point_get_available (ambient));
+        set_supported (TRUE);
+        wait_active (TRUE);
+        gsd_ambient_white_point_set_inhibited (ambient, TRUE);
+        g_assert_false (gsd_ambient_white_point_get_active (ambient));
+        g_assert_cmpuint (gsd_ambient_white_point_get_temperature (ambient), ==, 6500);
+        gsd_ambient_white_point_set_inhibited (ambient, FALSE);
+        wait_active (TRUE);
+        g_assert_cmpuint (gsd_ambient_white_point_get_temperature (ambient), ==, 6400);
+        gsd_ambient_white_point_pause (ambient);
+        g_assert_false (gsd_ambient_white_point_get_active (ambient));
+        g_settings_set_boolean (settings, "ambient-white-point-enabled", FALSE);
+        g_settings_set_boolean (settings, "ambient-white-point-enabled", TRUE);
+        wait_active (TRUE);
+        /* A disappearing sensor must clear the last reading. */
+        g_unlink (input);
+        wait_active (FALSE);
+        g_assert_false (gsd_ambient_white_point_get_available (ambient));
+        g_file_set_contents (input, "5500", -1, NULL);
+        wait_active (TRUE);
+        /* A stuck driver must not freeze the main loop or retain a stale
+         * white point. A FIFO models a read that waits beyond the deadline. */
+        g_unlink (input);
+        g_assert_cmpint (mkfifo (input, 0600), ==, 0);
+        wait_active_for (FALSE, 22);
+        g_assert_false (gsd_ambient_white_point_get_available (ambient));
+        int writer = open (input, O_WRONLY | O_NONBLOCK);
+        g_assert_cmpint (writer, >=, 0);
+        g_assert_cmpint (write (writer, "5000\n", 5), ==, 5);
+        close (writer);
+        g_unlink (input);
+        g_file_set_contents (input, "5500", -1, NULL);
+        wait_active (TRUE);
+        g_bus_unown_name (owner);
+        wait_active (FALSE);
+        /* Stopping while initialization may be outstanding is safe. */
+        gsd_ambient_white_point_stop (ambient);
+        gsd_ambient_white_point_start (ambient);
+        gsd_ambient_white_point_stop (ambient);
+        g_settings_set_boolean (settings, "ambient-white-point-enabled", FALSE);
+        g_object_unref (ambient);
+        /* Drain the cancellation callback before shutting down the test bus. */
+        gint64 deadline = g_get_monotonic_time () + G_USEC_PER_SEC;
+        while (g_get_monotonic_time () < deadline) {
+                while (g_main_context_iteration (NULL, FALSE));
+                g_usleep (1000);
+        }
+        g_dbus_connection_unregister_object (connection, registration);
+        g_object_unref (connection);
+        g_unlink (input);
+        g_rmdir (device);
+        g_rmdir (root);
+}
+
+int
+main (int argc, char **argv)
+{
+        g_autoptr(GTestDBus) bus = NULL;
+        int result;
+        g_test_init (&argc, &argv, NULL);
+        g_setenv ("GSETTINGS_BACKEND", "memory", TRUE);
+        bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+        g_test_dbus_up (bus);
+        g_test_add_func ("/ambient/service-lifecycle", test_lifecycle);
+        result = g_test_run ();
+        g_test_dbus_down (bus);
+        return result;
+}
diff --git a/plugins/color/gsd-ambient-policy.c b/plugins/color/gsd-ambient-policy.c
new file mode 100644
index 0000000..540e64b
--- /dev/null
+++ b/plugins/color/gsd-ambient-policy.c
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "gsd-ambient-policy.h"
+#include <errno.h>
+#include <string.h>
+#include <math.h>
+#include <glib/gstdio.h>
+
+/* IIO's processed colortemp input is already Kelvin. Never substitute
+ * illuminance or die temperature. If input is absent, a raw channel uses
+ * (raw + offset) * scale, as usual for IIO. */
+static gboolean
+read_number (const char *directory, const char *name, double fallback,
+             gboolean optional, double *value)
+{
+        g_autofree char *path = g_build_filename (directory, name, NULL);
+        g_autofree char *text = NULL;
+        g_autoptr(GError) error = NULL;
+        char *end;
+
+        if (!g_file_get_contents (path, &text, NULL, &error)) {
+                if (optional && g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT)) {
+                        *value = fallback;
+                        return TRUE;
+                }
+                return FALSE;
+        }
+        errno = 0;
+        *value = g_ascii_strtod (text, &end);
+        if (end == text || errno != 0 || !isfinite (*value))
+                return FALSE;
+        while (g_ascii_isspace (*end))
+                end++;
+        return *end == '\0';
+}
+
+gboolean
+gsd_ambient_read_temperature (const char *root, double *kelvin)
+{
+        g_autoptr(GDir) directory = g_dir_open (root, 0, NULL);
+        const char *name;
+        guint candidates = 0;
+        double result = 0;
+
+        if (!directory)
+                return FALSE;
+        while ((name = g_dir_read_name (directory))) {
+                g_autofree char *device = NULL;
+                g_autofree char *input_path = NULL;
+                g_autofree char *raw_path = NULL;
+                double raw, offset, scale;
+                gboolean processed;
+                const char *suffix;
+
+                if (!g_str_has_prefix (name, "iio:device"))
+                        continue;
+                suffix = name + strlen ("iio:device");
+                if (!*suffix)
+                        continue;
+                while (g_ascii_isdigit (*suffix))
+                        suffix++;
+                if (*suffix)
+                        continue;
+                device = g_build_filename (root, name, NULL);
+                input_path = g_build_filename (device, "in_colortemp_input", NULL);
+                raw_path = g_build_filename (device, "in_colortemp_raw", NULL);
+                processed = g_file_test (input_path, G_FILE_TEST_EXISTS);
+                if (!processed && !g_file_test (raw_path, G_FILE_TEST_EXISTS))
+                        continue;
+                /* Multiple sensors require an explicit future association policy.
+                 * Do not select whichever directory happens to be enumerated first. */
+                candidates++;
+                if (candidates > 1)
+                        return FALSE;
+                if (processed) {
+                        /* Do not scale processed values or hide a failed input
+                         * read by switching to a different representation. */
+                        if (!read_number (device, "in_colortemp_input", 0, FALSE, &result))
+                                return FALSE;
+                } else {
+                        if (!read_number (device, "in_colortemp_raw", 0, FALSE, &raw) ||
+                            !read_number (device, "in_colortemp_offset", 0, TRUE, &offset) ||
+                            !read_number (device, "in_colortemp_scale", 1, TRUE, &scale) ||
+                            scale <= 0)
+                                return FALSE;
+                        result = (raw + offset) * scale;
+                }
+                if (!isfinite (result) || result < 1000 || result > 10000)
+                        return FALSE;
+        }
+        if (candidates != 1)
+                return FALSE;
+        *kelvin = result;
+        return TRUE;
+}
+
+void
+gsd_ambient_policy_reset (GsdAmbientPolicy *policy)
+{
+        policy->valid = FALSE;
+        policy->temperature = 6500;
+}
+
+void
+gsd_ambient_policy_update (GsdAmbientPolicy *policy, gboolean valid, double kelvin)
+{
+        double target, delta;
+
+        if (!valid || !isfinite (kelvin) || kelvin < 1000 || kelvin > 10000) {
+                gsd_ambient_policy_reset (policy);
+                return;
+        }
+        /* Conservative display range; at most 100 K per five-second sample.
+         * These are draft comfort-policy constants, not sensor calibration. */
+        target = CLAMP (kelvin, 4000, 6500);
+        delta = target - policy->temperature;
+        if (fabs (delta) >= 50)
+                policy->temperature += CLAMP (delta, -100, 100);
+        policy->valid = TRUE;
+}
+
+guint
+gsd_ambient_select_temperature (guint ambient, double night,
+                                gboolean available, gboolean night_active,
+                                gboolean preview, gboolean *active)
+{
+        *active = available && !night_active && !preview && fabs (night - 6500) < 0.5;
+        return *active ? ambient : (guint) round (night);
+}

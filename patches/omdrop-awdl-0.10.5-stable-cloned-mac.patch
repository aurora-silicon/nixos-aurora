--- a/userspace/awdl-up
+++ b/userspace/awdl-up
@@ -290,9 +290,18 @@
 # inside that gap: this unit exited 5 there, the laptop came up with no awdl0,
 # and the receiver crash-looped behind it for want of a link-local. Wait for the
 # address to settle instead of refusing on the first look.
+# Aurora: Fedora's NetworkManager default gives each Wi-Fi network its own
+# cloned MAC (wifi.cloned-mac-address=stable-ssid), so permaddr stays listed
+# for as long as the station is associated. Once NetworkManager reports it
+# connected, the address no longer changes with scans, which is all the
+# derivation below needs.
+sta_settled(){
+  [[ $(cat "/sys/class/net/$STA/operstate" 2>/dev/null) == up ]] &&
+    [[ $(nmcli -g GENERAL.STATE device show "$STA" 2>/dev/null) == 100* ]]
+}
 wait_permaddr(){
   local waited=0
-  while ip -d link show "$STA" | grep -q permaddr; do
+  while ip -d link show "$STA" | grep -q permaddr && ! sta_settled; do
     [[ $waited -ge $WAIT_MAC ]] && return 1
     sleep 2; waited=$(( waited + 2 ))
   done

+        let caps = client_capabilities(&[], false);
+        assert!(!caps.user_verifying_platform_authenticator);
+        assert!(!caps.passkey_platform_authenticator);
+        assert!(!caps.hybrid_transport);
+
+        let caps = client_capabilities(&[], true);
+        assert!(!caps.user_verifying_platform_authenticator);
+        assert!(caps.passkey_platform_authenticator);
+        assert!(caps.hybrid_transport);
+
+        let caps = client_capabilities(std::slice::from_ref(&no_uv), false);
+        assert!(!caps.user_verifying_platform_authenticator);
+
+        let caps = client_capabilities(&[no_uv, biometric], false);
+        assert!(caps.user_verifying_platform_authenticator);
+        assert!(caps.passkey_platform_authenticator);
+        assert!(!caps.conditional_get);
+        assert!(!caps.conditional_create);
+    }
+
+    #[test]
+    fn capabilities_serialize_as_snake_case_dict() {
+        let caps = client_capabilities(&[], true);
+        let zbus::zvariant::Value::Dict(dict) = zbus::zvariant::Value::from(caps) else {
+            panic!("capabilities should serialize as a dict");
+        };
+        let get = |key: &str| dict.get::<&str, bool>(&key).unwrap();
+        assert_eq!(get("hybrid_transport"), Some(true));
+        assert_eq!(get("user_verifying_platform_authenticator"), Some(false));
+        assert_eq!(get("conditional_get"), Some(false));
+    }
 

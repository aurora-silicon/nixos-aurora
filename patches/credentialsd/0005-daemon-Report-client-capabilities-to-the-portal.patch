+/// WebAuthn client capabilities, as returned by `getClientCapabilities()`.
+///
+/// See <https://www.w3.org/TR/webauthn-3/#enumdef-clientcapability>. Keys use
+/// snake_case on D-Bus; the portal maps them to the WebAuthn names.
+#[derive(Clone, Debug, Default, PartialEq, SerializeDict, Type, Value)]
+#[zvariant(signature = "dict")]
+pub struct ClientCapabilities {
+    pub conditional_create: bool,
+    pub conditional_get: bool,
+    pub hybrid_transport: bool,
+    pub passkey_platform_authenticator: bool,
+    pub user_verifying_platform_authenticator: bool,
+    pub related_origins: bool,
+    pub signal_all_accepted_credentials: bool,
+    pub signal_current_user_details: bool,
+    pub signal_unknown_credential: bool,
+}
+
+/// Computes client capabilities from the platform providers that answered
+/// `GetInfo()` and whether the hybrid transport is available.
+fn client_capabilities(providers: &[ProviderInfo], hybrid: bool) -> ClientCapabilities {
+    // A locked provider still counts: the user can unlock it when asked.
+    let user_verifying_platform_authenticator = providers
+        .iter()
+        .any(|info| !info.user_verification.is_empty());
+    ClientCapabilities {
+        hybrid_transport: hybrid,
+        user_verifying_platform_authenticator,
+        passkey_platform_authenticator: user_verifying_platform_authenticator || hybrid,
+        // Requests are validated with WebAuthn related origin requests.
+        related_origins: true,
+        ..Default::default()
+    }
+}

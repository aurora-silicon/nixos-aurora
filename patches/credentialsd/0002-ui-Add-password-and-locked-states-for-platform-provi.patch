diff --git a/credentialsd-ui/src/client.rs b/credentialsd-ui/src/client.rs
index 29c5979..f58b51f 100644
--- a/credentialsd-ui/src/client.rs
+++ b/credentialsd-ui/src/client.rs
@@ -10,6 +10,9 @@ use credentialsd_common::{
 
 const CTAP_CLIENT_SECRET_MAX_LEN: usize = 63;
 
+/// Upper bound for a platform provider password. Providers may accept less.
+const PASSWORD_MAX_LEN: usize = 1024;
+
 #[derive(Debug)]
 pub struct FlowControlClient {
     pub tx: Sender<UserInteractedEvent>,
@@ -58,6 +61,23 @@ impl FlowControlClient {
             .map_err(|_| None)
     }
 
+    pub async fn enter_password(&mut self, password: String) -> Result<(), ()> {
+        if password.is_empty() || password.len() > PASSWORD_MAX_LEN {
+            tracing::error!("Password is empty or too long");
+            return Err(());
+        }
+        let fd = match write_secret(password.into_bytes()) {
+            Ok(fd) => fd,
+            Err(err) => {
+                tracing::error!(%err, "Failed to write secret to file descriptor");
+                _ = self.cancel_request().await;
+                return Err(());
+            }
+        };
+        self.send(UserInteractedEvent::PasswordEntered(fd.into()))
+            .await
+    }
+
     pub async fn select_credential(&self, credential_id: String) -> Result<(), ()> {
         self.send(UserInteractedEvent::CredentialSelected(credential_id))
             .await

new file mode 100644
index 0000000..07b6bc5
--- /dev/null
+++ b/credentialsd/src/credential_service/platform/mod.rs
@@ -0,0 +1,416 @@
+//! Platform passkey providers.
+//!
+//! A platform provider is a separate process that holds passkeys for the
+//! local machine (transport `internal`), for example an authenticator backed
+//! by a TPM or a secure element. Providers register through drop-in files
+//! (see [`config`]) and implement a small D-Bus interface (see [`dbus`]).
+
+pub mod config;
+pub mod dbus;
+
+use std::{
+    collections::HashMap,
+    fmt::{Debug, Display},
+    sync::{Arc, RwLock},
+    time::Duration,
+};
+
+use async_trait::async_trait;
+use zbus::{
+    Connection,
+    zvariant::{OwnedValue, Value},
+};
+
+use credentialsd_common::model::{Device, Transport};
+
+use self::{config::ProviderConfig, dbus::DbusPlatformProvider};
+
+/// How long credentialsd waits for a provider to answer `GetInfo` before it
+/// leaves the provider out of the device list.
+const GET_INFO_TIMEOUT: Duration = Duration::from_secs(2);
+
+/// Errors reported by a platform provider.
+///
+/// Providers report errors as D-Bus errors. The last component of the error
+/// name selects the variant, so `org.example.Error.WrongPassword` and
+/// `xyz.iinuwa.credentialsd.Provider.Error.WrongPassword` both map to
+/// [`ProviderError::WrongPassword`].
+#[derive(Clone, Debug, PartialEq)]
+pub enum ProviderError {
+    /// The user declined or the provider refused the operation.
+    NotAllowed(String),
+    /// A credential in the exclude list already exists on the provider.
+    InvalidState,
+    /// None of the requested algorithms or options is supported.
+    NotSupported,
+    /// The provider rejected the RP ID for the origin.
+    Security,
+    /// The operation was cancelled.
+    Aborted,
+    /// The provider needs the user's password before it can continue.
+    PasswordNeeded,
+    /// The provider rejected the password it was given.
+    WrongPassword,
+    /// The provider is locked until the user unlocks it.
+    Locked,
+    /// The provider could not be reached or is not trusted.
+    Unavailable(String),
+    /// The provider sent a reply that could not be understood.
+    InvalidResponse(String),
+    /// Any other error.
+    Unknown(String),
+}
+
+impl ProviderError {
+    /// Maps a D-Bus error name and message to a provider error.
+    pub fn from_dbus_error(name: &str, message: Option<&str>) -> Self {
+        let message = message.unwrap_or_default().to_string();
+        match name.rsplit('.').next().unwrap_or(name) {
+            "NotAllowedError" => Self::NotAllowed(message),
+            "InvalidStateError" => Self::InvalidState,
+            "NotSupportedError" => Self::NotSupported,
+            "SecurityError" => Self::Security,
+            "AbortError" => Self::Aborted,
+            "PasswordNeeded" => Self::PasswordNeeded,
+            "WrongPassword" => Self::WrongPassword,
+            "Locked" => Self::Locked,
+            _ if name.starts_with("org.freedesktop.DBus.Error.") => {
+                Self::Unavailable(format!("{name}: {message}"))
+            }
+            _ => Self::Unknown(format!("{name}: {message}")),
+        }
+    }
+}
+
+impl Display for ProviderError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::NotAllowed(msg) => write!(f, "NotAllowedError: {msg}"),
+            Self::InvalidState => f.write_str("InvalidStateError"),
+            Self::NotSupported => f.write_str("NotSupportedError"),
+            Self::Security => f.write_str("SecurityError"),
+            Self::Aborted => f.write_str("AbortError"),
+            Self::PasswordNeeded => f.write_str("PasswordNeeded"),
+            Self::WrongPassword => f.write_str("WrongPassword"),
+            Self::Locked => f.write_str("Locked"),
+            Self::Unavailable(msg) => write!(f, "provider unavailable: {msg}"),
+            Self::InvalidResponse(msg) => write!(f, "invalid provider response: {msg}"),
+            Self::Unknown(msg) => write!(f, "provider error: {msg}"),
+        }
+    }
+}
+
+impl std::error::Error for ProviderError {}
+
+/// The answer to a provider's `GetInfo()` call.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ProviderInfo {
+    /// Display name reported by the provider, if any.
+    pub name: Option<String>,
+    pub aaguid: Option<Vec<u8>>,
+    /// COSE algorithm identifiers the provider can create credentials for.
+    pub algorithms: Vec<i64>,
+    /// User verification methods, for example `biometric` or `password`.
+    pub user_verification: Vec<String>,
+    /// WebAuthn extension identifiers the provider supports.
+    pub extensions: Vec<String>,
+    /// Whether the provider is locked and cannot be used right now.
+    pub locked: bool,
+}
+
+impl ProviderInfo {
+    pub(crate) fn from_dict(dict: &HashMap<String, OwnedValue>) -> Self {
+        Self {
+            name: dict.get("name").and_then(|v| value_to_string(v)),
+            aaguid: dict.get("aaguid").and_then(|v| value_to_bytes(v)),
+            algorithms: dict
+                .get("algorithms")
+                .and_then(|v| value_to_ints(v))
+                .unwrap_or_default(),
+            user_verification: dict
+                .get("uv")
+                .and_then(|v| value_to_strings(v))
+                .unwrap_or_default(),
+            extensions: dict
+                .get("extensions")
+                .and_then(|v| value_to_strings(v))
+                .unwrap_or_default(),
+            locked: dict
+                .get("locked")
+                .and_then(|v| value_to_bool(v))
+                .unwrap_or(false),
+        }
+    }
+}
+
+/// A platform passkey provider.
+#[async_trait]
+pub trait PlatformProvider: Debug + Send + Sync {
+    /// Stable identifier, taken from the provider's drop-in file name.
+    fn id(&self) -> &str;
+
+    /// Returns what the provider supports and whether it is locked. This must
+    /// be cheap and must not prompt the user.
+    async fn get_info(&self) -> Result<ProviderInfo, ProviderError>;
+}
+
+/// The device ID under which a provider is offered to the user.
+pub fn device_id(provider_id: &str) -> String {
+    format!("internal:{provider_id}")
+}
+
+/// The set of platform providers known to the credential service.
+#[derive(Debug, Default)]
+pub struct PlatformProviders {
+    providers: RwLock<Vec<Arc<dyn PlatformProvider>>>,
+}
+
+impl PlatformProviders {
+    #[cfg(test)]
+    pub fn new(providers: Vec<Arc<dyn PlatformProvider>>) -> Self {
+        Self {
+            providers: RwLock::new(providers),
+        }
+    }
+
+    /// Replaces the provider list with the providers registered through
+    /// drop-in files. Calls go out over `conn`, so providers can check that
+    /// the caller owns credentialsd's bus name.
+    pub fn load_drop_ins(&self, conn: &Connection) {
+        let configs = config::load_provider_configs(&config::provider_dirs());
+        let providers: Vec<Arc<dyn PlatformProvider>> = configs
+            .into_iter()
+            .map(|config: ProviderConfig| {
+                tracing::info!(id = %config.id, name = %config.name, bus_name = %config.bus_name, "Found platform provider");
+                Arc::new(DbusPlatformProvider::new(conn.clone(), config)) as Arc<dyn PlatformProvider>
+            })
+            .collect();
+        *self.providers.write().unwrap() = providers;
+    }
+
+    pub fn all(&self) -> Vec<Arc<dyn PlatformProvider>> {
+        self.providers.read().unwrap().clone()
+    }
+
+    /// Asks every provider for its info and returns those that answered in
+    /// time.
+    pub async fn available(&self) -> Vec<(Arc<dyn PlatformProvider>, ProviderInfo)> {
+        let mut available = Vec::new();
+        for provider in self.all() {
+            match tokio::time::timeout(GET_INFO_TIMEOUT, provider.get_info()).await {
+                Ok(Ok(info)) => available.push((provider, info)),
+                Ok(Err(err)) => {
+                    tracing::warn!(id = provider.id(), %err, "Platform provider is not available")
+                }
+                Err(_) => {
+                    tracing::warn!(
+                        id = provider.id(),
+                        "Platform provider did not answer in time"
+                    )
+                }
+            }
+        }
+        available
+    }
+
+    /// The devices to offer the user for the available providers.
+    pub async fn devices(&self) -> Vec<Device> {
+        self.available()
+            .await
+            .into_iter()
+            .map(|(provider, _)| Device {
+                id: device_id(provider.id()),
+                transport: Transport::Internal,
+            })
+            .collect()
+    }
+}
+
+pub(crate) fn value_to_bool(value: &Value<'_>) -> Option<bool> {
+    match value {
+        Value::Bool(b) => Some(*b),
+        Value::Value(inner) => value_to_bool(inner),
+        _ => None,
+    }
+}
+
+/// Accepts any D-Bus integer type, since providers written in different
+/// languages pick different ones.
+pub(crate) fn value_to_int(value: &Value<'_>) -> Option<i64> {
+    match value {
+        Value::U8(n) => Some(i64::from(*n)),
+        Value::I16(n) => Some(i64::from(*n)),
+        Value::U16(n) => Some(i64::from(*n)),
+        Value::I32(n) => Some(i64::from(*n)),
+        Value::U32(n) => Some(i64::from(*n)),
+        Value::I64(n) => Some(*n),
+        Value::U64(n) => i64::try_from(*n).ok(),
+        Value::Value(inner) => value_to_int(inner),
+        _ => None,
+    }
+}
+
+pub(crate) fn value_to_string(value: &Value<'_>) -> Option<String> {
+    match value {
+        Value::Str(s) => Some(s.as_str().to_string()),
+        Value::Value(inner) => value_to_string(inner),
+        _ => None,
+    }
+}
+
+pub(crate) fn value_to_bytes(value: &Value<'_>) -> Option<Vec<u8>> {
+    match value {
+        Value::Array(array) => array
+            .iter()
+            .map(|v| match v {
+                Value::U8(b) => Some(*b),
+                _ => None,
+            })
+            .collect(),
+        Value::Value(inner) => value_to_bytes(inner),
+        _ => None,
+    }
+}
+
+pub(crate) fn value_to_strings(value: &Value<'_>) -> Option<Vec<String>> {
+    match value {
+        Value::Array(array) => array.iter().map(value_to_string).collect(),
+        Value::Value(inner) => value_to_strings(inner),
+        _ => None,
+    }
+}
+
+pub(crate) fn value_to_ints(value: &Value<'_>) -> Option<Vec<i64>> {
+    match value {
+        Value::Array(array) => array.iter().map(value_to_int).collect(),
+        Value::Value(inner) => value_to_ints(inner),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use super::*;
+
+    fn owned<'a>(value: impl Into<Value<'a>>) -> OwnedValue {
+        OwnedValue::try_from(value.into()).unwrap()
+    }
+
+    #[test]
+    fn error_names_map_by_last_component() {
+        assert_eq!(
+            ProviderError::from_dbus_error("org.example.Error.WrongPassword", None),
+            ProviderError::WrongPassword
+        );
+        assert_eq!(
+            ProviderError::from_dbus_error(
+                "xyz.iinuwa.credentialsd.Provider.Error.PasswordNeeded",
+                None
+            ),
+            ProviderError::PasswordNeeded
+        );
+        assert_eq!(
+            ProviderError::from_dbus_error("org.example.Error.Locked", Some("log in")),
+            ProviderError::Locked
+        );
+        assert_eq!(
+            ProviderError::from_dbus_error("org.example.Error.NotAllowedError", Some("no")),
+            ProviderError::NotAllowed("no".to_string())
+        );
+        assert_eq!(
+            ProviderError::from_dbus_error("org.example.Error.InvalidStateError", None),
+            ProviderError::InvalidState
+        );
+        assert!(matches!(
+            ProviderError::from_dbus_error("org.freedesktop.DBus.Error.ServiceUnknown", None),
+            ProviderError::Unavailable(_)
+        ));
+        assert!(matches!(
+            ProviderError::from_dbus_error("org.example.Error.Weird", None),
+            ProviderError::Unknown(_)
+        ));
+    }
+
+    #[test]
+    fn info_accepts_any_integer_type() {
+        let dict = HashMap::from([
+            ("name".to_string(), owned("Example")),
+            ("aaguid".to_string(), owned(vec![1u8; 16])),
+            ("algorithms".to_string(), owned(vec![-7i64, -8i64])),
+            ("uv".to_string(), owned(vec!["biometric", "password"])),
+            ("extensions".to_string(), owned(vec!["credProtect"])),
+            ("locked".to_string(), owned(true)),
+            ("rk_remaining".to_string(), owned(25u32)),
+        ]);
+        let info = ProviderInfo::from_dict(&dict);
+        assert_eq!(
+            info,
+            ProviderInfo {
+                name: Some("Example".to_string()),
+                aaguid: Some(vec![1u8; 16]),
+                algorithms: vec![-7, -8],
+                user_verification: vec!["biometric".to_string(), "password".to_string()],
+                extensions: vec!["credProtect".to_string()],
+                locked: true,
+            }
+        );
+
+        let dict = HashMap::from([("algorithms".to_string(), owned(vec![-7i32]))]);
+        let info = ProviderInfo::from_dict(&dict);
+        assert_eq!(info.algorithms, vec![-7]);
+        assert!(!info.locked);
+    }
+
+    /// A provider that answers `GetInfo` from a fixed value.
+    #[derive(Debug)]
+    pub(crate) struct StaticProvider {
+        pub id: String,
+        pub info: Result<ProviderInfo, ProviderError>,
+    }
+
+    #[async_trait]
+    impl PlatformProvider for StaticProvider {
+        fn id(&self) -> &str {
+            &self.id
+        }
+
+        async fn get_info(&self) -> Result<ProviderInfo, ProviderError> {
+            self.info.clone()
+        }
+    }
+
+    #[tokio::test]
+    async fn devices_skip_unreachable_providers_and_keep_locked_ones() {
+        let providers = PlatformProviders::new(vec![
+            Arc::new(StaticProvider {
+                id: "ok".to_string(),
+                info: Ok(ProviderInfo::default()),
+            }),
+            Arc::new(StaticProvider {
+                id: "gone".to_string(),
+                info: Err(ProviderError::Unavailable("no owner".to_string())),
+            }),
+            Arc::new(StaticProvider {
+                id: "locked".to_string(),
+                info: Ok(ProviderInfo {
+                    locked: true,
+                    ..Default::default()
+                }),
+            }),
+        ]);
+        let devices = providers.devices().await;
+        assert_eq!(
+            devices,
+            vec![
+                Device {
+                    id: "internal:ok".to_string(),
+                    transport: Transport::Internal,
+                },
+                Device {
+                    id: "internal:locked".to_string(),
+                    transport: Transport::Internal,
+                },
+            ]
+        );
+    }
+}

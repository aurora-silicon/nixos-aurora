new file mode 100644
index 0000000..38fbb07
--- /dev/null
+++ b/credentialsd/src/credential_service/platform/dbus.rs
@@ -0,0 +1,124 @@
+//! Client for platform providers that implement the provider D-Bus interface.
+
+use std::collections::HashMap;
+
+use async_trait::async_trait;
+use serde::Serialize;
+use zbus::{
+    Connection,
+    fdo::{self, DBusProxy},
+    names::{BusName, WellKnownName},
+    proxy::CacheProperties,
+    zvariant::{DynamicDeserialize, DynamicType, OwnedValue},
+};
+
+use super::{PlatformProvider, ProviderError, ProviderInfo, config::ProviderConfig};
+
+/// A platform provider reached over D-Bus.
+#[derive(Debug)]
+pub struct DbusPlatformProvider {
+    conn: Connection,
+    config: ProviderConfig,
+}
+
+impl DbusPlatformProvider {
+    pub fn new(conn: Connection, config: ProviderConfig) -> Self {
+        Self { conn, config }
+    }
+
+    async fn proxy(&self) -> Result<zbus::Proxy<'static>, ProviderError> {
+        zbus::proxy::Builder::new(&self.conn)
+            .destination(self.config.bus_name.clone())
+            .and_then(|b| b.path(self.config.object_path.clone()))
+            .and_then(|b| b.interface(self.config.interface.clone()))
+            .map(|b| b.cache_properties(CacheProperties::No))
+            .map_err(|err| ProviderError::Unavailable(err.to_string()))?
+            .build()
+            .await
+            .map_err(|err| ProviderError::Unavailable(err.to_string()))
+    }
+
+    /// If the drop-in file names an executable, checks that the current owner
+    /// of the provider's bus name runs it. This keeps another process in the
+    /// session from claiming the name first and receiving requests.
+    async fn check_owner(&self) -> Result<(), ProviderError> {
+        let Some(expected) = &self.config.executable else {
+            return Ok(());
+        };
+        let unavailable = |err: fdo::Error| ProviderError::Unavailable(err.to_string());
+        let dbus = DBusProxy::new(&self.conn)
+            .await
+            .map_err(|err| ProviderError::Unavailable(err.to_string()))?;
+        let name = WellKnownName::try_from(self.config.bus_name.as_str())
+            .map_err(|err| ProviderError::Unavailable(err.to_string()))?;
+        let owner = match dbus.get_name_owner(BusName::from(name.clone())).await {
+            Ok(owner) => owner,
+            Err(fdo::Error::NameHasNoOwner(_)) => {
+                dbus.start_service_by_name(name.clone(), 0)
+                    .await
+                    .map_err(unavailable)?;
+                dbus.get_name_owner(BusName::from(name))
+                    .await
+                    .map_err(unavailable)?
+            }
+            Err(err) => return Err(unavailable(err)),
+        };
+        let credentials = dbus
+            .get_connection_credentials(BusName::from(owner))
+            .await
+            .map_err(unavailable)?;
+        let pid = credentials.process_id().ok_or_else(|| {
+            ProviderError::Unavailable("provider process ID is unknown".to_string())
+        })?;
+        let exe = tokio::fs::read_link(format!("/proc/{pid}/exe"))
+            .await
+            .map_err(|err| ProviderError::Unavailable(err.to_string()))?;
+        if &exe != expected {
+            tracing::warn!(
+                id = %self.config.id,
+                ?exe,
+                ?expected,
+                "Platform provider bus name is owned by an unexpected executable"
+            );
+            return Err(ProviderError::Unavailable(
+                "provider bus name is owned by an unexpected executable".to_string(),
+            ));
+        }
+        Ok(())
+    }
+
+    async fn call<B, R>(&self, method: &str, body: &B) -> Result<R, ProviderError>
+    where
+        B: Serialize + DynamicType,
+        R: for<'d> DynamicDeserialize<'d>,
+    {
+        self.check_owner().await?;
+        let proxy = self.proxy().await?;
+        let reply = proxy
+            .call_method(method, body)
+            .await
+            .map_err(|err| match err {
+                zbus::Error::MethodError(name, message, _) => {
+                    ProviderError::from_dbus_error(name.as_str(), message.as_deref())
+                }
+                zbus::Error::FDO(err) => ProviderError::Unavailable(err.to_string()),
+                err => ProviderError::Unavailable(err.to_string()),
+            })?;
+        reply
+            .body()
+            .deserialize::<R>()
+            .map_err(|err| ProviderError::InvalidResponse(format!("{method}: {err}")))
+    }
+}
+
+#[async_trait]
+impl PlatformProvider for DbusPlatformProvider {
+    fn id(&self) -> &str {
+        &self.config.id
+    }
+
+    async fn get_info(&self) -> Result<ProviderInfo, ProviderError> {
+        let dict: HashMap<String, OwnedValue> = self.call("GetInfo", &()).await?;
+        Ok(ProviderInfo::from_dict(&dict))
+    }
+}

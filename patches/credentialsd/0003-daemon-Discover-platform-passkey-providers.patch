diff --git a/credentialsd/src/credential_service/platform/config.rs b/credentialsd/src/credential_service/platform/config.rs
new file mode 100644
index 0000000..adf59d1
--- /dev/null
+++ b/credentialsd/src/credential_service/platform/config.rs
@@ -0,0 +1,375 @@
+//! Drop-in files that register platform passkey providers.
+//!
+//! A provider is registered by a file named `<id>.conf` in one of the provider
+//! directories:
+//!
+//! ```ini
+//! [Provider]
+//! Name=Example Platform Authenticator
+//! BusName=org.example.Passkeys1
+//! ObjectPath=/org/example/Passkeys1
+//! # Optional. Defaults to xyz.iinuwa.credentialsd.Provider1.
+//! Interface=org.example.Passkeys.Provider1
+//! # Optional. When set, the owner of BusName must run this executable.
+//! Executable=/usr/libexec/example-passkeyd
+//! # Optional. The only supported value is "internal".
+//! Transport=internal
+//! ```
+//!
+//! Directories are searched in order. The first file for an ID wins, so a file
+//! in `/etc` overrides one in `/usr/share`, and an empty file masks it.
+
+use std::{
+    collections::HashSet,
+    fmt::Display,
+    path::{Path, PathBuf},
+};
+
+use zbus::{
+    names::{InterfaceName, WellKnownName},
+    zvariant::ObjectPath,
+};
+
+/// The provider interface name used when a drop-in file does not set one.
+pub const DEFAULT_PROVIDER_INTERFACE: &str = "xyz.iinuwa.credentialsd.Provider1";
+
+const SECTION: &str = "Provider";
+
+/// System directories searched for provider drop-in files, highest priority
+/// first.
+const SYSTEM_PROVIDER_DIRS: [&str; 3] = [
+    "/etc/credentialsd/providers",
+    "/usr/local/share/credentialsd/providers",
+    "/usr/share/credentialsd/providers",
+];
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ProviderConfig {
+    /// File stem of the drop-in file. Used as a stable device ID.
+    pub id: String,
+    /// Human-readable name of the provider.
+    pub name: String,
+    pub bus_name: String,
+    pub object_path: String,
+    pub interface: String,
+    /// When set, credentialsd only talks to the owner of `bus_name` if that
+    /// process runs this executable.
+    pub executable: Option<PathBuf>,
+}
+
+#[derive(Debug, PartialEq)]
+pub enum ConfigError {
+    InvalidId(String),
+    Syntax { line: usize, message: String },
+    Missing(&'static str),
+    Invalid { key: &'static str, message: String },
+}
+
+impl Display for ConfigError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::InvalidId(id) => write!(f, "invalid provider ID {id:?}"),
+            Self::Syntax { line, message } => write!(f, "line {line}: {message}"),
+            Self::Missing(key) => write!(f, "missing required key {key}"),
+            Self::Invalid { key, message } => write!(f, "invalid value for {key}: {message}"),
+        }
+    }
+}
+
+impl std::error::Error for ConfigError {}
+
+fn is_valid_id(id: &str) -> bool {
+    !id.is_empty()
+        && id
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '-' | '_'))
+}
+
+/// Parses the contents of a provider drop-in file.
+pub fn parse_provider_config(id: &str, contents: &str) -> Result<ProviderConfig, ConfigError> {
+    if !is_valid_id(id) {
+        return Err(ConfigError::InvalidId(id.to_string()));
+    }
+
+    let mut section: Option<&str> = None;
+    let mut name = None;
+    let mut bus_name = None;
+    let mut object_path = None;
+    let mut interface = None;
+    let mut executable = None;
+
+    for (idx, raw_line) in contents.lines().enumerate() {
+        let line_number = idx + 1;
+        let line = raw_line.trim();
+        if line.is_empty() || line.starts_with('#') || line.starts_with(';') {
+            continue;
+        }
+        if let Some(header) = line.strip_prefix('[') {
+            let Some(header) = header.strip_suffix(']') else {
+                return Err(ConfigError::Syntax {
+                    line: line_number,
+                    message: "unterminated section header".to_string(),
+                });
+            };
+            section = Some(header.trim());
+            continue;
+        }
+        let Some((key, value)) = line.split_once('=') else {
+            return Err(ConfigError::Syntax {
+                line: line_number,
+                message: "expected `Key=Value`".to_string(),
+            });
+        };
+        match section {
+            None => {
+                return Err(ConfigError::Syntax {
+                    line: line_number,
+                    message: "key outside of a section".to_string(),
+                });
+            }
+            Some(SECTION) => {}
+            // Other sections are reserved for future use.
+            Some(_) => continue,
+        }
+        let value = value.trim().to_string();
+        match key.trim() {
+            "Name" => name = Some(value),
+            "BusName" => bus_name = Some(value),
+            "ObjectPath" => object_path = Some(value),
+            "Interface" => interface = Some(value),
+            "Executable" => executable = Some(PathBuf::from(value)),
+            "Transport" => {
+                if !value.eq_ignore_ascii_case("internal") {
+                    return Err(ConfigError::Invalid {
+                        key: "Transport",
+                        message: format!("unsupported transport {value:?}"),
+                    });
+                }
+            }
+            other => tracing::debug!(id, key = other, "Ignoring unknown provider key"),
+        }
+    }
+
+    let name = name.ok_or(ConfigError::Missing("Name"))?;
+    let bus_name = bus_name.ok_or(ConfigError::Missing("BusName"))?;
+    let object_path = object_path.ok_or(ConfigError::Missing("ObjectPath"))?;
+    let interface = interface.unwrap_or_else(|| DEFAULT_PROVIDER_INTERFACE.to_string());
+
+    WellKnownName::try_from(bus_name.as_str()).map_err(|err| ConfigError::Invalid {
+        key: "BusName",
+        message: err.to_string(),
+    })?;
+    ObjectPath::try_from(object_path.as_str()).map_err(|err| ConfigError::Invalid {
+        key: "ObjectPath",
+        message: err.to_string(),
+    })?;
+    InterfaceName::try_from(interface.as_str()).map_err(|err| ConfigError::Invalid {
+        key: "Interface",
+        message: err.to_string(),
+    })?;
+    if let Some(executable) = &executable
+        && !executable.is_absolute()
+    {
+        return Err(ConfigError::Invalid {
+            key: "Executable",
+            message: "path must be absolute".to_string(),
+        });
+    }
+
+    Ok(ProviderConfig {
+        id: id.to_string(),
+        name,
+        bus_name,
+        object_path,
+        interface,
+        executable,
+    })
+}
+
+/// The directories searched for provider drop-in files, highest priority
+/// first.
+///
+/// Debug builds also search the colon-separated directories in
+/// `CREDSD_PROVIDER_DIRS` first, for development and testing.
+pub fn provider_dirs() -> Vec<PathBuf> {
+    let mut dirs = Vec::new();
+    if cfg!(debug_assertions) {
+        let custom = std::env::var("CREDSD_PROVIDER_DIRS").unwrap_or_default();
+        dirs.extend(
+            custom
+                .split(':')
+                .filter(|dir| !dir.is_empty())
+                .map(PathBuf::from),
+        );
+    }
+    dirs.extend(SYSTEM_PROVIDER_DIRS.iter().map(PathBuf::from));
+    dirs
+}
+
+/// Loads all provider drop-in files from `dirs`, highest priority first.
+///
+/// Files that fail to parse are skipped with a warning.
+pub fn load_provider_configs(dirs: &[PathBuf]) -> Vec<ProviderConfig> {
+    let mut seen = HashSet::new();
+    let mut configs = Vec::new();
+    for dir in dirs {
+        let mut files: Vec<PathBuf> = match std::fs::read_dir(dir) {
+            Ok(entries) => entries
+                .filter_map(|entry| entry.ok().map(|e| e.path()))
+                .filter(|path| path.extension().is_some_and(|ext| ext == "conf"))
+                .collect(),
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => continue,
+            Err(err) => {
+                tracing::warn!(?dir, %err, "Cannot read provider directory");
+                continue;
+            }
+        };
+        files.sort();
+        for path in files {
+            let Some(id) = path.file_stem().and_then(|s| s.to_str()) else {
+                continue;
+            };
+            if !seen.insert(id.to_string()) {
+                tracing::debug!(?path, "Provider overridden by a higher priority file");
+                continue;
+            }
+            match load_file(id, &path) {
+                Ok(Some(config)) => configs.push(config),
+                Ok(None) => tracing::debug!(?path, "Provider masked by an empty file"),
+                Err(err) => tracing::warn!(?path, %err, "Ignoring invalid provider file"),
+            }
+        }
+    }
+    configs
+}
+
+fn load_file(id: &str, path: &Path) -> Result<Option<ProviderConfig>, Box<dyn std::error::Error>> {
+    let contents = std::fs::read_to_string(path)?;
+    if contents.trim().is_empty() {
+        return Ok(None);
+    }
+    Ok(Some(parse_provider_config(id, &contents)?))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const EXAMPLE: &str = "
+# A comment
+[Provider]
+Name=Example Authenticator
+BusName=org.example.Passkeys1
+ObjectPath=/org/example/Passkeys1
+Transport=internal
+";
+
+    #[test]
+    fn parses_minimal_file_with_default_interface() {
+        let config = parse_provider_config("example", EXAMPLE).unwrap();
+        assert_eq!(
+            config,
+            ProviderConfig {
+                id: "example".to_string(),
+                name: "Example Authenticator".to_string(),
+                bus_name: "org.example.Passkeys1".to_string(),
+                object_path: "/org/example/Passkeys1".to_string(),
+                interface: DEFAULT_PROVIDER_INTERFACE.to_string(),
+                executable: None,
+            }
+        );
+    }
+
+    #[test]
+    fn parses_optional_keys_and_ignores_unknown_ones() {
+        let contents = format!(
+            "{EXAMPLE}Interface=org.example.Passkeys.Provider1\nExecutable=/usr/libexec/example\nIcon=example\n[X-Vendor]\nFoo=bar\n"
+        );
+        let config = parse_provider_config("example", &contents).unwrap();
+        assert_eq!(config.interface, "org.example.Passkeys.Provider1");
+        assert_eq!(
+            config.executable.as_deref(),
+            Some(Path::new("/usr/libexec/example"))
+        );
+    }
+
+    #[test]
+    fn rejects_missing_keys() {
+        let contents = "[Provider]\nName=Example\nBusName=org.example.Passkeys1\n";
+        assert_eq!(
+            parse_provider_config("example", contents),
+            Err(ConfigError::Missing("ObjectPath"))
+        );
+    }
+
+    #[test]
+    fn rejects_invalid_values() {
+        let bad_bus = EXAMPLE.replace("org.example.Passkeys1", ":1.42");
+        assert!(matches!(
+            parse_provider_config("example", &bad_bus),
+            Err(ConfigError::Invalid { key: "BusName", .. })
+        ));
+        let bad_transport = EXAMPLE.replace("internal", "usb");
+        assert!(matches!(
+            parse_provider_config("example", &bad_transport),
+            Err(ConfigError::Invalid {
+                key: "Transport",
+                ..
+            })
+        ));
+        let relative_exe = format!("{EXAMPLE}Executable=bin/example\n");
+        assert!(matches!(
+            parse_provider_config("example", &relative_exe),
+            Err(ConfigError::Invalid {
+                key: "Executable",
+                ..
+            })
+        ));
+        assert_eq!(
+            parse_provider_config("../evil", EXAMPLE),
+            Err(ConfigError::InvalidId("../evil".to_string()))
+        );
+    }
+
+    #[test]
+    fn rejects_keys_outside_a_section() {
+        assert!(matches!(
+            parse_provider_config("example", "Name=Example\n"),
+            Err(ConfigError::Syntax { line: 1, .. })
+        ));
+    }
+
+    #[test]
+    fn earlier_directories_override_and_empty_files_mask() {
+        let base = std::env::temp_dir().join(format!(
+            "credentialsd-provider-test-{}-{}",
+            std::process::id(),
+            rand::random::<u32>()
+        ));
+        let high = base.join("etc");
+        let low = base.join("usr");
+        std::fs::create_dir_all(&high).unwrap();
+        std::fs::create_dir_all(&low).unwrap();
+
+        let overridden = EXAMPLE.replace("Example Authenticator", "Override");
+        std::fs::write(high.join("a.conf"), overridden).unwrap();
+        std::fs::write(low.join("a.conf"), EXAMPLE).unwrap();
+        std::fs::write(high.join("b.conf"), "").unwrap();
+        std::fs::write(low.join("b.conf"), EXAMPLE).unwrap();
+        std::fs::write(low.join("c.conf"), EXAMPLE).unwrap();
+        std::fs::write(low.join("d.conf"), "not a provider").unwrap();
+        std::fs::write(low.join("e.txt"), EXAMPLE).unwrap();
+
+        let configs = load_provider_configs(&[high, low, base.join("missing")]);
+        std::fs::remove_dir_all(&base).unwrap();
+
+        let ids_and_names: Vec<(&str, &str)> = configs
+            .iter()
+            .map(|c| (c.id.as_str(), c.name.as_str()))
+            .collect();
+        assert_eq!(
+            ids_and_names,
+            vec![("a", "Override"), ("c", "Example Authenticator")]
+        );
+    }
+}

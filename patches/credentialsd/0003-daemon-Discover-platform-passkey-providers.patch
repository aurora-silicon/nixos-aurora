+/// Whether a request may be served by a platform authenticator. Requests that
+/// ask for a cross-platform (roaming) authenticator may not.
+fn request_allows_platform(request: &CredentialRequest) -> bool {
+    match request {
+        CredentialRequest::CreatePublicKeyCredentialRequest(r) => !matches!(
+            r.authenticator_attachment,
+            Some(libwebauthn::ops::webauthn::AuthenticatorAttachment::CrossPlatform)
+        ),
+        CredentialRequest::GetPublicKeyCredentialRequest(_) => true,
+    }
+}

+<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
+<!--
+  Interface implemented by platform passkey providers. See the Platform
+  Provider API section in doc/api.md for the dictionary keys and errors.
+  Providers may implement it under another name, set with Interface= in
+  their drop-in file.
+-->
+<node>
+  <interface name="xyz.iinuwa.credentialsd.Provider1">
+    <method name="GetInfo">
+      <arg name="info" type="a{sv}" direction="out"/>
+    </method>
+    <method name="ListCredentials">
+      <arg name="rp_id" type="s" direction="in"/>
+      <arg name="allow" type="aay" direction="in"/>
+      <arg name="credentials" type="aa{sv}" direction="out"/>
+    </method>
+    <method name="MakeCredential">
+      <arg name="request_id" type="u" direction="in"/>
+      <arg name="client_data_hash" type="ay" direction="in"/>
+      <arg name="rp" type="a{sv}" direction="in"/>
+      <arg name="user" type="a{sv}" direction="in"/>
+      <arg name="algorithms" type="ai" direction="in"/>
+      <arg name="exclude" type="aay" direction="in"/>
+      <arg name="options" type="a{sv}" direction="in"/>
+      <arg name="result" type="a{sv}" direction="out"/>
+    </method>
+    <method name="GetAssertion">
+      <arg name="request_id" type="u" direction="in"/>
+      <arg name="client_data_hash" type="ay" direction="in"/>
+      <arg name="rp_id" type="s" direction="in"/>
+      <arg name="credential_id" type="ay" direction="in"/>
+      <arg name="options" type="a{sv}" direction="in"/>
+      <arg name="result" type="a{sv}" direction="out"/>
+    </method>
+    <method name="Cancel">
+      <arg name="request_id" type="u" direction="in"/>
+    </method>
+    <signal name="UserActionNeeded">
+      <arg name="request_id" type="u"/>
+      <arg name="kind" type="s"/>
+      <arg name="details" type="a{sv}"/>
+    </signal>
+  </interface>
+</node>

+    async fn list_credentials(
+        &self,
+        rp_id: &str,
+        allow: &[Vec<u8>],
+    ) -> Result<Vec<ProviderCredential>, ProviderError> {
+        let creds: Vec<Dict> = self.call("ListCredentials", &(rp_id, allow)).await?;
+        Ok(creds
+            .iter()
+            .filter_map(ProviderCredential::from_dict)
+            .collect())
+    }
+
+    async fn make_credential(
+        &self,
+        request_id: u32,
+        args: &ProviderMakeCredential,
+        password: Option<OwnedFd>,
+    ) -> Result<ProviderAttestation, ProviderError> {
+        let mut rp: HashMap<&str, Value> =
+            HashMap::from([("id", Value::from(args.rp_id.as_str()))]);
+        if let Some(name) = &args.rp_name {
+            rp.insert("name", Value::from(name.as_str()));
+        }
+        // The rp and user dictionaries use the member names of WebAuthn's
+        // PublicKeyCredentialRpEntity and PublicKeyCredentialUserEntity.
+        let mut user: HashMap<&str, Value> =
+            HashMap::from([("id", Value::from(args.user_id.clone()))]);
+        if let Some(name) = &args.user_name {
+            user.insert("name", Value::from(name.as_str()));
+        }
+        if let Some(display_name) = &args.user_display_name {
+            user.insert("displayName", Value::from(display_name.as_str()));
+        }
+        let mut options = request_options(
+            &args.origin,
+            args.top_origin.as_deref(),
+            args.user_verification,
+            password,
+        );
+        options.insert("rk", Value::from(args.resident_key));
+
+        let reply: Dict = self
+            .call(
+                "MakeCredential",
+                &(
+                    request_id,
+                    args.client_data_hash.as_slice(),
+                    rp,
+                    user,
+                    args.algorithms.as_slice(),
+                    args.exclude.as_slice(),
+                    options,
+                ),
+            )
+            .await?;
+        Ok(ProviderAttestation {
+            attestation_object: reply
+                .get("attestation_object")
+                .and_then(|v| value_to_bytes(v))
+                .ok_or_else(|| {
+                    ProviderError::InvalidResponse("missing attestation_object".to_string())
+                })?,
+            transports: reply
+                .get("transports")
+                .and_then(|v| value_to_strings(v))
+                .unwrap_or_default(),
+        })
+    }
+
+    async fn get_assertion(
+        &self,
+        request_id: u32,
+        args: &ProviderGetAssertion,
+        password: Option<OwnedFd>,
+    ) -> Result<ProviderAssertion, ProviderError> {
+        let options = request_options(
+            &args.origin,
+            args.top_origin.as_deref(),
+            args.user_verification,
+            password,
+        );
+        let reply: Dict = self
+            .call(
+                "GetAssertion",
+                &(
+                    request_id,
+                    args.client_data_hash.as_slice(),
+                    args.rp_id.as_str(),
+                    args.credential_id.as_slice(),
+                    options,
+                ),
+            )
+            .await?;
+        let bytes = |key: &str| reply.get(key).and_then(|v| value_to_bytes(v));
+        Ok(ProviderAssertion {
+            authenticator_data: bytes("authenticator_data").ok_or_else(|| {
+                ProviderError::InvalidResponse("missing authenticator_data".to_string())
+            })?,
+            signature: bytes("signature")
+                .ok_or_else(|| ProviderError::InvalidResponse("missing signature".to_string()))?,
+            user_handle: bytes("user_handle").unwrap_or_default(),
+        })
+    }
+
+    async fn cancel(&self, request_id: u32) {
+        if let Err(err) = self.call::<_, ()>("Cancel", &(request_id,)).await {
+            tracing::debug!(id = %self.config.id, %err, "Failed to cancel provider request");
+        }
+    }
+
+    async fn user_actions(&self) -> Result<UserActionStream, ProviderError> {
+        let proxy = self.proxy().await?;
+        let signals = proxy
+            .receive_signal("UserActionNeeded")
+            .await
+            .map_err(|err| ProviderError::Unavailable(err.to_string()))?;
+        Ok(Box::pin(signals.filter_map(|msg| {
+            let (request_id, kind, details) =
+                msg.body().deserialize::<(u32, String, Dict)>().ok()?;
+            let kind = match kind.as_str() {
+                "touch" => UserActionKind::Touch,
+                "presence" => UserActionKind::Presence,
+                _ => UserActionKind::Other(kind),
+            };
+            let retries = details
+                .get("retries")
+                .and_then(|v| value_to_int(v))
+                .and_then(|n| u32::try_from(n).ok());
+            Some(UserAction {
+                request_id,
+                kind,
+                retries,
+            })
+        })))
+    }
+}
+
+/// Options shared by MakeCredential and GetAssertion.
+fn request_options<'a>(
+    origin: &'a str,
+    top_origin: Option<&'a str>,
+    user_verification: &'static str,
+    password: Option<OwnedFd>,
+) -> HashMap<&'static str, Value<'a>> {
+    let mut options = HashMap::from([
+        ("origin", Value::from(origin)),
+        ("uv", Value::from(user_verification)),
+    ]);
+    if let Some(top_origin) = top_origin {
+        options.insert("top_origin", Value::from(top_origin));
+    }
+    if let Some(password) = password {
+        options.insert("password_fd", Value::from(Fd::from(password)));
+    }
+    options
+}

+#[cfg(test)]
+pub(crate) mod tests {
+    use std::{collections::VecDeque, io::Read, sync::Mutex, time::Duration};
+
+    use async_trait::async_trait;
+    use tokio::sync::broadcast;
+
+    use super::*;
+    use crate::credential_service::platform::{
+        ProviderAssertion, ProviderAttestation, ProviderGetAssertion, ProviderMakeCredential,
+        UserAction,
+        convert::tests::{
+            CREDENTIAL_ID, GET_JSON, MAKE_JSON, attestation_object, authenticator_data,
+            get_request, make_request,
+        },
+    };
+
+    /// What the mock provider does for one call.
+    #[derive(Clone, Debug)]
+    pub(crate) enum Step {
+        /// Emit a user action for the call, then answer with the result.
+        Reply(Vec<UserActionKind>, Result<(), ProviderError>),
+        /// Never answer.
+        Hang,
+    }
+
+    /// A provider that answers calls from a script and records what it
+    /// received.
+    #[derive(Debug)]
+    pub(crate) struct MockProvider {
+        pub info: ProviderInfo,
+        pub creds: Vec<ProviderCredential>,
+        pub steps: Mutex<VecDeque<Step>>,
+        pub passwords: Mutex<Vec<Option<String>>>,
+        pub assertion_ids: Mutex<Vec<Vec<u8>>>,
+        pub cancelled: Mutex<Vec<u32>>,
+        pub actions: broadcast::Sender<UserAction>,
+    }
+
+    impl MockProvider {
+        pub(crate) fn new(steps: Vec<Step>) -> Self {
+            Self {
+                info: ProviderInfo::default(),
+                creds: Vec::new(),
+                steps: Mutex::new(steps.into()),
+                passwords: Mutex::new(Vec::new()),
+                assertion_ids: Mutex::new(Vec::new()),
+                cancelled: Mutex::new(Vec::new()),
+                actions: broadcast::channel(16).0,
+            }
+        }
+
+        async fn step(
+            &self,
+            request_id: u32,
+            password: Option<OwnedFd>,
+        ) -> Result<(), ProviderError> {
+            let password = password.map(|fd| {
+                let mut s = String::new();
+                std::fs::File::from(fd).read_to_string(&mut s).unwrap();
+                s
+            });
+            self.passwords.lock().unwrap().push(password);
+            let step = self
+                .steps
+                .lock()
+                .unwrap()
+                .pop_front()
+                .expect("unexpected call");
+            match step {
+                Step::Reply(actions, result) => {
+                    for kind in actions {
+                        _ = self.actions.send(UserAction {
+                            request_id,
+                            kind,
+                            retries: Some(3),
+                        });
+                    }
+                    // Let the handler forward the actions before the reply.
+                    tokio::time::sleep(Duration::from_millis(20)).await;
+                    result
+                }
+                Step::Hang => std::future::pending().await,
+            }
+        }
+    }
+
+    #[async_trait]
+    impl PlatformProvider for MockProvider {
+        fn id(&self) -> &str {
+            "mock"
+        }
+
+        async fn get_info(&self) -> Result<ProviderInfo, ProviderError> {
+            Ok(self.info.clone())
+        }
+
+        async fn list_credentials(
+            &self,
+            _rp_id: &str,
+            _allow: &[Vec<u8>],
+        ) -> Result<Vec<ProviderCredential>, ProviderError> {
+            Ok(self.creds.clone())
+        }
+
+        async fn make_credential(
+            &self,
+            request_id: u32,
+            args: &ProviderMakeCredential,
+            password: Option<OwnedFd>,
+        ) -> Result<ProviderAttestation, ProviderError> {
+            self.step(request_id, password).await?;
+            Ok(ProviderAttestation {
+                attestation_object: attestation_object(&args.rp_id),
+                transports: vec!["internal".to_string()],
+            })
+        }
+
+        async fn get_assertion(
+            &self,
+            request_id: u32,
+            args: &ProviderGetAssertion,
+            password: Option<OwnedFd>,
+        ) -> Result<ProviderAssertion, ProviderError> {
+            self.assertion_ids
+                .lock()
+                .unwrap()
+                .push(args.credential_id.clone());
+            self.step(request_id, password).await?;
+            Ok(ProviderAssertion {
+                authenticator_data: authenticator_data(&args.rp_id, false),
+                signature: vec![0x30, 0x00],
+                user_handle: vec![],
+            })
+        }
+
+        async fn cancel(&self, request_id: u32) {
+            self.cancelled.lock().unwrap().push(request_id);
+        }
+
+        async fn user_actions(&self) -> Result<UserActionStream, ProviderError> {
+            let rx = self.actions.subscribe();
+            Ok(Box::pin(futures_lite::stream::unfold(
+                rx,
+                |mut rx| async move { rx.recv().await.ok().map(|action| (action, rx)) },
+            )))
+        }
+    }
+
+    pub(crate) fn pipe_with(secret: &[u8]) -> OwnedFd {
+        secret_pipe(secret).unwrap()
+    }
+
+    pub(crate) fn credential(id: &[u8], name: &str) -> ProviderCredential {
+        ProviderCredential {
+            id: id.to_vec(),
+            user_handle: b"user".to_vec(),
+            user_name: name.to_string(),
+            display_name: String::new(),
+        }
+    }
+
+    async fn create_request() -> CredentialRequest {
+        CredentialRequest::CreatePublicKeyCredentialRequest(make_request(MAKE_JSON).await)
+    }
+
+    async fn assertion_request() -> CredentialRequest {
+        CredentialRequest::GetPublicKeyCredentialRequest(get_request(GET_JSON).await)
+    }
+
+    fn start_with(
+        provider: Arc<MockProvider>,
+        request: CredentialRequest,
+        cancellation: CancellationToken,
+    ) -> impl Stream<Item = InternalEvent> + Send + Unpin + 'static {
+        let providers = Arc::new(PlatformProviders::new(vec![provider]));
+        start(providers, request, cancellation)
+    }
+
+    async fn next_state(
+        stream: &mut (impl Stream<Item = InternalEvent> + Unpin),
+    ) -> Option<InternalStateInternal> {
+        tokio::time::timeout(Duration::from_secs(5), stream.next())
+            .await
+            .expect("timed out waiting for a state")
+            .map(|event| event.state)
+    }
+
+    #[tokio::test]
+    async fn create_forwards_touch_and_completes() {
+        let provider = Arc::new(MockProvider::new(vec![Step::Reply(
+            vec![UserActionKind::Touch],
+            Ok(()),
+        )]));
+        let mut stream = start_with(
+            provider.clone(),
+            create_request().await,
+            CancellationToken::new(),
+        );
+        assert!(matches!(
+            next_state(&mut stream).await,
+            Some(InternalStateInternal::NeedsUserVerification {
+                attempts_left: Some(3)
+            })
+        ));
+        let Some(InternalStateInternal::Completed(response)) = next_state(&mut stream).await else {
+            panic!("expected completion");
+        };
+        let CredentialResponse::CreatePublicKeyCredentialResponse(response) = response else {
+            panic!("expected a create response");
+        };
+        assert_eq!(response.attachment_modality, "platform");
+        assert!(next_state(&mut stream).await.is_none());
+        assert_eq!(*provider.passwords.lock().unwrap(), vec![None]);
+    }
+
+    #[tokio::test]
+    async fn password_round_trip_retries_until_accepted() {
+        let provider = Arc::new(MockProvider::new(vec![
+            Step::Reply(vec![], Err(ProviderError::PasswordNeeded)),
+            Step::Reply(vec![], Err(ProviderError::WrongPassword)),
+            Step::Reply(vec![UserActionKind::Touch], Ok(())),
+        ]));
+        let mut stream = start_with(
+            provider.clone(),
+            create_request().await,
+            CancellationToken::new(),
+        );
+
+        let Some(InternalStateInternal::NeedsPassword {
+            incorrect: false,
+            password_tx,
+        }) = next_state(&mut stream).await
+        else {
+            panic!("expected a password prompt");
+        };
+        password_tx.send(b"wrong".to_vec()).await.unwrap();
+
+        let Some(InternalStateInternal::NeedsPassword {
+            incorrect: true,
+            password_tx,
+        }) = next_state(&mut stream).await
+        else {
+            panic!("expected a second password prompt");
+        };
+        password_tx.send(b"correct horse".to_vec()).await.unwrap();
+
+        assert!(matches!(
+            next_state(&mut stream).await,
+            Some(InternalStateInternal::NeedsUserVerification { .. })
+        ));
+        assert!(matches!(
+            next_state(&mut stream).await,
+            Some(InternalStateInternal::Completed(_))
+        ));
+        assert_eq!(
+            *provider.passwords.lock().unwrap(),
+            vec![
+                None,
+                Some("wrong".to_string()),
+                Some("correct horse".to_string())
+            ]
+        );
+    }
+
+    #[tokio::test]
+    async fn locked_provider_reports_locked_and_makes_no_call() {
+        let mut provider = MockProvider::new(vec![]);
+        provider.info.locked = true;
+        let provider = Arc::new(provider);
+        let mut stream = start_with(
+            provider.clone(),
+            create_request().await,
+            CancellationToken::new(),
+        );
+        assert!(matches!(
+            next_state(&mut stream).await,
+            Some(InternalStateInternal::Locked)
+        ));
+        assert!(next_state(&mut stream).await.is_none());
+        assert!(provider.passwords.lock().unwrap().is_empty());
+    }
+
+    #[tokio::test]
+    async fn locked_error_during_call_reports_locked() {
+        let provider = Arc::new(MockProvider::new(vec![Step::Reply(
+            vec![],
+            Err(ProviderError::Locked),
+        )]));
+        let mut stream = start_with(provider, create_request().await, CancellationToken::new());
+        assert!(matches!(
+            next_state(&mut stream).await,
+            Some(InternalStateInternal::Locked)
+        ));
+        assert!(next_state(&mut stream).await.is_none());
+    }
+
+    #[tokio::test]
+    async fn declined_request_ends_quietly() {
+        let provider = Arc::new(MockProvider::new(vec![Step::Reply(
+            vec![],
+            Err(ProviderError::NotAllowed("dismissed".to_string())),
+        )]));
+        let mut stream = start_with(provider, create_request().await, CancellationToken::new());
+        // Not ceremony-terminating: other transports stay available.
+        assert!(next_state(&mut stream).await.is_none());
+    }
+
+    #[tokio::test]
+    async fn excluded_credential_ends_the_ceremony() {
+        let provider = Arc::new(MockProvider::new(vec![Step::Reply(
+            vec![],
+            Err(ProviderError::InvalidState),
+        )]));
+        let mut stream = start_with(provider, create_request().await, CancellationToken::new());
+        assert!(matches!(
+            next_state(&mut stream).await,
+            Some(InternalStateInternal::Failed(
+                CredentialServiceError::CredentialExcluded
+            ))
+        ));
+    }
+
+    #[tokio::test]
+    async fn cancellation_cancels_the_provider_call() {
+        let provider = Arc::new(MockProvider::new(vec![Step::Hang]));
+        let cancellation = CancellationToken::new();
+        let mut stream = start_with(
+            provider.clone(),
+            create_request().await,
+            cancellation.clone(),
+        );
+        // Wait until the call is in flight.
+        for _ in 0..100 {
+            if !provider.passwords.lock().unwrap().is_empty() {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+        cancellation.cancel();
+        assert!(next_state(&mut stream).await.is_none());
+        assert_eq!(provider.cancelled.lock().unwrap().len(), 1);
+    }
+
+    #[tokio::test]
+    async fn get_without_matching_credentials_stays_silent() {
+        let provider = Arc::new(MockProvider::new(vec![]));
+        let mut stream = start_with(
+            provider.clone(),
+            assertion_request().await,
+            CancellationToken::new(),
+        );
+        assert!(next_state(&mut stream).await.is_none());
+        assert!(provider.assertion_ids.lock().unwrap().is_empty());
+    }
+
+    #[tokio::test]
+    async fn get_with_one_credential_signs_with_it() {
+        let mut provider = MockProvider::new(vec![Step::Reply(vec![], Ok(()))]);
+        provider.creds = vec![credential(CREDENTIAL_ID, "alice")];
+        let provider = Arc::new(provider);
+        let mut stream = start_with(
+            provider.clone(),
+            assertion_request().await,
+            CancellationToken::new(),
+        );
+        let Some(InternalStateInternal::Completed(
+            CredentialResponse::GetPublicKeyCredentialResponse(response),
+        )) = next_state(&mut stream).await
+        else {
+            panic!("expected an assertion");
+        };
+        assert_eq!(
+            response.ctap.user.as_ref().unwrap().name.as_deref(),
+            Some("alice")
+        );
+        assert_eq!(
+            *provider.assertion_ids.lock().unwrap(),
+            vec![CREDENTIAL_ID.to_vec()]
+        );
+    }
+
+    #[tokio::test]
+    async fn get_with_several_credentials_lets_the_user_choose() {
+        let mut provider = MockProvider::new(vec![Step::Reply(vec![], Ok(()))]);
+        provider.creds = vec![credential(&[1; 16], "alice"), credential(&[2; 16], "bob")];
+        let provider = Arc::new(provider);
+        let mut stream = start_with(
+            provider.clone(),
+            assertion_request().await,
+            CancellationToken::new(),
+        );
+        let Some(InternalStateInternal::SelectingCredential { creds, cred_tx }) =
+            next_state(&mut stream).await
+        else {
+            panic!("expected a credential choice");
+        };
+        let names: Vec<&str> = creds.iter().map(|c| c.name.as_str()).collect();
+        assert_eq!(names, vec!["alice", "bob"]);
+        // The UI only sees hashed credential IDs.
+        assert_ne!(creds[1].id, URL_SAFE_NO_PAD.encode([2u8; 16]));
+        cred_tx.send(creds[1].id.clone()).await.unwrap();
+        assert!(matches!(
+            next_state(&mut stream).await,
+            Some(InternalStateInternal::Completed(_))
+        ));
+        assert_eq!(*provider.assertion_ids.lock().unwrap(), vec![vec![2u8; 16]]);
+    }
+
+    #[test]
+    fn states_map_to_background_events() {
+        let (password_tx, _) = mpsc::channel(1);
+        assert_eq!(
+            BackgroundEvent::from(&InternalState::NeedsPassword {
+                incorrect: true,
+                password_tx,
+            }),
+            BackgroundEvent::NeedsPassword { incorrect: true }
+        );
+        assert_eq!(
+            BackgroundEvent::from(&InternalState::Locked),
+            BackgroundEvent::InternalLocked
+        );
+        assert_eq!(
+            BackgroundEvent::from(&InternalState::NeedsUserVerification {
+                attempts_left: None
+            }),
+            BackgroundEvent::NeedsUserVerification {
+                attempts_left: None
+            }
+        );
+    }
+
+    #[test]
+    fn secret_pipe_rejects_empty_and_oversized_secrets() {
+        assert!(secret_pipe(b"").is_err());
+        assert!(secret_pipe(&[b'a'; MAX_PASSWORD_LEN + 1]).is_err());
+        let mut s = String::new();
+        std::fs::File::from(secret_pipe(b"hunter2").unwrap())
+            .read_to_string(&mut s)
+            .unwrap();
+        assert_eq!(s, "hunter2");
+    }
+}

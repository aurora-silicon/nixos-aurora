diff --git a/credentialsd/src/credential_service/platform/convert.rs b/credentialsd/src/credential_service/platform/convert.rs
new file mode 100644
index 0000000..914f05c
--- /dev/null
+++ b/credentialsd/src/credential_service/platform/convert.rs
@@ -0,0 +1,370 @@
+//! Conversions between WebAuthn requests and responses and the provider
+//! interface.
+
+use libwebauthn::{
+    fido::AuthenticatorData,
+    ops::webauthn::{
+        Assertion, GetAssertionRequest, GetAssertionResponseExtensions, MakeCredentialRequest,
+        MakeCredentialResponse, MakeCredentialsResponseExtensions, ResidentKeyRequirement,
+        UserVerificationRequirement,
+    },
+    proto::ctap2::{
+        Ctap2AttestationStatement, Ctap2PublicKeyCredentialDescriptor,
+        Ctap2PublicKeyCredentialType, Ctap2PublicKeyCredentialUserEntity,
+    },
+};
+use serde::{Deserialize, de::value::BytesDeserializer};
+use serde_bytes::ByteBuf;
+
+use crate::model::CredentialResponse;
+
+use super::{
+    ProviderAssertion, ProviderAttestation, ProviderCredential, ProviderError,
+    ProviderGetAssertion, ProviderMakeCredential,
+};
+
+/// WebAuthn authenticator attachment reported for platform providers.
+pub const PLATFORM_ATTACHMENT: &str = "platform";
+
+fn user_verification(uv: &UserVerificationRequirement) -> &'static str {
+    match uv {
+        UserVerificationRequirement::Required => "required",
+        UserVerificationRequirement::Preferred => "preferred",
+        UserVerificationRequirement::Discouraged => "discouraged",
+    }
+}
+
+pub fn make_credential_args(request: &MakeCredentialRequest) -> ProviderMakeCredential {
+    ProviderMakeCredential {
+        client_data_hash: request.client_data_hash(),
+        rp_id: request.relying_party.id.clone(),
+        rp_name: request.relying_party.name.clone(),
+        user_id: request.user.id.to_vec(),
+        user_name: request.user.name.clone(),
+        user_display_name: request.user.display_name.clone(),
+        algorithms: request
+            .algorithms
+            .iter()
+            .map(|alg| i32::from(alg.algorithm))
+            .collect(),
+        exclude: request
+            .exclude
+            .iter()
+            .flatten()
+            .map(|cred| cred.id.to_vec())
+            .collect(),
+        resident_key: matches!(
+            request.resident_key,
+            Some(ResidentKeyRequirement::Required | ResidentKeyRequirement::Preferred)
+        ),
+        user_verification: user_verification(&request.user_verification),
+        origin: request.origin.clone(),
+        top_origin: request.top_origin.clone(),
+    }
+}
+
+pub fn get_assertion_args(
+    request: &GetAssertionRequest,
+    credential_id: &[u8],
+) -> ProviderGetAssertion {
+    ProviderGetAssertion {
+        client_data_hash: request.client_data_hash(),
+        rp_id: request.relying_party_id.clone(),
+        credential_id: credential_id.to_vec(),
+        user_verification: user_verification(&request.user_verification),
+        origin: request.origin.clone(),
+        top_origin: request.top_origin.clone(),
+    }
+}
+
+/// The credential IDs of a request's allow list.
+pub fn allow_list(request: &GetAssertionRequest) -> Vec<Vec<u8>> {
+    request.allow.iter().map(|cred| cred.id.to_vec()).collect()
+}
+
+fn check_rp_id_hash(rp_id_hash: &[u8; 32], rp_id: &str) -> Result<(), ProviderError> {
+    let expected = ring::digest::digest(&ring::digest::SHA256, rp_id.as_bytes());
+    if expected.as_ref() != rp_id_hash {
+        return Err(ProviderError::InvalidResponse(
+            "authenticator data is for another RP ID".to_string(),
+        ));
+    }
+    Ok(())
+}
+
+#[derive(Deserialize)]
+struct AttestationObject {
+    fmt: String,
+    #[serde(rename = "authData")]
+    auth_data: AuthenticatorData<MakeCredentialsResponseExtensions>,
+    #[serde(rename = "attStmt")]
+    att_stmt: Ctap2AttestationStatement,
+}
+
+/// Builds the credential service response from a provider's attestation
+/// object.
+pub fn attestation_to_response(
+    attestation: &ProviderAttestation,
+    rp_id: &str,
+) -> Result<CredentialResponse, ProviderError> {
+    let object: AttestationObject = serde_cbor_2::from_slice(&attestation.attestation_object)
+        .map_err(|err| ProviderError::InvalidResponse(format!("attestation object: {err}")))?;
+    check_rp_id_hash(&object.auth_data.rp_id_hash, rp_id)?;
+    if object.auth_data.attested_credential.is_none() {
+        return Err(ProviderError::InvalidResponse(
+            "attestation object has no attested credential".to_string(),
+        ));
+    }
+    let transports: Vec<String> = if attestation.transports.is_empty() {
+        vec!["internal".to_string()]
+    } else {
+        attestation.transports.clone()
+    };
+    let response = MakeCredentialResponse {
+        format: object.fmt,
+        authenticator_data: object.auth_data,
+        attestation_statement: object.att_stmt,
+        enterprise_attestation: None,
+        large_blob_key: None,
+        unsigned_extensions_output: Default::default(),
+        transport: None,
+        authenticator_transports: Some(transports.clone()),
+    };
+    let transports: Vec<&str> = transports.iter().map(String::as_str).collect();
+    Ok(CredentialResponse::from_make_credential(
+        &response,
+        &transports,
+        PLATFORM_ATTACHMENT,
+    ))
+}
+
+/// Builds the credential service response from a provider's assertion.
+pub fn assertion_to_response(
+    assertion: &ProviderAssertion,
+    credential: &ProviderCredential,
+    rp_id: &str,
+) -> Result<CredentialResponse, ProviderError> {
+    let authenticator_data =
+        AuthenticatorData::<GetAssertionResponseExtensions>::deserialize(BytesDeserializer::<
+            serde::de::value::Error,
+        >::new(
+            &assertion.authenticator_data,
+        ))
+        .map_err(|err| ProviderError::InvalidResponse(format!("authenticator data: {err}")))?;
+    check_rp_id_hash(&authenticator_data.rp_id_hash, rp_id)?;
+    if assertion.signature.is_empty() {
+        return Err(ProviderError::InvalidResponse(
+            "assertion has no signature".to_string(),
+        ));
+    }
+
+    let user_handle = if assertion.user_handle.is_empty() {
+        &credential.user_handle
+    } else {
+        &assertion.user_handle
+    };
+    let non_empty = |s: &str| (!s.is_empty()).then(|| s.to_string());
+    let user = (!user_handle.is_empty()).then(|| Ctap2PublicKeyCredentialUserEntity {
+        id: ByteBuf::from(user_handle.clone()),
+        name: non_empty(&credential.user_name),
+        display_name: non_empty(&credential.display_name),
+    });
+    let assertion = Assertion {
+        credential_id: Some(Ctap2PublicKeyCredentialDescriptor {
+            id: ByteBuf::from(credential.id.clone()),
+            r#type: Ctap2PublicKeyCredentialType::PublicKey,
+            transports: None,
+        }),
+        authenticator_data,
+        signature: assertion.signature.clone(),
+        user,
+        credentials_count: None,
+        user_selected: None,
+        unsigned_extensions_output: None,
+        transport: None,
+    };
+    Ok(CredentialResponse::from_get_assertion(
+        &assertion,
+        PLATFORM_ATTACHMENT,
+    ))
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use std::collections::BTreeMap;
+
+    use base64::{Engine, engine::general_purpose::URL_SAFE_NO_PAD};
+    use libwebauthn::ops::webauthn::{
+        OriginValidation, RequestSettings, WebAuthnIDLResponse, idl::origin::RequestOrigin,
+    };
+    use serde_cbor_2::Value;
+
+    use super::*;
+
+    pub(crate) const CREDENTIAL_ID: &[u8] = &[0xc0; 16];
+
+    /// Authenticator data for `rp_id` with flags UP and UV, plus an attested
+    /// P-256 credential when `attested` is set.
+    pub(crate) fn authenticator_data(rp_id: &str, attested: bool) -> Vec<u8> {
+        let mut data = ring::digest::digest(&ring::digest::SHA256, rp_id.as_bytes())
+            .as_ref()
+            .to_vec();
+        let flags: u8 = if attested { 0x45 } else { 0x05 };
+        data.push(flags);
+        data.extend_from_slice(&0u32.to_be_bytes());
+        if attested {
+            data.extend_from_slice(&[0u8; 16]);
+            data.extend_from_slice(&(CREDENTIAL_ID.len() as u16).to_be_bytes());
+            data.extend_from_slice(CREDENTIAL_ID);
+            let mut key = BTreeMap::new();
+            key.insert(Value::Integer(1), Value::Integer(2));
+            key.insert(Value::Integer(3), Value::Integer(-7));
+            key.insert(Value::Integer(-1), Value::Integer(1));
+            key.insert(Value::Integer(-2), Value::Bytes(vec![0x11; 32]));
+            key.insert(Value::Integer(-3), Value::Bytes(vec![0x22; 32]));
+            data.extend(serde_cbor_2::to_vec(&Value::Map(key)).unwrap());
+        }
+        data
+    }
+
+    pub(crate) fn attestation_object(rp_id: &str) -> Vec<u8> {
+        let mut object = BTreeMap::new();
+        object.insert(
+            Value::Text("fmt".to_string()),
+            Value::Text("none".to_string()),
+        );
+        object.insert(
+            Value::Text("attStmt".to_string()),
+            Value::Map(BTreeMap::new()),
+        );
+        object.insert(
+            Value::Text("authData".to_string()),
+            Value::Bytes(authenticator_data(rp_id, true)),
+        );
+        serde_cbor_2::to_vec(&Value::Map(object)).unwrap()
+    }
+
+    pub(crate) async fn make_request(json: &str) -> MakeCredentialRequest {
+        let origin: RequestOrigin = "https://example.com".try_into().unwrap();
+        let settings = RequestSettings {
+            origin: OriginValidation::Trust,
+        };
+        MakeCredentialRequest::prepare(&origin, json, &settings)
+            .await
+            .unwrap()
+    }
+
+    pub(crate) async fn get_request(json: &str) -> GetAssertionRequest {
+        let origin: RequestOrigin = "https://example.com".try_into().unwrap();
+        let settings = RequestSettings {
+            origin: OriginValidation::Trust,
+        };
+        GetAssertionRequest::prepare(&origin, json, &settings)
+            .await
+            .unwrap()
+    }
+
+    pub(crate) const MAKE_JSON: &str = r#"{
+        "rp": {"id": "example.com", "name": "Example"},
+        "user": {"id": "dXNlcg", "name": "alice", "displayName": "Alice"},
+        "challenge": "Y2hhbGxlbmdlY2hhbGxlbmdl",
+        "pubKeyCredParams": [{"type": "public-key", "alg": -7}, {"type": "public-key", "alg": -8}],
+        "excludeCredentials": [{"type": "public-key", "id": "AAEC"}],
+        "authenticatorSelection": {"residentKey": "required", "userVerification": "required"}
+    }"#;
+
+    pub(crate) const GET_JSON: &str = r#"{
+        "rpId": "example.com",
+        "challenge": "Y2hhbGxlbmdlY2hhbGxlbmdl",
+        "userVerification": "preferred"
+    }"#;
+
+    #[tokio::test]
+    async fn make_credential_args_follow_the_request() {
+        let request = make_request(MAKE_JSON).await;
+        let args = make_credential_args(&request);
+        assert_eq!(args.client_data_hash, request.client_data_hash());
+        assert_eq!(args.rp_id, "example.com");
+        assert_eq!(args.rp_name.as_deref(), Some("Example"));
+        assert_eq!(args.user_id, b"user");
+        assert_eq!(args.user_name.as_deref(), Some("alice"));
+        assert_eq!(args.user_display_name.as_deref(), Some("Alice"));
+        assert_eq!(args.algorithms, vec![-7, -8]);
+        assert_eq!(args.exclude, vec![vec![0, 1, 2]]);
+        assert!(args.resident_key);
+        assert_eq!(args.user_verification, "required");
+        assert_eq!(args.origin, "https://example.com");
+    }
+
+    #[tokio::test]
+    async fn attestation_object_converts_to_registration_json() {
+        let request = make_request(MAKE_JSON).await;
+        let attestation = ProviderAttestation {
+            attestation_object: attestation_object("example.com"),
+            transports: vec![],
+        };
+        let CredentialResponse::CreatePublicKeyCredentialResponse(response) =
+            attestation_to_response(&attestation, "example.com").unwrap()
+        else {
+            panic!("expected a create response");
+        };
+        assert_eq!(response.transport, vec!["internal".to_string()]);
+        assert_eq!(response.attachment_modality, "platform");
+        let json = response.ctap.to_idl_model(&request).unwrap();
+        assert_eq!(json.id, URL_SAFE_NO_PAD.encode(CREDENTIAL_ID));
+    }
+
+    #[test]
+    fn attestation_for_another_rp_is_rejected() {
+        let attestation = ProviderAttestation {
+            attestation_object: attestation_object("evil.example"),
+            transports: vec![],
+        };
+        assert!(matches!(
+            attestation_to_response(&attestation, "example.com"),
+            Err(ProviderError::InvalidResponse(_))
+        ));
+        let garbage = ProviderAttestation {
+            attestation_object: vec![1, 2, 3],
+            transports: vec![],
+        };
+        assert!(matches!(
+            attestation_to_response(&garbage, "example.com"),
+            Err(ProviderError::InvalidResponse(_))
+        ));
+    }
+
+    #[tokio::test]
+    async fn assertion_converts_to_authentication_json() {
+        let request = get_request(GET_JSON).await;
+        let credential = ProviderCredential {
+            id: CREDENTIAL_ID.to_vec(),
+            user_handle: b"user".to_vec(),
+            user_name: "alice".to_string(),
+            display_name: String::new(),
+        };
+        let assertion = ProviderAssertion {
+            authenticator_data: authenticator_data("example.com", false),
+            signature: vec![0x30, 0x00],
+            user_handle: vec![],
+        };
+        let CredentialResponse::GetPublicKeyCredentialResponse(response) =
+            assertion_to_response(&assertion, &credential, "example.com").unwrap()
+        else {
+            panic!("expected a get response");
+        };
+        assert_eq!(response.attachment_modality, "platform");
+        let user = response.ctap.user.as_ref().unwrap();
+        assert_eq!(user.id.as_ref(), b"user");
+        assert_eq!(user.name.as_deref(), Some("alice"));
+        assert_eq!(user.display_name, None);
+        let json = response.ctap.to_idl_model(&request).unwrap();
+        assert_eq!(json.id, URL_SAFE_NO_PAD.encode(CREDENTIAL_ID));
+
+        let wrong_rp = ProviderAssertion {
+            authenticator_data: authenticator_data("evil.example", false),
+            ..assertion
+        };
+        assert!(assertion_to_response(&wrong_rp, &credential, "example.com").is_err());
+    }
+}

+//! Handler for the `internal` transport: runs requests against platform
+//! passkey providers.
+
+use std::{future::Future, io::Write, os::fd::OwnedFd, pin::Pin, sync::Arc};
+
+use async_stream::stream;
+use base64::{Engine, engine::general_purpose::URL_SAFE_NO_PAD};
+use futures_lite::{Stream, StreamExt};
+use tokio::sync::mpsc;
+use tokio_util::sync::CancellationToken;
+use zeroize::Zeroize;
+
+use credentialsd_common::model::{BackgroundEvent, Credential};
+
+use crate::model::{CredentialRequest, CredentialResponse};
+
+use super::{
+    CredentialServiceError,
+    platform::{
+        PlatformProvider, PlatformProviders, ProviderCredential, ProviderError, ProviderInfo,
+        UserActionKind, UserActionStream, convert,
+    },
+};
+
+/// The largest password credentialsd passes on to a provider.
+const MAX_PASSWORD_LEN: usize = 1024;
+
+type ProviderCall<T> = Pin<Box<dyn Future<Output = Result<T, ProviderError>> + Send>>;
+
+pub struct InternalEvent {
+    pub(super) state: InternalStateInternal,
+}
+
+#[derive(Clone, Debug)]
+pub(super) enum InternalStateInternal {
+    /// The provider is locked and cannot be used in this ceremony.
+    Locked,
+    NeedsUserVerification {
+        attempts_left: Option<u32>,
+    },
+    NeedsUserPresence,
+    NeedsPassword {
+        incorrect: bool,
+        password_tx: mpsc::Sender<Vec<u8>>,
+    },
+    SelectingCredential {
+        creds: Vec<Credential>,
+        cred_tx: mpsc::Sender<String>,
+    },
+    Completed(CredentialResponse),
+    Failed(CredentialServiceError),
+}
+
+#[derive(Clone, Debug)]
+pub enum InternalState {
+    Locked,
+    NeedsUserVerification {
+        attempts_left: Option<u32>,
+    },
+    NeedsUserPresence,
+    NeedsPassword {
+        incorrect: bool,
+        password_tx: mpsc::Sender<Vec<u8>>,
+    },
+    SelectingCredential {
+        creds: Vec<Credential>,
+        cred_tx: mpsc::Sender<String>,
+    },
+    Completed,
+    Failed(CredentialServiceError),
+}
+
+impl From<InternalStateInternal> for InternalState {
+    fn from(value: InternalStateInternal) -> Self {
+        match value {
+            InternalStateInternal::Locked => Self::Locked,
+            InternalStateInternal::NeedsUserVerification { attempts_left } => {
+                Self::NeedsUserVerification { attempts_left }
+            }
+            InternalStateInternal::NeedsUserPresence => Self::NeedsUserPresence,
+            InternalStateInternal::NeedsPassword {
+                incorrect,
+                password_tx,
+            } => Self::NeedsPassword {
+                incorrect,
+                password_tx,
+            },
+            InternalStateInternal::SelectingCredential { creds, cred_tx } => {
+                Self::SelectingCredential { creds, cred_tx }
+            }
+            InternalStateInternal::Completed(_) => Self::Completed,
+            InternalStateInternal::Failed(err) => Self::Failed(err),
+        }
+    }
+}
+
+impl From<&InternalState> for BackgroundEvent {
+    fn from(value: &InternalState) -> Self {
+        match value {
+            InternalState::Locked => BackgroundEvent::InternalLocked,
+            InternalState::NeedsUserVerification { attempts_left } => {
+                BackgroundEvent::NeedsUserVerification {
+                    attempts_left: *attempts_left,
+                }
+            }
+            InternalState::NeedsUserPresence => BackgroundEvent::NeedsUserPresence,
+            InternalState::NeedsPassword { incorrect, .. } => BackgroundEvent::NeedsPassword {
+                incorrect: *incorrect,
+            },
+            InternalState::SelectingCredential { creds, .. } => {
+                BackgroundEvent::SelectingCredential {
+                    creds: creds.clone(),
+                }
+            }
+            InternalState::Completed => BackgroundEvent::CeremonyCompleted,
+            InternalState::Failed(CredentialServiceError::CredentialExcluded) => {
+                BackgroundEvent::ErrorCredentialExcluded
+            }
+            InternalState::Failed(CredentialServiceError::NoCredentials) => {
+                BackgroundEvent::ErrorNoCredentials
+            }
+            InternalState::Failed(CredentialServiceError::NonTerminatingCancellation) => {
+                BackgroundEvent::ErrorCancelled
+            }
+            InternalState::Failed(CredentialServiceError::Internal(_)) => {
+                BackgroundEvent::ErrorInternal
+            }
+            InternalState::Failed(
+                CredentialServiceError::AuthenticatorError
+                | CredentialServiceError::PinAttemptsExhausted,
+            ) => BackgroundEvent::ErrorAuthenticator,
+        }
+    }
+}
+
+/// Starts the request on every available platform provider and returns the
+/// merged stream of their states.
+pub(super) fn start(
+    providers: Arc<PlatformProviders>,
+    request: CredentialRequest,
+    cancellation: CancellationToken,
+) -> impl Stream<Item = InternalEvent> + Send + Unpin + 'static {
+    let (tx, mut rx) = mpsc::channel(32);
+    tokio::spawn(async move {
+        for (provider, info) in providers.available().await {
+            let tx = tx.clone();
+            let request = request.clone();
+            let cancellation = cancellation.clone();
+            tokio::spawn(async move {
+                let id = provider.id().to_string();
+                let result = run(provider, info, request, &tx, &cancellation).await;
+                match result {
+                    Ok(()) => {}
+                    Err(CredentialServiceError::NonTerminatingCancellation) => {
+                        tracing::debug!(id, "Platform provider request cancelled");
+                    }
+                    Err(err) => {
+                        tracing::warn!(id, %err, "Platform provider request failed");
+                        if super::is_ceremony_terminating(&err) {
+                            _ = tx.send(InternalStateInternal::Failed(err)).await;
+                        }
+                    }
+                }
+            });
+        }
+    });
+    Box::pin(stream! {
+        while let Some(state) = rx.recv().await {
+            yield InternalEvent { state }
+        }
+    })
+}
+
+async fn send(
+    tx: &mpsc::Sender<InternalStateInternal>,
+    state: InternalStateInternal,
+) -> Result<(), CredentialServiceError> {
+    tx.send(state).await.map_err(|_| {
+        CredentialServiceError::Internal("platform provider state receiver closed".to_string())
+    })
+}
+
+/// Runs one request against one provider until it completes, fails, is
+/// declined by the user or is cancelled.
+async fn run(
+    provider: Arc<dyn PlatformProvider>,
+    info: ProviderInfo,
+    request: CredentialRequest,
+    tx: &mpsc::Sender<InternalStateInternal>,
+    cancellation: &CancellationToken,
+) -> Result<(), CredentialServiceError> {
+    if info.locked {
+        return send(tx, InternalStateInternal::Locked).await;
+    }
+
+    // Subscribe before the first call so no signal is missed. Prompts still
+    // work without the signals, so a failure here is not fatal.
+    let mut actions = provider
+        .user_actions()
+        .await
+        .inspect_err(|err| tracing::debug!(%err, "Cannot subscribe to provider user actions"))
+        .ok();
+
+    let response = match &request {
+        CredentialRequest::CreatePublicKeyCredentialRequest(make_request) => {
+            let args = convert::make_credential_args(make_request);
+            let op_provider = provider.clone();
+            let op_args = args.clone();
+            let Some(attestation) = with_password(
+                &provider,
+                &mut actions,
+                tx,
+                cancellation,
+                move |request_id, password| {
+                    let provider = op_provider.clone();
+                    let args = op_args.clone();
+                    Box::pin(
+                        async move { provider.make_credential(request_id, &args, password).await },
+                    )
+                },
+            )
+            .await?
+            else {
+                return Ok(());
+            };
+            convert::attestation_to_response(&attestation, &args.rp_id)
+        }
+        CredentialRequest::GetPublicKeyCredentialRequest(get_request) => {
+            let allow = convert::allow_list(get_request);
+            let creds = match cancellation
+                .run_until_cancelled(
+                    provider.list_credentials(&get_request.relying_party_id, &allow),
+                )
+                .await
+            {
+                None => return Err(CredentialServiceError::NonTerminatingCancellation),
+                Some(Err(ProviderError::Locked)) => {
+                    return send(tx, InternalStateInternal::Locked).await;
+                }
+                Some(Err(err)) => {
+                    tracing::warn!(%err, "Failed to list platform provider credentials");
+                    return Err(CredentialServiceError::AuthenticatorError);
+                }
+                Some(Ok(creds)) => creds,
+            };
+            let Some(credential) = choose_credential(creds, tx, cancellation).await? else {
+                tracing::debug!(
+                    id = provider.id(),
+                    "Platform provider has no credential for this request"
+                );
+                return Ok(());
+            };
+            let args = convert::get_assertion_args(get_request, &credential.id);
+            let op_provider = provider.clone();
+            let op_args = args.clone();
+            let Some(assertion) = with_password(
+                &provider,
+                &mut actions,
+                tx,
+                cancellation,
+                move |request_id, password| {
+                    let provider = op_provider.clone();
+                    let args = op_args.clone();
+                    Box::pin(
+                        async move { provider.get_assertion(request_id, &args, password).await },
+                    )
+                },
+            )
+            .await?
+            else {
+                return Ok(());
+            };
+            convert::assertion_to_response(&assertion, &credential, &args.rp_id)
+        }
+    };
+
+    match response {
+        Ok(response) => send(tx, InternalStateInternal::Completed(response)).await,
+        Err(err) => {
+            tracing::warn!(%err, "Platform provider returned an invalid response");
+            Err(CredentialServiceError::AuthenticatorError)
+        }
+    }
+}
+
+/// Picks the credential to use. Asks the user when the provider holds more
+/// than one. Returns `None` when the provider has no matching credential.
+async fn choose_credential(
+    mut creds: Vec<ProviderCredential>,
+    tx: &mpsc::Sender<InternalStateInternal>,
+    cancellation: &CancellationToken,
+) -> Result<Option<ProviderCredential>, CredentialServiceError> {
+    if creds.len() <= 1 {
+        return Ok(creds.pop());
+    }
+    // As for USB authenticators, the UI only sees a hash of each credential
+    // ID.
+    let hashed_id =
+        |id: &[u8]| URL_SAFE_NO_PAD.encode(ring::digest::digest(&ring::digest::SHA256, id));
+    let (cred_tx, mut cred_rx) = mpsc::channel(1);
+    let ui_creds = creds
+        .iter()
+        .map(|cred| Credential {
+            id: hashed_id(&cred.id),
+            name: if cred.user_name.is_empty() {
+                String::from("<unknown>")
+            } else {
+                cred.user_name.clone()
+            },
+            display_name: (!cred.display_name.is_empty()).then(|| cred.display_name.clone()),
+        })
+        .collect();
+    send(
+        tx,
+        InternalStateInternal::SelectingCredential {
+            creds: ui_creds,
+            cred_tx,
+        },
+    )
+    .await?;
+    let selected = match cancellation.run_until_cancelled(cred_rx.recv()).await {
+        None => return Err(CredentialServiceError::NonTerminatingCancellation),
+        Some(None) => {
+            return Err(CredentialServiceError::Internal(
+                "credential selection channel closed".to_string(),
+            ));
+        }
+        Some(Some(selected)) => selected,
+    };
+    creds
+        .into_iter()
+        .find(|cred| hashed_id(&cred.id) == selected)
+        .map(Some)
+        .ok_or(CredentialServiceError::NoCredentials)
+}
+
+/// Calls `op` until the provider stops asking for the user's password.
+///
+/// When the provider answers [`ProviderError::PasswordNeeded`] or
+/// [`ProviderError::WrongPassword`], the UI is asked for the password and
+/// `op` is called again with it. Each call gets a new request ID.
+///
+/// Returns `None` when the provider turned out to be locked; the UI has been
+/// told already.
+async fn with_password<T, F>(
+    provider: &Arc<dyn PlatformProvider>,
+    actions: &mut Option<UserActionStream>,
+    tx: &mpsc::Sender<InternalStateInternal>,
+    cancellation: &CancellationToken,
+    op: F,
+) -> Result<Option<T>, CredentialServiceError>
+where
+    F: Fn(u32, Option<OwnedFd>) -> ProviderCall<T>,
+{
+    let mut password: Option<OwnedFd> = None;
+    loop {
+        let request_id: u32 = rand::random_range(1..=u32::MAX);
+        let call = op(request_id, password.take());
+        let result = drive(provider, request_id, call, actions, tx, cancellation).await?;
+        let incorrect = match result {
+            Ok(value) => return Ok(Some(value)),
+            Err(ProviderError::Locked) => {
+                send(tx, InternalStateInternal::Locked).await?;
+                return Ok(None);
+            }
+            Err(ProviderError::PasswordNeeded) => false,
+            Err(ProviderError::WrongPassword) => true,
+            Err(err) => return Err(provider_error(err)),
+        };
+        let (password_tx, mut password_rx) = mpsc::channel(1);
+        send(
+            tx,
+            InternalStateInternal::NeedsPassword {
+                incorrect,
+                password_tx,
+            },
+        )
+        .await?;
+        let mut secret = match cancellation.run_until_cancelled(password_rx.recv()).await {
+            None => return Err(CredentialServiceError::NonTerminatingCancellation),
+            Some(None) => {
+                return Err(CredentialServiceError::Internal(
+                    "password channel closed".to_string(),
+                ));
+            }
+            Some(Some(secret)) => secret,
+        };
+        let fd = secret_pipe(&secret);
+        secret.zeroize();
+        password = Some(fd.map_err(|err| {
+            CredentialServiceError::Internal(format!("cannot pass password to provider: {err}"))
+        })?);
+    }
+}
+
+/// Maps a provider error that ends the request on this provider.
+fn provider_error(err: ProviderError) -> CredentialServiceError {
+    match err {
+        ProviderError::InvalidState => CredentialServiceError::CredentialExcluded,
+        ProviderError::Aborted => CredentialServiceError::NonTerminatingCancellation,
+        err => {
+            tracing::info!(%err, "Platform provider did not complete the request");
+            CredentialServiceError::AuthenticatorError
+        }
+    }
+}
+
+/// Runs a provider call, forwards its `UserActionNeeded` signals to the UI
+/// and cancels it on the provider when the request is cancelled.
+async fn drive<T>(
+    provider: &Arc<dyn PlatformProvider>,
+    request_id: u32,
+    call: impl Future<Output = Result<T, ProviderError>>,
+    actions: &mut Option<UserActionStream>,
+    tx: &mpsc::Sender<InternalStateInternal>,
+    cancellation: &CancellationToken,
+) -> Result<Result<T, ProviderError>, CredentialServiceError> {
+    let mut call = std::pin::pin!(call);
+    loop {
+        tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => {
+                provider.cancel(request_id).await;
+                return Err(CredentialServiceError::NonTerminatingCancellation);
+            }
+            result = &mut call => return Ok(result),
+            Some(action) = next_action(actions) => {
+                if action.request_id != request_id {
+                    continue;
+                }
+                let state = match action.kind {
+                    UserActionKind::Touch => InternalStateInternal::NeedsUserVerification {
+                        attempts_left: action.retries,
+                    },
+                    UserActionKind::Presence => InternalStateInternal::NeedsUserPresence,
+                    UserActionKind::Other(kind) => {
+                        tracing::debug!(kind, "Ignoring unknown provider user action");
+                        continue;
+                    }
+                };
+                send(tx, state).await?;
+            }
+        }
+    }
+}
+
+async fn next_action(
+    actions: &mut Option<UserActionStream>,
+) -> Option<super::platform::UserAction> {
+    match actions {
+        Some(stream) => match stream.next().await {
+            Some(action) => Some(action),
+            None => {
+                *actions = None;
+                std::future::pending().await
+            }
+        },
+        None => std::future::pending().await,
+    }
+}
+
+/// Writes a secret into a pipe and returns the read end. The provider reads
+/// the secret until end of file.
+fn secret_pipe(secret: &[u8]) -> std::io::Result<OwnedFd> {
+    if secret.is_empty() || secret.len() > MAX_PASSWORD_LEN {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "password is empty or too long",
+        ));
+    }
+    let (reader, mut writer) = std::io::pipe()?;
+    // The secret is far smaller than the pipe buffer, so this never blocks.
+    writer.write_all(secret)?;
+    drop(writer);
+    Ok(reader.into())
+}

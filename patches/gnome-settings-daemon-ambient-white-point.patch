diff --git a/plugins/color/ambient-policy-test.c b/plugins/color/ambient-policy-test.c
new file mode 100644
index 0000000..03f9ff7
--- /dev/null
+++ b/plugins/color/ambient-policy-test.c
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <math.h>
+#include "gsd-ambient-policy.h"
+#include "ambient-test-vectors.h"
+
+static void
+test_targets (void)
+{
+        const GsdAmbientModel *model = &gsd_ambient_model_default;
+
+        for (guint i = 0; i < G_N_ELEMENTS (ambient_target_vectors); i++) {
+                const AmbientTargetVector *v = &ambient_target_vectors[i];
+                double kelvin = 1e6 / gsd_ambient_target_mired (model, v->valid, v->lux, v->kelvin);
+                g_assert_cmpfloat_with_epsilon (kelvin, v->expect_k, 1e-3);
+        }
+}
+
+static void
+test_trajectory (void)
+{
+        GsdAmbientPolicy policy;
+        guint tick = 0;
+
+        gsd_ambient_policy_init (&policy, &gsd_ambient_model_default);
+        for (guint r = 0; r < G_N_ELEMENTS (ambient_tick_runs); r++) {
+                const AmbientTickRun *run = &ambient_tick_runs[r];
+                for (int i = 0; i < run->count; i++, tick++) {
+                        double kelvin = gsd_ambient_policy_tick (&policy, run->releasing, run->valid,
+                                                                 run->lux, run->kelvin);
+                        g_assert_cmpuint (tick, <, G_N_ELEMENTS (ambient_tick_expect_k));
+                        g_assert_cmpfloat_with_epsilon (kelvin, ambient_tick_expect_k[tick], 1e-3);
+                }
+        }
+        g_assert_cmpuint (tick, ==, G_N_ELEMENTS (ambient_tick_expect_k));
+        g_assert_true (gsd_ambient_policy_is_neutral (&policy));
+}
+
+static void
+test_limits (void)
+{
+        const GsdAmbientModel *model = &gsd_ambient_model_default;
+        double swing = gsd_ambient_mired (model->warmest_k) - gsd_ambient_mired (model->coolest_k);
+        GsdAmbientPolicy policy;
+        double previous = 6500;
+
+        /* Any input stays inside the limits, and no step is faster than the
+         * largest swing over the shortest fade at the fade's steepest. */
+        gsd_ambient_policy_init (&policy, model);
+        for (guint i = 0; i < 2000; i++) {
+                double lux = (i * 7919) % 3000;
+                double kelvin = 1000 + (i * 104729) % 15000;
+
+                gsd_ambient_policy_sample (&policy, FALSE, TRUE, lux, kelvin);
+                for (guint step = 0; step < 10; step++) {
+                        double out = gsd_ambient_policy_advance (&policy, GSD_AMBIENT_STEP_S);
+                        g_assert_cmpfloat (out, >=, model->warmest_k - 1e-6);
+                        g_assert_cmpfloat (out, <=, model->coolest_k + 1e-6);
+                        g_assert_cmpfloat (fabs (1e6 / out - 1e6 / previous), <=,
+                                           1.9 * swing * GSD_AMBIENT_STEP_S / model->toggle_ramp_s + 1e-9);
+                        previous = out;
+                }
+        }
+}
+
+static guint
+fade_steps (GsdAmbientPolicy *policy)
+{
+        guint steps = 0;
+
+        while (!gsd_ambient_policy_is_settled (policy)) {
+                gsd_ambient_policy_advance (policy, GSD_AMBIENT_STEP_S);
+                steps++;
+        }
+        return steps;
+}
+
+static void
+test_ramp (void)
+{
+        const GsdAmbientModel *model = &gsd_ambient_model_default;
+        double n = gsd_ambient_mired (6500), w = gsd_ambient_mired (5000);
+        GsdAmbientPolicy policy;
+        guint steps = 0;
+
+        /* The fade shape passes through its three quartiles and is monotonic. */
+        g_assert_cmpfloat_with_epsilon (gsd_ambient_ease (0.25), 0.25033, 1e-9);
+        g_assert_cmpfloat_with_epsilon (gsd_ambient_ease (0.5), 0.66672, 1e-9);
+        g_assert_cmpfloat_with_epsilon (gsd_ambient_ease (0.75), 0.91656, 1e-9);
+        for (guint i = 0; i < 200; i++)
+                g_assert_cmpfloat (gsd_ambient_ease (i / 200.0), <=, gsd_ambient_ease ((i + 1) / 200.0));
+
+        /* Switching on fades over the 2 s toggle time along that shape. */
+        gsd_ambient_policy_init (&policy, model);
+        gsd_ambient_policy_sample (&policy, FALSE, TRUE, 300, 3000);
+        while (!gsd_ambient_policy_is_settled (&policy)) {
+                double out = gsd_ambient_policy_advance (&policy, GSD_AMBIENT_STEP_S);
+                steps++;
+                g_assert_cmpfloat_with_epsilon (1e6 / out, n + (w - n) *
+                        gsd_ambient_ease (MIN (steps * GSD_AMBIENT_STEP_S / model->toggle_ramp_s, 1.0)), 1e-6);
+        }
+        g_assert_cmpuint (steps, ==, (guint) round (model->toggle_ramp_s / GSD_AMBIENT_STEP_S));
+        g_assert_cmpfloat_with_epsilon (gsd_ambient_policy_get_kelvin (&policy), 5000, 1e-6);
+
+        /* A move of the ambient target afterwards takes the 5 s ambient fade. */
+        for (guint i = 0; i < 40; i++)
+                gsd_ambient_policy_sample (&policy, FALSE, TRUE, 300, 6000);
+        g_assert_false (gsd_ambient_policy_is_settled (&policy));
+        steps = fade_steps (&policy);
+        g_assert_cmpuint (steps, <=, (guint) round (model->ambient_ramp_s / GSD_AMBIENT_STEP_S));
+        g_assert_cmpuint (steps, >, (guint) round (model->toggle_ramp_s / GSD_AMBIENT_STEP_S));
+
+        /* Switching off returns to neutral in the toggle time. */
+        gsd_ambient_policy_sample (&policy, TRUE, TRUE, 300, 3000);
+        g_assert_cmpuint (fade_steps (&policy), ==, (guint) round (model->toggle_ramp_s / GSD_AMBIENT_STEP_S));
+        g_assert_true (gsd_ambient_policy_is_neutral (&policy));
+}
+
+static void
+test_compose (void)
+{
+        /* Night Light wins: the result is never cooler than Night Light. */
+        g_assert_cmpfloat (gsd_ambient_compose (6500, 5600), ==, 5600);
+        g_assert_cmpfloat (gsd_ambient_compose (2700, 5600), ==, 2700);
+        g_assert_cmpfloat (gsd_ambient_compose (4000, 6500), ==, 4000);
+}
+
+int
+main (int argc, char **argv)
+{
+        g_test_init (&argc, &argv, NULL);
+        g_test_add_func ("/color/ambient/targets", test_targets);
+        g_test_add_func ("/color/ambient/trajectory", test_trajectory);
+        g_test_add_func ("/color/ambient/limits", test_limits);
+        g_test_add_func ("/color/ambient/ramp", test_ramp);
+        g_test_add_func ("/color/ambient/compose", test_compose);
+        return g_test_run ();
+}
diff --git a/plugins/color/ambient-service-test.c b/plugins/color/ambient-service-test.c
new file mode 100644
index 0000000..5f32a5f
--- /dev/null
+++ b/plugins/color/ambient-service-test.c
@@ -0,0 +1,300 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Runs the ambient white point object against fake iio-sensor-proxy and
+ * mutter services on a private bus.
+ */
+#include <math.h>
+#include <gio/gio.h>
+#include "gsd-ambient-white-point.h"
+
+static const char sensor_xml[] =
+        "<node><interface name='net.hadess.SensorProxy'>"
+        "<method name='ClaimLight'/><method name='ReleaseLight'/>"
+        "<property name='HasAmbientLight' type='b' access='read'/>"
+        "<property name='LightLevelUnit' type='s' access='read'/>"
+        "<property name='LightLevel' type='d' access='read'/>"
+        "<property name='ColorTemperature' type='d' access='read'/>"
+        "</interface></node>";
+static const char display_xml[] =
+        "<node><interface name='org.gnome.Mutter.DisplayConfig'>"
+        "<property name='NightLightSupported' type='b' access='read'/>"
+        "</interface></node>";
+
+typedef struct {
+        GTestDBus *bus;
+        GDBusConnection *service;
+        GDBusNodeInfo *sensor_info, *display_info;
+        guint sensor_object, display_object;
+        guint sensor_name, display_name;
+        gboolean has_light, supported;
+        const char *unit;
+        double lux, kelvin;
+        int claims;
+        GSettings *settings;
+        GsdAmbientWhitePoint *ambient;
+} Fixture;
+
+static void
+sensor_method (GDBusConnection *c, const char *sender, const char *path, const char *iface,
+               const char *method, GVariant *params, GDBusMethodInvocation *invocation, gpointer data)
+{
+        Fixture *f = data;
+        f->claims += g_str_equal (method, "ClaimLight") ? 1 : -1;
+        g_dbus_method_invocation_return_value (invocation, NULL);
+}
+
+static GVariant *
+sensor_property (GDBusConnection *c, const char *sender, const char *path, const char *iface,
+                 const char *name, GError **error, gpointer data)
+{
+        Fixture *f = data;
+        if (g_str_equal (name, "HasAmbientLight"))
+                return g_variant_new_boolean (f->has_light);
+        if (g_str_equal (name, "LightLevelUnit"))
+                return g_variant_new_string (f->unit);
+        if (g_str_equal (name, "LightLevel"))
+                return g_variant_new_double (f->lux);
+        return g_variant_new_double (f->kelvin);
+}
+
+static GVariant *
+display_property (GDBusConnection *c, const char *sender, const char *path, const char *iface,
+                  const char *name, GError **error, gpointer data)
+{
+        return g_variant_new_boolean (((Fixture *) data)->supported);
+}
+
+static const GDBusInterfaceVTable sensor_vtable = { sensor_method, sensor_property, NULL };
+static const GDBusInterfaceVTable display_vtable = { NULL, display_property, NULL };
+
+static void
+emit_changed (Fixture *f, const char *path, const char *iface, const char *name, GVariant *value)
+{
+        GVariantBuilder changed;
+        g_variant_builder_init (&changed, G_VARIANT_TYPE ("a{sv}"));
+        g_variant_builder_add (&changed, "{sv}", name, value);
+        g_dbus_connection_emit_signal (f->service, NULL, path, "org.freedesktop.DBus.Properties",
+                                       "PropertiesChanged",
+                                       g_variant_new ("(sa{sv}as)", iface, &changed, NULL), NULL);
+}
+
+static void
+set_light (Fixture *f, double lux, double kelvin)
+{
+        f->lux = lux;
+        f->kelvin = kelvin;
+        emit_changed (f, "/net/hadess/SensorProxy", "net.hadess.SensorProxy", "LightLevel", g_variant_new_double (lux));
+        emit_changed (f, "/net/hadess/SensorProxy", "net.hadess.SensorProxy", "ColorTemperature", g_variant_new_double (kelvin));
+}
+
+static void
+set_supported (Fixture *f, gboolean supported)
+{
+        f->supported = supported;
+        emit_changed (f, "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig",
+                      "NightLightSupported", g_variant_new_boolean (supported));
+}
+
+static void
+own_sensor (Fixture *f)
+{
+        f->sensor_object = g_dbus_connection_register_object (f->service, "/net/hadess/SensorProxy",
+                                                              f->sensor_info->interfaces[0],
+                                                              &sensor_vtable, f, NULL, NULL);
+        f->sensor_name = g_bus_own_name_on_connection (f->service, "net.hadess.SensorProxy",
+                                                       G_BUS_NAME_OWNER_FLAGS_NONE, NULL, NULL, NULL, NULL);
+}
+
+static void
+drop_sensor (Fixture *f)
+{
+        g_clear_handle_id (&f->sensor_name, g_bus_unown_name);
+        g_dbus_connection_unregister_object (f->service, f->sensor_object);
+        /* The real daemon forgets claims of clients it no longer serves. */
+        f->claims = 0;
+}
+
+static gboolean
+timeout_cb (gpointer data)
+{
+        g_error ("Timed out waiting for a condition");
+        return G_SOURCE_REMOVE;
+}
+
+#define WAIT_FOR(cond) G_STMT_START { \
+        guint id = g_timeout_add_seconds (20, timeout_cb, NULL); \
+        while (!(cond)) g_main_context_iteration (NULL, TRUE); \
+        g_source_remove (id); \
+} G_STMT_END
+
+static void
+setup (Fixture *f, gconstpointer data)
+{
+        f->bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+        g_test_dbus_up (f->bus);
+        g_setenv ("DBUS_SYSTEM_BUS_ADDRESS", g_test_dbus_get_bus_address (f->bus), TRUE);
+        f->service = g_dbus_connection_new_for_address_sync (g_test_dbus_get_bus_address (f->bus),
+                                                             G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                                             G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+                                                             NULL, NULL, NULL);
+        g_assert_nonnull (f->service);
+        f->sensor_info = g_dbus_node_info_new_for_xml (sensor_xml, NULL);
+        f->display_info = g_dbus_node_info_new_for_xml (display_xml, NULL);
+        f->has_light = TRUE;
+        f->supported = TRUE;
+        f->unit = "lux";
+        f->lux = 300;
+        f->kelvin = 3000;
+        own_sensor (f);
+        f->display_object = g_dbus_connection_register_object (f->service, "/org/gnome/Mutter/DisplayConfig",
+                                                               f->display_info->interfaces[0],
+                                                               &display_vtable, f, NULL, NULL);
+        f->display_name = g_bus_own_name_on_connection (f->service, "org.gnome.Mutter.DisplayConfig",
+                                                        G_BUS_NAME_OWNER_FLAGS_NONE, NULL, NULL, NULL, NULL);
+        f->settings = g_settings_new ("org.gnome.settings-daemon.plugins.color");
+        g_settings_set_boolean (f->settings, "ambient-white-point-enabled", FALSE);
+        f->ambient = gsd_ambient_white_point_new ();
+        gsd_ambient_white_point_set_tick_interval (f->ambient, 2);
+        gsd_ambient_white_point_start (f->ambient);
+}
+
+static void
+teardown (Fixture *f, gconstpointer data)
+{
+        gsd_ambient_white_point_stop (f->ambient);
+        g_clear_object (&f->ambient);
+        g_clear_object (&f->settings);
+        g_clear_handle_id (&f->display_name, g_bus_unown_name);
+        g_clear_handle_id (&f->sensor_name, g_bus_unown_name);
+        g_clear_object (&f->service);
+        g_clear_pointer (&f->sensor_info, g_dbus_node_info_unref);
+        g_clear_pointer (&f->display_info, g_dbus_node_info_unref);
+        g_test_dbus_down (f->bus);
+        g_clear_object (&f->bus);
+}
+
+static void
+spin (guint ms)
+{
+        gint64 end = g_get_monotonic_time () + ms * 1000;
+        while (g_get_monotonic_time () < end)
+                g_main_context_iteration (NULL, FALSE);
+}
+
+/* Off: no claim, neutral. */
+static void
+test_default_off (Fixture *f, gconstpointer data)
+{
+        spin (300);
+        g_assert_cmpint (f->claims, ==, 0);
+        g_assert_cmpuint (gsd_ambient_white_point_get_temperature (f->ambient), ==, 6500);
+        g_assert_false (gsd_ambient_white_point_get_active (f->ambient));
+}
+
+/* Enabled in warm light: claims the sensor, ramps slowly to the warm limit,
+ * never overshoots, and returns to neutral and releases when disabled. */
+static void
+test_follow_and_release (Fixture *f, gconstpointer data)
+{
+        guint previous = 6500;
+
+        g_settings_set_boolean (f->settings, "ambient-white-point-enabled", TRUE);
+        WAIT_FOR (f->claims == 1);
+        WAIT_FOR (gsd_ambient_white_point_get_ambient_temperature (f->ambient) == 3000);
+        g_assert_true (gsd_ambient_white_point_get_available (f->ambient));
+        while (gsd_ambient_white_point_get_temperature (f->ambient) > 5000) {
+                guint t = gsd_ambient_white_point_get_temperature (f->ambient);
+                g_assert_cmpuint (t, <=, previous);
+                g_assert_cmpuint (t, >=, 5000);
+                previous = t;
+                g_main_context_iteration (NULL, TRUE);
+        }
+        g_assert_true (gsd_ambient_white_point_get_active (f->ambient));
+
+        g_settings_set_boolean (f->settings, "ambient-white-point-enabled", FALSE);
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 6500);
+        WAIT_FOR (f->claims == 0);
+        g_assert_false (gsd_ambient_white_point_get_active (f->ambient));
+}
+
+/* Darkness, an unsupported compositor, a vendor unit and a lost sensor all
+ * lead back to neutral. */
+static void
+test_back_off (Fixture *f, gconstpointer data)
+{
+        g_settings_set_boolean (f->settings, "ambient-white-point-enabled", TRUE);
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 5000);
+
+        set_light (f, 1, 3000);
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 6500);
+        g_assert_cmpint (f->claims, ==, 1);
+
+        set_light (f, 300, 3000);
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 5000);
+        set_supported (f, FALSE);
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 6500);
+        WAIT_FOR (f->claims == 0);
+        g_assert_false (gsd_ambient_white_point_get_available (f->ambient));
+
+        set_supported (f, TRUE);
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 5000);
+        drop_sensor (f);
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 6500);
+        g_assert_false (gsd_ambient_white_point_get_available (f->ambient));
+
+        own_sensor (f);
+        WAIT_FOR (f->claims == 1);
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 5000);
+}
+
+/* A sensor without colour, or a light level that is not in lux, does
+ * nothing. */
+static void
+test_no_colour (Fixture *f, gconstpointer data)
+{
+        f->kelvin = 0;
+        g_settings_set_boolean (f->settings, "ambient-white-point-enabled", TRUE);
+        WAIT_FOR (f->claims == 1);
+        spin (300);
+        g_assert_cmpuint (gsd_ambient_white_point_get_temperature (f->ambient), ==, 6500);
+        g_assert_false (gsd_ambient_white_point_get_available (f->ambient));
+
+        f->unit = "vendor";
+        emit_changed (f, "/net/hadess/SensorProxy", "net.hadess.SensorProxy", "LightLevelUnit",
+                      g_variant_new_string ("vendor"));
+        set_light (f, 300, 3000);
+        spin (300);
+        g_assert_cmpuint (gsd_ambient_white_point_get_temperature (f->ambient), ==, 6500);
+}
+
+/* A directly set temperature pauses until the setting is toggled. */
+static void
+test_pause (Fixture *f, gconstpointer data)
+{
+        g_settings_set_boolean (f->settings, "ambient-white-point-enabled", TRUE);
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 5000);
+        gsd_ambient_white_point_pause (f->ambient);
+        g_assert_true (gsd_ambient_white_point_get_paused (f->ambient));
+        g_assert_cmpuint (gsd_ambient_white_point_get_temperature (f->ambient), ==, 6500);
+        WAIT_FOR (f->claims == 0);
+        spin (200);
+        g_assert_cmpuint (gsd_ambient_white_point_get_temperature (f->ambient), ==, 6500);
+
+        g_settings_set_boolean (f->settings, "ambient-white-point-enabled", FALSE);
+        g_settings_set_boolean (f->settings, "ambient-white-point-enabled", TRUE);
+        g_assert_false (gsd_ambient_white_point_get_paused (f->ambient));
+        WAIT_FOR (gsd_ambient_white_point_get_temperature (f->ambient) == 5000);
+}
+
+int
+main (int argc, char **argv)
+{
+        g_setenv ("GSETTINGS_BACKEND", "memory", TRUE);
+        g_test_init (&argc, &argv, NULL);
+        g_test_add ("/color/ambient-service/default-off", Fixture, NULL, setup, test_default_off, teardown);
+        g_test_add ("/color/ambient-service/follow-and-release", Fixture, NULL, setup, test_follow_and_release, teardown);
+        g_test_add ("/color/ambient-service/back-off", Fixture, NULL, setup, test_back_off, teardown);
+        g_test_add ("/color/ambient-service/no-colour", Fixture, NULL, setup, test_no_colour, teardown);
+        g_test_add ("/color/ambient-service/pause", Fixture, NULL, setup, test_pause, teardown);
+        return g_test_run ();
+}
diff --git a/plugins/color/ambient-test-vectors.h b/plugins/color/ambient-test-vectors.h
new file mode 100644
index 0000000..ba05f5b
--- /dev/null
+++ b/plugins/color/ambient-test-vectors.h
@@ -0,0 +1,140 @@
+/* Generated by ambient_model.py. Do not edit. */
+#pragma once
+
+#include <math.h>
+
+typedef struct { int valid; double lux; double kelvin; double expect_k; } AmbientTargetVector;
+typedef struct { int count; int releasing; int valid; double lux; double kelvin; } AmbientTickRun;
+
+static const AmbientTargetVector ambient_target_vectors[] = {
+    { 1, 600.0, 6500.0, 6500.000000 },
+    { 1, 600.0, 5400.0, 5899.159664 },
+    { 1, 600.0, 5000.0, 5652.173913 },
+    { 1, 600.0, 4929.29, 5606.714853 },
+    { 1, 600.0, 4000.0, 5000.000000 },
+    { 1, 600.0, 2700.0, 5000.000000 },
+    { 1, 600.0, 9000.0, 6500.000000 },
+    { 1, 50.0, 4000.0, 5000.000000 },

+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <gio/gio.h>
+
+#define GSD_TYPE_AMBIENT_WHITE_POINT (gsd_ambient_white_point_get_type ())
+G_DECLARE_FINAL_TYPE (GsdAmbientWhitePoint, gsd_ambient_white_point, GSD, AMBIENT_WHITE_POINT, GObject)
+
+GsdAmbientWhitePoint *gsd_ambient_white_point_new (void);
+/* Tests only: run the policy ticks faster than real time. */
+void gsd_ambient_white_point_set_tick_interval (GsdAmbientWhitePoint *self, guint ms);
+void gsd_ambient_white_point_start (GsdAmbientWhitePoint *self);
+void gsd_ambient_white_point_stop (GsdAmbientWhitePoint *self);
+/* A temperature set directly over D-Bus takes precedence until the setting
+ * is toggled. Neither persistent setting is rewritten. */
+void gsd_ambient_white_point_pause (GsdAmbientWhitePoint *self);
+gboolean gsd_ambient_white_point_get_paused (GsdAmbientWhitePoint *self);
+/* An ambient colour sensor and compositor support are both present. */
+gboolean gsd_ambient_white_point_get_available (GsdAmbientWhitePoint *self);
+/* Enabled and currently away from neutral, or moving. */
+gboolean gsd_ambient_white_point_get_active (GsdAmbientWhitePoint *self);
+/* The adapted white point in kelvin, 6500 when neutral. */
+guint gsd_ambient_white_point_get_temperature (GsdAmbientWhitePoint *self);
+/* The latest ambient reading, 0 when unknown. */
+guint gsd_ambient_white_point_get_ambient_temperature (GsdAmbientWhitePoint *self);

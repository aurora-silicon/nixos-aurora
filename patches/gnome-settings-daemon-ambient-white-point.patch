diff --git a/plugins/color/gsd-ambient-policy.c b/plugins/color/gsd-ambient-policy.c
new file mode 100644
index 0000000..b467f54
--- /dev/null
+++ b/plugins/color/gsd-ambient-policy.c
@@ -0,0 +1,206 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "gsd-ambient-policy.h"
+#include <math.h>
+#include <string.h>
+
+/* The low-light branch points (no adaptation through 10 lux, blending in to
+ * full at 15 lux, no high-lux cut-off) and the fade durations (2 s when
+ * switched on or off, 5 s when the ambient target moves) are fixed
+ * parameters of the policy. The amount of adaptation is a default that
+ * can be tuned later, applied as a
+ * fraction of the ambient shift in mired and limited to 5000 to 6500 K. The
+ * test vectors pin the behaviour. */
+const GsdAmbientModel gsd_ambient_model_default = {
+        .neutral_k = 6500,
+        .warmest_k = 5000,
+        .coolest_k = 6500,
+        .strength = 0.5,
+        .lux_low = 10,
+        .lux_full = 15,
+        .min_valid_k = 1500,
+        .max_valid_k = 20000,
+        .window_s = 10,
+        .deadband_mired = 2.5,
+        .toggle_ramp_s = 2.0,
+        .ambient_ramp_s = 5.0,
+};
+
+/* The fade is a monotone cubic through its quartiles (0.25033, 0.66672
+ * and 0.91656 of the change at a quarter, half and three quarters of the
+ * time), with Fritsch-Carlson slopes. */
+static const double ease_y[] = { 0.0, 0.25033, 0.66672, 0.91656, 1.0 };
+static const double ease_m[] = { 1.00132, 1.25072, 1.24919, 0.50040, 0.33376 };
+
+double
+gsd_ambient_ease (double x)
+{
+        double t, h = 0.25;
+        int i;
+
+        if (x <= 0)
+                return 0;
+        if (x >= 1)
+                return 1;
+        i = MIN ((int) (x * 4), 3);
+        t = (x - i * h) / h;
+        return (2 * t * t * t - 3 * t * t + 1) * ease_y[i] +
+               (t * t * t - 2 * t * t + t) * h * ease_m[i] +
+               (-2 * t * t * t + 3 * t * t) * ease_y[i + 1] +
+               (t * t * t - t * t) * h * ease_m[i + 1];
+}
+
+double
+gsd_ambient_target_mired (const GsdAmbientModel *model, gboolean valid,
+                          double lux, double kelvin)
+{
+        double neutral = gsd_ambient_mired (model->neutral_k);
+        double fraction, target;
+
+        if (!valid || !isfinite (lux) || !isfinite (kelvin) || lux < 0 ||
+            kelvin < model->min_valid_k || kelvin > model->max_valid_k)
+                return neutral;
+        if (lux <= model->lux_low)
+                return neutral;
+        fraction = CLAMP ((lux - model->lux_low) / (model->lux_full - model->lux_low), 0.0, 1.0);
+        target = neutral + model->strength * fraction * (gsd_ambient_mired (kelvin) - neutral);
+        return CLAMP (target, gsd_ambient_mired (model->coolest_k),
+                      gsd_ambient_mired (model->warmest_k));
+}
+
+void
+gsd_ambient_policy_init (GsdAmbientPolicy *policy, const GsdAmbientModel *model)
+{
+        memset (policy, 0, sizeof (*policy));
+        policy->model = *model;
+        policy->window = (guint) CLAMP (round (model->window_s / GSD_AMBIENT_TICK_S),
+                                        1, GSD_AMBIENT_MAX_SAMPLES);
+        gsd_ambient_policy_reset (policy);
+}
+
+void
+gsd_ambient_policy_reset (GsdAmbientPolicy *policy)
+{
+        policy->n_samples = 0;
+        policy->next_sample = 0;
+        policy->have_target = FALSE;
+        policy->held_mired = gsd_ambient_mired (policy->model.neutral_k);
+        policy->current_mired = policy->held_mired;
+        policy->ramp_from = policy->held_mired;
+        policy->ramp_to = policy->held_mired;
+        policy->ramp_duration = policy->model.toggle_ramp_s;
+        policy->ramp_elapsed = policy->ramp_duration;
+}
+
+void
+gsd_ambient_policy_set_current (GsdAmbientPolicy *policy, double kelvin)
+{
+        if (isfinite (kelvin) && kelvin > 0)
+                policy->current_mired = gsd_ambient_mired (kelvin);
+}
+
+static int
+compare_double (const void *a, const void *b)
+{
+        double x = *(const double *) a, y = *(const double *) b;
+        return (x > y) - (x < y);
+}
+
+static double
+median (const GsdAmbientPolicy *policy)
+{
+        double sorted[GSD_AMBIENT_MAX_SAMPLES];
+        guint n = policy->n_samples;
+
+        memcpy (sorted, policy->samples, n * sizeof (double));
+        qsort (sorted, n, sizeof (double), compare_double);
+        return n % 2 ? sorted[n / 2] : (sorted[n / 2 - 1] + sorted[n / 2]) / 2;
+}
+
+void
+gsd_ambient_policy_sample (GsdAmbientPolicy *policy, gboolean releasing,
+                           gboolean valid, double lux, double kelvin)
+{
+        const GsdAmbientModel *model = &policy->model;
+        double neutral = gsd_ambient_mired (model->neutral_k);
+        /* Switching on or off fades like a manual change; later moves use
+         * the slower ambient fade. */
+        gboolean toggle = releasing || !policy->have_target;
+
+        if (releasing) {
+                policy->n_samples = 0;
+                policy->next_sample = 0;
+                policy->have_target = FALSE;
+                policy->held_mired = neutral;
+        } else {
+                double filtered;
+                gboolean at_bound;
+
+                policy->samples[policy->next_sample] =
+                        gsd_ambient_target_mired (model, valid, lux, kelvin);
+                policy->next_sample = (policy->next_sample + 1) % policy->window;
+                policy->n_samples = MIN (policy->n_samples + 1, policy->window);
+                filtered = median (policy);
+
+                /* The deadband keeps small wobbles off the screen, but the
+                 * neutral point and the warm limit are always reachable. */
+                at_bound = filtered == neutral ||
+                           filtered == gsd_ambient_mired (model->warmest_k);
+                if (!policy->have_target || at_bound ||
+                    fabs (filtered - policy->held_mired) >= model->deadband_mired) {
+                        policy->held_mired = filtered;
+                        policy->have_target = TRUE;
+                }
+        }
+
+        /* A new target starts a fresh ramp from wherever the screen is now. */
+        if (policy->held_mired != policy->ramp_to) {
+                policy->ramp_from = policy->current_mired;
+                policy->ramp_to = policy->held_mired;
+                policy->ramp_elapsed = 0;
+                policy->ramp_duration = toggle ? model->toggle_ramp_s : model->ambient_ramp_s;
+        }
+}
+
+double
+gsd_ambient_policy_advance (GsdAmbientPolicy *policy, double seconds)
+{
+        double ramp_s = policy->ramp_duration;
+
+        /* In mired, where equal steps look about equally large, with the
+         * eased fade shape. */
+        if (policy->ramp_elapsed < ramp_s) {
+                policy->ramp_elapsed += seconds;
+                /* Finish exactly, whatever rounding the steps collected. */
+                if (policy->ramp_elapsed > ramp_s - 1e-9)
+                        policy->ramp_elapsed = ramp_s;
+                policy->current_mired = policy->ramp_from +
+                        (policy->ramp_to - policy->ramp_from) * gsd_ambient_ease (policy->ramp_elapsed / ramp_s);
+        }
+        return gsd_ambient_policy_get_kelvin (policy);
+}
+
+double
+gsd_ambient_policy_tick (GsdAmbientPolicy *policy, gboolean releasing,
+                         gboolean valid, double lux, double kelvin)
+{
+        gsd_ambient_policy_sample (policy, releasing, valid, lux, kelvin);
+        return gsd_ambient_policy_advance (policy, GSD_AMBIENT_TICK_S);
+}
+
+gboolean
+gsd_ambient_policy_is_settled (const GsdAmbientPolicy *policy)
+{
+        return policy->ramp_elapsed >= policy->ramp_duration;
+}
+
+double
+gsd_ambient_policy_get_kelvin (const GsdAmbientPolicy *policy)
+{
+        return 1e6 / policy->current_mired;
+}
+
+gboolean
+gsd_ambient_policy_is_neutral (const GsdAmbientPolicy *policy)
+{
+        return fabs (policy->current_mired - gsd_ambient_mired (policy->model.neutral_k)) < 1e-9;
+}
diff --git a/plugins/color/gsd-ambient-policy.h b/plugins/color/gsd-ambient-policy.h
new file mode 100644
index 0000000..f09f8cf
--- /dev/null
+++ b/plugins/color/gsd-ambient-policy.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ambient white point policy: maps the ambient light's correlated colour
+ * temperature and illuminance to a display white point, expressed as a
+ * colour temperature for the compositor's existing Night Light path.
+ *
+ * This file has no dependency on the rest of the plugin so that the model
+ * can be tested in isolation. KWin carries the same model with the same
+ * constants and test vectors.
+ */
+#pragma once
+#include <glib.h>
+
+typedef struct {
+        double neutral_k;          /* display native white, identity output */
+        double warmest_k;          /* never warmer than this */
+        double coolest_k;          /* never cooler than this */
+        double strength;           /* fraction of the ambient shift followed, in mired */
+        double lux_low;            /* at or below this, no adaptation */
+        double lux_full;           /* at or above this, full strength */
+        double min_valid_k;        /* sensor readings outside are ignored */
+        double max_valid_k;
+        double window_s;           /* median filter window */
+        double deadband_mired;     /* ignore target changes smaller than this */
+        double toggle_ramp_s;      /* fade when switched on or off */
+        double ambient_ramp_s;     /* fade when the ambient target moves */
+} GsdAmbientModel;
+
+extern const GsdAmbientModel gsd_ambient_model_default;
+
+#define GSD_AMBIENT_TICK_S 0.5   /* sensor sampling interval */
+#define GSD_AMBIENT_STEP_S 0.05  /* ramp update interval */
+#define GSD_AMBIENT_MAX_SAMPLES 64
+
+typedef struct {
+        GsdAmbientModel model;
+        double samples[GSD_AMBIENT_MAX_SAMPLES];
+        guint n_samples;
+        guint next_sample;
+        guint window;
+        double held_mired;
+        double current_mired;
+        double ramp_from;
+        double ramp_to;
+        double ramp_elapsed;
+        double ramp_duration;
+        gboolean have_target;
+} GsdAmbientPolicy;
+
+static inline double
+gsd_ambient_mired (double kelvin)
+{
+        return 1e6 / kelvin;
+}
+
+/* Instantaneous target, in mired, for one sensor reading. Invalid input
+ * (no colour temperature, not lux, non-finite) gives the neutral point. */
+double gsd_ambient_target_mired (const GsdAmbientModel *model, gboolean valid,
+                                 double lux, double kelvin);
+
+void gsd_ambient_policy_init (GsdAmbientPolicy *policy, const GsdAmbientModel *model);
+/* Forget all samples and jump to neutral. */
+void gsd_ambient_policy_reset (GsdAmbientPolicy *policy);
+/* Start from an explicit temperature, e.g. the one already on screen. */
+void gsd_ambient_policy_set_current (GsdAmbientPolicy *policy, double kelvin);
+/* Takes one sensor sample (every GSD_AMBIENT_TICK_S) and starts a ramp to
+ * a new target when it moves. When releasing, the target is neutral and the
+ * sensor is ignored. */
+void gsd_ambient_policy_sample (GsdAmbientPolicy *policy, gboolean releasing,
+                                gboolean valid, double lux, double kelvin);
+/* The fade shape, 0 to 1 over normalised time 0 to 1. */
+double gsd_ambient_ease (double x);
+/* Moves along the current ramp by @seconds. Returns kelvin. */
+double gsd_ambient_policy_advance (GsdAmbientPolicy *policy, double seconds);
+/* A sample followed by a whole sampling interval of ramp. Returns kelvin. */
+double gsd_ambient_policy_tick (GsdAmbientPolicy *policy, gboolean releasing,
+                                gboolean valid, double lux, double kelvin);
+/* No ramp in progress. */
+gboolean gsd_ambient_policy_is_settled (const GsdAmbientPolicy *policy);
+double gsd_ambient_policy_get_kelvin (const GsdAmbientPolicy *policy);
+gboolean gsd_ambient_policy_is_neutral (const GsdAmbientPolicy *policy);
+
+/* Night Light composition: Night Light always wins, ambient adaptation can
+ * never make the screen cooler than Night Light asks for. The warmer of the
+ * two is used, which also makes hand-overs continuous. */
+static inline double
+gsd_ambient_compose (double night_k, double ambient_k)
+{
+        return MIN (night_k, ambient_k);
+}

+/* Publish one effective temperature, which mutter applies to every output
+ * through its Night Light path. Night Light always wins: the screen gets the
+ * warmer of the Night Light and ambient temperatures, so the ambient white
+ * point never makes it cooler than Night Light asks for, and Night Light's
+ * fades, including a preview's, start from what is on screen. A temperature
+ * set directly over D-Bus pauses the ambient white point until it is
+ * toggled. */
+static void
+update_temperature (GsdColorManager *manager, gboolean night_changed)
+{
+        GsdAmbientWhitePoint *ambient = manager->ambient;
+        gdouble night = gsd_night_light_get_temperature (manager->nlight);
+        gdouble ambient_k = gsd_ambient_white_point_get_temperature (ambient);
+        gboolean available = gsd_ambient_white_point_get_available (ambient);
+        guint color_temperature = gsd_ambient_white_point_get_ambient_temperature (ambient);
+        gboolean active;
+        guint temperature;
+
+        if (gsd_ambient_white_point_get_paused (ambient)) {
+                /* Keep the directly set temperature until Night Light
+                 * itself changes, as without the ambient white point. */
+                active = FALSE;
+                temperature = night_changed ? (guint) round (night)
+                                            : gsd_color_state_get_temperature (manager->state);
+        } else {
+                active = gsd_ambient_white_point_get_active (ambient) && ambient_k < night;
+                temperature = (guint) round (gsd_ambient_compose (night, ambient_k));
+        }
+
+        if (manager->ambient_available != available) {
+                manager->ambient_available = available;
+                emit_property_changed (manager, "AmbientWhitePointAvailable",
+                                       g_variant_new_boolean (available));
+        }
+        if (manager->ambient_active != active) {
+                manager->ambient_active = active;
+                emit_property_changed (manager, "AmbientWhitePointActive",
+                                       g_variant_new_boolean (active));
+        }
+        if (manager->ambient_color_temperature != color_temperature) {
+                manager->ambient_color_temperature = color_temperature;
+                emit_property_changed (manager, "AmbientColorTemperature",
+                                       g_variant_new_uint32 (color_temperature));
+        }
+        if (manager->ambient_temperature != (guint) ambient_k) {
+                manager->ambient_temperature = (guint) ambient_k;
+                emit_property_changed (manager, "AmbientWhitePointTemperature",
+                                       g_variant_new_uint32 ((guint) ambient_k));
+        }
+        if (gsd_color_state_get_temperature (manager->state) != temperature) {
+                gsd_color_state_set_temperature (manager->state, temperature);
+                emit_property_changed (manager, "Temperature", g_variant_new_uint32 (temperature));
+        }
+}
+
+static void
+on_ambient_changed (GsdAmbientWhitePoint *ambient, gpointer user_data)
+{
+        update_temperature (GSD_COLOR_MANAGER (user_data), FALSE);
+}
+
+static void
+on_forced_notify (GsdNightLight *nlight, GParamSpec *pspec, gpointer user_data)
+{
+        update_temperature (GSD_COLOR_MANAGER (user_data), TRUE);
+}
+
 static void
 on_active_notify (GsdNightLight *nlight,
                   GParamSpec      *pspec,
                   gpointer         user_data)
 {
         GsdColorManager *manager = GSD_COLOR_MANAGER (user_data);
+        update_temperature (manager, TRUE);
         emit_property_changed (manager, "NightLightActive",

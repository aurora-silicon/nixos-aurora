@@ -0,0 +1,422 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ambient white point. The ambient light's colour temperature and
+ * illuminance come from iio-sensor-proxy (the same light claim gsd-power
+ * uses for automatic brightness), the policy picks a display white point,
+ * and the colour manager publishes it through the existing Temperature
+ * property that mutter applies for Night Light.
+ */
+#include "gsd-ambient-white-point.h"
+#include "gsd-ambient-policy.h"
+#include <math.h>
+
+#define SENSOR_PROXY_NAME  "net.hadess.SensorProxy"
+#define SENSOR_PROXY_PATH  "/net/hadess/SensorProxy"
+#define DISPLAY_CONFIG_NAME "org.gnome.Mutter.DisplayConfig"
+#define DISPLAY_CONFIG_PATH "/org/gnome/Mutter/DisplayConfig"
+
+struct _GsdAmbientWhitePoint {
+        GObject parent;
+        GSettings *settings;
+        GsdAmbientPolicy policy;
+
+        guint sensor_watch;
+        GDBusProxy *sensor;
+        GCancellable *sensor_cancellable;
+        gboolean claimed;
+
+        guint display_watch;
+        GDBusProxy *display;
+        GCancellable *display_cancellable;
+        gboolean supported;
+
+        guint timer;
+        guint ramp_timer;
+        guint tick_ms;
+        guint step_ms;
+        gboolean running;
+        gboolean paused;
+};
+G_DEFINE_TYPE (GsdAmbientWhitePoint, gsd_ambient_white_point, G_TYPE_OBJECT)
+
+static guint changed_signal;
+static void update (GsdAmbientWhitePoint *self);
+
+static gboolean
+enabled (GsdAmbientWhitePoint *self)
+{
+        return g_settings_get_boolean (self->settings, "ambient-white-point-enabled");
+}
+
+static gboolean
+get_double (GDBusProxy *proxy, const char *name, double *value)
+{
+        g_autoptr(GVariant) variant = proxy ? g_dbus_proxy_get_cached_property (proxy, name) : NULL;
+
+        if (!variant || !g_variant_is_of_type (variant, G_VARIANT_TYPE_DOUBLE))
+                return FALSE;
+        *value = g_variant_get_double (variant);
+        return isfinite (*value);
+}
+
+static gboolean
+get_boolean (GDBusProxy *proxy, const char *name)
+{
+        g_autoptr(GVariant) variant = proxy ? g_dbus_proxy_get_cached_property (proxy, name) : NULL;
+
+        return variant && g_variant_is_of_type (variant, G_VARIANT_TYPE_BOOLEAN) &&
+               g_variant_get_boolean (variant);
+}
+
+/* A usable reading needs lux (not a vendor scale, which the lux limits
+ * cannot interpret) and a colour temperature. */
+static gboolean
+read_sensor (GsdAmbientWhitePoint *self, double *lux, double *kelvin)
+{
+        g_autoptr(GVariant) unit = NULL;
+
+        if (!self->claimed || !get_boolean (self->sensor, "HasAmbientLight"))
+                return FALSE;
+        unit = g_dbus_proxy_get_cached_property (self->sensor, "LightLevelUnit");
+        if (!unit || !g_variant_is_of_type (unit, G_VARIANT_TYPE_STRING) ||
+            g_strcmp0 (g_variant_get_string (unit, NULL), "lux") != 0)
+                return FALSE;
+        return get_double (self->sensor, "LightLevel", lux) &&
+               get_double (self->sensor, "ColorTemperature", kelvin) && *kelvin > 0;
+}
+
+static gboolean
+wanted (GsdAmbientWhitePoint *self)
+{
+        return self->running && enabled (self) && !self->paused && self->supported &&
+               self->sensor && get_boolean (self->sensor, "HasAmbientLight");
+}
+
+static void
+claim (GsdAmbientWhitePoint *self, gboolean value)
+{
+        if (self->claimed == value || !self->sensor)
+                return;
+        self->claimed = value;
+        g_dbus_proxy_call (self->sensor, value ? "ClaimLight" : "ReleaseLight",
+                           NULL, G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL, NULL);
+}
+
+static gboolean
+ramp_step (gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+        guint before = gsd_ambient_white_point_get_temperature (self);
+
+        gsd_ambient_policy_advance (&self->policy, GSD_AMBIENT_STEP_S);
+        if (gsd_ambient_white_point_get_temperature (self) != before)
+                g_signal_emit (self, changed_signal, 0);
+        if (!gsd_ambient_policy_is_settled (&self->policy))
+                return G_SOURCE_CONTINUE;
+        self->ramp_timer = 0;
+        return G_SOURCE_REMOVE;
+}
+
+/* Samples the sensor; a new target starts a short ramp at a finer step. Once
+ * switched off and back at neutral, it stops and releases the sensor. */
+static gboolean
+tick (gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+        gboolean want = wanted (self);
+        double lux = 0, kelvin = 0;
+        gboolean valid = want && read_sensor (self, &lux, &kelvin);
+
+        gsd_ambient_policy_sample (&self->policy, !want, valid, lux, kelvin);
+        if (!gsd_ambient_policy_is_settled (&self->policy) && self->ramp_timer == 0) {
+                self->ramp_timer = g_timeout_add (self->step_ms, ramp_step, self);
+                g_source_set_name_by_id (self->ramp_timer, "[gnome-settings-daemon] ambient white point ramp");
+        }
+        if (!want && gsd_ambient_policy_is_settled (&self->policy) &&
+            gsd_ambient_policy_is_neutral (&self->policy)) {
+                gsd_ambient_policy_reset (&self->policy);
+                claim (self, FALSE);
+                self->timer = 0;
+                g_signal_emit (self, changed_signal, 0);
+                return G_SOURCE_REMOVE;
+        }
+        return G_SOURCE_CONTINUE;
+}
+
+/* Re-evaluate after any input change: claim the sensor and run the policy
+ * while wanted, or let the policy return to neutral and then release. */
+static void
+update (GsdAmbientWhitePoint *self)
+{
+        if (wanted (self))
+                claim (self, TRUE);
+        if (self->timer == 0 && (wanted (self) || !gsd_ambient_policy_is_neutral (&self->policy))) {
+                self->timer = g_timeout_add (self->tick_ms, tick, self);
+                g_source_set_name_by_id (self->timer, "[gnome-settings-daemon] ambient white point");
+        }
+        if (!wanted (self))
+                claim (self, FALSE);
+        g_signal_emit (self, changed_signal, 0);
+}
+
+static void
+sensor_properties_changed (GDBusProxy *proxy, GVariant *changed, GStrv invalidated, gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+        g_autoptr(GVariant) has = g_variant_lookup_value (changed, "HasAmbientLight", NULL);
+
+        /* Readings are sampled by the timer; only availability matters here. */
+        if (has)
+                update (self);
+        else
+                g_signal_emit (self, changed_signal, 0);
+}
+
+static void
+sensor_proxy_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+        g_autoptr(GError) error = NULL;
+        GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+        GsdAmbientWhitePoint *self;
+
+        if (!proxy) {
+                if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+                        g_warning ("Failed to connect to iio-sensor-proxy: %s", error->message);
+                return;
+        }
+        self = data;
+        self->sensor = proxy;
+        self->claimed = FALSE;
+        g_signal_connect (proxy, "g-properties-changed", G_CALLBACK (sensor_properties_changed), self);
+        update (self);
+}
+
+static void
+sensor_appeared (GDBusConnection *connection, const char *name, const char *owner, gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+
+        g_cancellable_cancel (self->sensor_cancellable);
+        g_clear_object (&self->sensor_cancellable);
+        self->sensor_cancellable = g_cancellable_new ();
+        g_dbus_proxy_new (connection, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL,
+                          SENSOR_PROXY_NAME, SENSOR_PROXY_PATH, SENSOR_PROXY_NAME,
+                          self->sensor_cancellable, sensor_proxy_ready, self);
+}
+
+static void
+sensor_vanished (GDBusConnection *connection, const char *name, gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+
+        if (self->sensor)
+                g_signal_handlers_disconnect_by_data (self->sensor, self);
+        g_clear_object (&self->sensor);
+        /* The daemon dropped our claim along with its connection. */
+        self->claimed = FALSE;
+        update (self);
+}
+
+static void
+display_properties_changed (GDBusProxy *proxy, GVariant *changed, GStrv invalidated, gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+        g_autoptr(GVariant) value = g_variant_lookup_value (changed, "NightLightSupported", NULL);
+
+        if (value || g_strv_contains ((const char * const *) invalidated, "NightLightSupported")) {
+                self->supported = get_boolean (proxy, "NightLightSupported");
+                update (self);
+        }
+}
+
+static void
+display_proxy_ready (GObject *source, GAsyncResult *result, gpointer data)
+{
+        g_autoptr(GError) error = NULL;
+        GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (result, &error);
+        GsdAmbientWhitePoint *self;
+
+        if (!proxy) {
+                if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+                        g_warning ("Failed to connect to the compositor: %s", error->message);
+                return;
+        }
+        self = data;
+        self->display = proxy;
+        self->supported = get_boolean (proxy, "NightLightSupported");
+        g_signal_connect (proxy, "g-properties-changed", G_CALLBACK (display_properties_changed), self);
+        update (self);
+}
+
+static void
+display_appeared (GDBusConnection *connection, const char *name, const char *owner, gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+
+        g_cancellable_cancel (self->display_cancellable);
+        g_clear_object (&self->display_cancellable);
+        self->display_cancellable = g_cancellable_new ();
+        g_dbus_proxy_new (connection, G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START, NULL,
+                          DISPLAY_CONFIG_NAME, DISPLAY_CONFIG_PATH, DISPLAY_CONFIG_NAME,
+                          self->display_cancellable, display_proxy_ready, self);
+}
+
+static void
+display_vanished (GDBusConnection *connection, const char *name, gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+
+        if (self->display)
+                g_signal_handlers_disconnect_by_data (self->display, self);
+        g_clear_object (&self->display);
+        self->supported = FALSE;
+        /* Nothing is applying the temperature any more; start over from
+         * neutral when the compositor returns. */
+        gsd_ambient_policy_reset (&self->policy);
+        update (self);
+}
+
+static void
+setting_changed (GSettings *settings, const char *key, gpointer data)
+{
+        GsdAmbientWhitePoint *self = data;
+
+        self->paused = FALSE;
+        update (self);
+}
+
+void
+gsd_ambient_white_point_start (GsdAmbientWhitePoint *self)
+{
+        if (self->running)
+                return;
+        self->running = TRUE;
+        self->sensor_watch = g_bus_watch_name (G_BUS_TYPE_SYSTEM, SENSOR_PROXY_NAME,
+                                               G_BUS_NAME_WATCHER_FLAGS_NONE,
+                                               sensor_appeared, sensor_vanished, self, NULL);
+        self->display_watch = g_bus_watch_name (G_BUS_TYPE_SESSION, DISPLAY_CONFIG_NAME,
+                                                G_BUS_NAME_WATCHER_FLAGS_NONE,
+                                                display_appeared, display_vanished, self, NULL);
+}
+
+void
+gsd_ambient_white_point_stop (GsdAmbientWhitePoint *self)
+{
+        if (!self->running)
+                return;
+        self->running = FALSE;
+        g_clear_handle_id (&self->sensor_watch, g_bus_unwatch_name);
+        g_clear_handle_id (&self->display_watch, g_bus_unwatch_name);
+        g_clear_handle_id (&self->timer, g_source_remove);
+        g_clear_handle_id (&self->ramp_timer, g_source_remove);
+        claim (self, FALSE);
+        g_cancellable_cancel (self->sensor_cancellable);
+        g_clear_object (&self->sensor_cancellable);
+        g_cancellable_cancel (self->display_cancellable);
+        g_clear_object (&self->display_cancellable);
+        if (self->sensor)
+                g_signal_handlers_disconnect_by_data (self->sensor, self);
+        g_clear_object (&self->sensor);
+        if (self->display)
+                g_signal_handlers_disconnect_by_data (self->display, self);
+        g_clear_object (&self->display);
+        self->supported = FALSE;
+        gsd_ambient_policy_reset (&self->policy);
+        g_signal_emit (self, changed_signal, 0);
+}
+
+void
+gsd_ambient_white_point_pause (GsdAmbientWhitePoint *self)
+{
+        if (self->paused)
+                return;
+        self->paused = TRUE;
+        g_clear_handle_id (&self->timer, g_source_remove);
+        g_clear_handle_id (&self->ramp_timer, g_source_remove);
+        gsd_ambient_policy_reset (&self->policy);
+        claim (self, FALSE);
+        g_signal_emit (self, changed_signal, 0);
+}
+
+gboolean
+gsd_ambient_white_point_get_paused (GsdAmbientWhitePoint *self)
+{
+        return self->paused;
+}
+
+gboolean
+gsd_ambient_white_point_get_available (GsdAmbientWhitePoint *self)
+{
+        double kelvin;
+
+        /* The colour temperature is only known while the light is claimed,
+         * so availability is reported once a reading has arrived. */
+        return self->running && self->supported && get_boolean (self->sensor, "HasAmbientLight") &&
+               get_double (self->sensor, "ColorTemperature", &kelvin) && kelvin > 0;
+}
+
+gboolean
+gsd_ambient_white_point_get_active (GsdAmbientWhitePoint *self)
+{
+        return !self->paused && !gsd_ambient_policy_is_neutral (&self->policy);
+}
+
+guint
+gsd_ambient_white_point_get_temperature (GsdAmbientWhitePoint *self)
+{
+        if (self->paused)
+                return 6500;
+        return (guint) round (gsd_ambient_policy_get_kelvin (&self->policy));
+}
+
+guint
+gsd_ambient_white_point_get_ambient_temperature (GsdAmbientWhitePoint *self)
+{
+        double kelvin;
+
+        if (!self->claimed || !get_double (self->sensor, "ColorTemperature", &kelvin) || kelvin <= 0)
+                return 0;
+        return (guint) round (kelvin);
+}
+
+static void
+gsd_ambient_white_point_dispose (GObject *object)
+{
+        GsdAmbientWhitePoint *self = GSD_AMBIENT_WHITE_POINT (object);
+
+        gsd_ambient_white_point_stop (self);
+        g_clear_object (&self->settings);
+        G_OBJECT_CLASS (gsd_ambient_white_point_parent_class)->dispose (object);
+}
+
+static void
+gsd_ambient_white_point_class_init (GsdAmbientWhitePointClass *klass)
+{
+        G_OBJECT_CLASS (klass)->dispose = gsd_ambient_white_point_dispose;
+        changed_signal = g_signal_new ("changed", G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST,
+                                       0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+}
+
+static void
+gsd_ambient_white_point_init (GsdAmbientWhitePoint *self)
+{
+        gsd_ambient_policy_init (&self->policy, &gsd_ambient_model_default);
+        self->tick_ms = (guint) (GSD_AMBIENT_TICK_S * 1000);
+        self->step_ms = (guint) (GSD_AMBIENT_STEP_S * 1000);
+        self->settings = g_settings_new ("org.gnome.settings-daemon.plugins.color");
+        g_signal_connect (self->settings, "changed::ambient-white-point-enabled",
+                          G_CALLBACK (setting_changed), self);
+}
+
+void
+gsd_ambient_white_point_set_tick_interval (GsdAmbientWhitePoint *self, guint ms)
+{
+        self->tick_ms = ms;
+        self->step_ms = MAX (1, ms / 10);
+}
+
+GsdAmbientWhitePoint *
+gsd_ambient_white_point_new (void)
+{
+        return g_object_new (GSD_TYPE_AMBIENT_WHITE_POINT, NULL);
+}

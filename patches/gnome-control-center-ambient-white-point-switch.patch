+/* The ambient white point row is shown when gnome-settings-daemon knows the
+ * setting and the computer has a light sensor that reports colour: an IIO
+ * device with a colour temperature channel, or gnome-settings-daemon already
+ * reading one. */
+static gboolean
+ambient_white_point_sensor_present (void)
+{
+  g_autoptr(GDir) dir = NULL;
+  const gchar *name;
+
+  dir = g_dir_open ("/sys/bus/iio/devices", 0, NULL);
+  if (dir == NULL)
+    return FALSE;
+  while ((name = g_dir_read_name (dir)) != NULL)
+    {
+      g_autofree gchar *path = g_build_filename ("/sys/bus/iio/devices", name,
+                                                 "in_colortemp_input", NULL);
+      if (g_file_test (path, G_FILE_TEST_EXISTS))
+        return TRUE;
+    }
+  return FALSE;
+}
+
 static void
+ambient_white_point_update_visibility (CcNightLightPage *self)
+{
+  gboolean available = FALSE;
+
+  if (self->ambient_white_point_has_key && self->proxy_color != NULL)
+    {
+      g_autoptr(GVariant) value = NULL;
+      value = g_dbus_proxy_get_cached_property (self->proxy_color,
+                                                "AmbientWhitePointAvailable");
+      if (value != NULL && g_variant_is_of_type (value, G_VARIANT_TYPE_BOOLEAN))
+        available = g_variant_get_boolean (value);
+    }
+  if (self->ambient_white_point_has_key && self->ambient_white_point_sensor)
+    available = TRUE;
+  gtk_widget_set_visible (GTK_WIDGET (self->ambient_white_point_group), available);
+}
+
+static void
 dialog_update_state (CcNightLightPage *self)
 {

 	return drv_check_udev_sensor_type (device, "iio-poll-als", "IIO poll als");
 }
 
+static gdouble
+read_color_temperature (const char *path)
+{
+	g_autofree char *contents = NULL;
+	g_autoptr(GError) error = NULL;
+	gdouble kelvin;
+	char *end;
+
+	if (!g_file_get_contents (path, &contents, NULL, &error)) {
+		g_debug ("Failed to read colour temperature from %s: %s", path, error->message);
+		return 0.0;
+	}
+	kelvin = g_ascii_strtod (contents, &end);
+	if (end == contents || !isfinite (kelvin) || kelvin <= 0.0)
+		return 0.0;
+	return kelvin;
+}

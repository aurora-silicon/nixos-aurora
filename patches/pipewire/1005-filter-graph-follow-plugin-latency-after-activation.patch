@@ -0,0 +1,183 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Aurora Silicon */
+/* SPDX-License-Identifier: MIT */
+
+/* The filter-graph must keep the published graph latency in step with what its
+ * plugins report. Plugins write their latency port from run(), so the value at
+ * activation is 0; once the plugin has run, the graph latency has to follow,
+ * and nothing should be emitted while it stays the same. */
+
+#include <stdlib.h>
+#include <time.h>
+#include <dirent.h>
+
+#include "pwtest.h"
+
+#include <pipewire/pipewire.h>
+#include <spa/filter-graph/filter-graph.h>
+#include <spa/param/audio/raw.h>
+#include <spa/utils/dict.h>
+#include <spa/utils/string.h>
+
+struct data {
+	int n_info;
+	int n_latency;
+	double latency;
+};
+
+static void graph_info(void *object, const struct spa_filter_graph_info *info)
+{
+	struct data *d = object;
+	uint32_t i;
+
+	d->n_info++;
+	for (i = 0; info->props && i < info->props->n_items; i++) {
+		if (spa_streq(info->props->items[i].key, "latency")) {
+			d->latency = atof(info->props->items[i].value);
+			d->n_latency++;
+		}
+	}
+}
+
+static const struct spa_filter_graph_events graph_events = {
+	SPA_VERSION_FILTER_GRAPH_EVENTS,
+	.info = graph_info,
+};
+
+static void run_loop(struct pw_loop *loop, int msec)
+{
+	struct timespec start, now;
+	clock_gettime(CLOCK_MONOTONIC, &start);
+	do {
+		pw_loop_iterate(loop, 50);
+		clock_gettime(CLOCK_MONOTONIC, &now);
+	} while ((now.tv_sec - start.tv_sec) * 1000 + (now.tv_nsec - start.tv_nsec) / 1000000 < msec);
+}
+
+static int count_fds(void)
+{
+	DIR *dir = opendir("/proc/self/fd");
+	struct dirent *e;
+	int n = 0;
+
+	pwtest_ptr_notnull(dir);
+	while ((e = readdir(dir)) != NULL)
+		if (e->d_name[0] != '.')
+			n++;
+	closedir(dir);
+	return n;
+}
+
+static void process(struct spa_filter_graph *graph, uint32_t n_samples)
+{
+	static float in[256], out[256];
+	const void *ins[1] = { in };
+	void *outs[1] = { out };
+	pwtest_int_eq(spa_filter_graph_process(graph, ins, outs, n_samples), 0);
+}
+
+PWTEST(filter_graph_latency_follows_plugin)
+{
+	struct pw_main_loop *ml;
+	struct pw_loop *loop;
+	struct pw_context *context;
+	struct pw_properties *props;
+	struct spa_handle *handle;
+	struct spa_filter_graph *graph = NULL;
+	struct spa_hook listener;
+	struct data d = { 0 };
+	int n;
+
+	pw_init(0, NULL);
+	ml = pw_main_loop_new(NULL);
+	pwtest_ptr_notnull(ml);
+	loop = pw_main_loop_get_loop(ml);
+	context = pw_context_new(loop, pw_properties_new(PW_KEY_CONFIG_NAME, "null", NULL), 0);
+	pwtest_ptr_notnull(context);
+
+	props = pw_properties_new(
+			SPA_KEY_LIBRARY_NAME, "filter-graph/libspa-filter-graph",
+			"clock.quantum-limit", "256",
+			"filter-graph.n_inputs", "1",
+			"filter-graph.n_outputs", "1",
+			NULL);
+	pw_properties_set(props, "filter.graph",
+			"{ nodes = [ { type = ladspa name = step label = latency_step "
+			"plugin = \"" LATENCY_STEP_PLUGIN "\" } ] }");
+	handle = pw_context_load_spa_handle(context, "filter.graph", &props->dict);
+	pw_properties_free(props);
+	pwtest_ptr_notnull(handle);
+	pwtest_neg_errno_ok(spa_handle_get_interface(handle,
+				SPA_TYPE_INTERFACE_FilterGraph, (void **)&graph));
+	pwtest_ptr_notnull(graph);
+
+	spa_filter_graph_add_listener(graph, &listener, &graph_events, &d);
+
+	props = pw_properties_new(SPA_KEY_AUDIO_RATE, "48000", NULL);
+	pwtest_neg_errno_ok(spa_filter_graph_activate(graph, &props->dict));
+	pw_properties_free(props);
+
+	/* the plugin has not run yet: nothing to report */
+	run_loop(loop, 300);
+	pwtest_double_eq(d.latency, 0.0);
+
+	/* its first run sets 64 frames, which the graph must now publish */
+	process(graph, 256);
+	run_loop(loop, 300);
+	pwtest_double_eq(d.latency, 64.0);
+
+	/* the second run moves it to 128: exactly one new info */
+	n = d.n_latency;
+	process(graph, 256);
+	run_loop(loop, 300);
+	pwtest_double_eq(d.latency, 128.0);
+	pwtest_int_eq(d.n_latency, n + 1);
+
+	n = d.n_latency;
+	process(graph, 256);
+	run_loop(loop, 300);
+	pwtest_double_eq(d.latency, 128.0);
+	pwtest_int_eq(d.n_latency, n);
+
+	/* a new activation makes new plugin instances. The port still holds 128
+	 * from the old instance until the new one runs and writes 64: the graph
+	 * must follow it (a stale value is what made shairport-sync play early). */
+	pwtest_neg_errno_ok(spa_filter_graph_deactivate(graph));
+	props = pw_properties_new(SPA_KEY_AUDIO_RATE, "48000", NULL);
+	pwtest_neg_errno_ok(spa_filter_graph_activate(graph, &props->dict));
+	pw_properties_free(props);
+	run_loop(loop, 300);
+	pwtest_double_eq(d.latency, 128.0);
+	process(graph, 256);
+	run_loop(loop, 300);
+	pwtest_double_eq(d.latency, 64.0);
+
+	/* deactivate/activate cycles must not leave event sources behind */
+	pwtest_neg_errno_ok(spa_filter_graph_deactivate(graph));
+	n = count_fds();
+	for (int i = 0; i < 5; i++) {
+		props = pw_properties_new(SPA_KEY_AUDIO_RATE, "48000", NULL);
+		pwtest_neg_errno_ok(spa_filter_graph_activate(graph, &props->dict));
+		pw_properties_free(props);
+		process(graph, 256);
+		run_loop(loop, 100);
+		pwtest_neg_errno_ok(spa_filter_graph_deactivate(graph));
+	}
+	pwtest_int_eq(count_fds(), n);
+	run_loop(loop, 200);
+
+	spa_hook_remove(&listener);
+	pw_unload_spa_handle(handle);
+	pw_context_destroy(context);
+	pw_main_loop_destroy(ml);
+	pw_deinit();
+
+	return PWTEST_PASS;
+}
+
+PWTEST_SUITE(filter_graph_latency)
+{
+	pwtest_add(filter_graph_latency_follows_plugin, PWTEST_NOARG);
+
+	return PWTEST_PASS;
+}

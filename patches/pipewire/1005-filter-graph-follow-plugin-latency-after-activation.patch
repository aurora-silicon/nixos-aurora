diff --git a/test/test-filter-graph-latency-plugin.c b/test/test-filter-graph-latency-plugin.c
new file mode 100644
index 0000000..2f8c981
--- /dev/null
+++ b/test/test-filter-graph-latency-plugin.c
@@ -0,0 +1,77 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Aurora Silicon */
+/* SPDX-License-Identifier: MIT */
+
+/* A LADSPA plugin for test-filter-graph-latency. Like real plugins (LSP, for
+ * example) it only writes its "latency" output port from run(): it reports 0
+ * until it has run, 64 frames after its first run and 128 after that. */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "ladspa.h"
+
+struct step {
+	LADSPA_Data *in, *out, *latency;
+	unsigned long runs;
+};
+
+static LADSPA_Handle step_instantiate(const LADSPA_Descriptor *d, unsigned long rate)
+{
+	return calloc(1, sizeof(struct step));
+}
+
+static void step_connect(LADSPA_Handle h, unsigned long port, LADSPA_Data *data)
+{
+	struct step *s = h;
+	switch (port) {
+	case 0: s->in = data; break;
+	case 1: s->out = data; break;
+	case 2: s->latency = data; break;
+	}
+}
+
+static void step_run(LADSPA_Handle h, unsigned long n_samples)
+{
+	struct step *s = h;
+	if (s->in && s->out)
+		memcpy(s->out, s->in, n_samples * sizeof(LADSPA_Data));
+	s->runs++;
+	if (s->latency)
+		*s->latency = s->runs == 1 ? 64.0f : 128.0f;
+}
+
+static void step_cleanup(LADSPA_Handle h)
+{
+	free(h);
+}
+
+static const LADSPA_PortDescriptor step_port_desc[] = {
+	LADSPA_PORT_INPUT | LADSPA_PORT_AUDIO,
+	LADSPA_PORT_OUTPUT | LADSPA_PORT_AUDIO,
+	LADSPA_PORT_OUTPUT | LADSPA_PORT_CONTROL,
+};
+static const char * const step_port_names[] = { "In", "Out", "latency" };
+static const LADSPA_PortRangeHint step_port_hints[] = { { 0, 0, 0 }, { 0, 0, 0 }, { 0, 0, 0 } };
+
+static const LADSPA_Descriptor step_desc = {
+	.UniqueID = 0x7e57,
+	.Label = "latency_step",
+	.Name = "Latency that changes after the first run",
+	.Maker = "PipeWire test",
+	.Copyright = "MIT",
+	.PortCount = 3,
+	.PortDescriptors = step_port_desc,
+	.PortNames = step_port_names,
+	.PortRangeHints = step_port_hints,
+	.instantiate = step_instantiate,
+	.connect_port = step_connect,
+	.run = step_run,
+	.cleanup = step_cleanup,
+};
+
+__attribute__((visibility("default")))
+const LADSPA_Descriptor *ladspa_descriptor(unsigned long index)
+{
+	return index == 0 ? &step_desc : NULL;
+}

diff --git a/test/test-filter-graph-volume.c b/test/test-filter-graph-volume.c
new file mode 100644
index 0000000..8abe4eb
--- /dev/null
+++ b/test/test-filter-graph-volume.c
@@ -0,0 +1,193 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Aurora Silicon */
+/* SPDX-License-Identifier: MIT */
+
+/* When the graph carries the volume on one of its controls (capture.volumes),
+ * the software volume after it must stay at unity for every Props update that
+ * mentions a volume or mute, also when nothing changed. Otherwise the
+ * converter applies the channel volumes a second time. A graph without
+ * volume controls passes softVolumes on unmodified. */
+
+#include "pwtest.h"
+
+#include <pipewire/pipewire.h>
+#include <spa/filter-graph/filter-graph.h>
+#include <spa/param/audio/raw.h>
+#include <spa/param/props.h>
+#include <spa/pod/builder.h>
+#include <spa/pod/iter.h>
+#include <spa/utils/string.h>
+
+struct data {
+	int n_apply;
+	uint32_t n_soft;
+	float soft[8];
+	bool have_soft_mute;
+	bool soft_mute;
+};
+
+static void apply_props(void *object, enum spa_direction direction, const struct spa_pod *props)
+{
+	struct data *d = object;
+	const struct spa_pod_object *obj = (const struct spa_pod_object *)props;
+	const struct spa_pod_prop *prop;
+
+	d->n_apply++;
+	d->n_soft = 0;
+	d->have_soft_mute = false;
+	SPA_POD_OBJECT_FOREACH(obj, prop) {
+		switch (prop->key) {
+		case SPA_PROP_softVolumes:
+			d->n_soft = spa_pod_copy_array(&prop->value, SPA_TYPE_Float,
+					d->soft, SPA_N_ELEMENTS(d->soft));
+			break;
+		case SPA_PROP_softMute:
+			if (spa_pod_get_bool(&prop->value, &d->soft_mute) == 0)
+				d->have_soft_mute = true;
+			break;
+		}
+	}
+}
+
+static const struct spa_filter_graph_events graph_events = {
+	SPA_VERSION_FILTER_GRAPH_EVENTS,
+	.apply_props = apply_props,
+};
+
+/* Props with any of: channel volume (vol >= 0), soft volume (soft >= 0), mute (mute >= 0) */
+static void set_props(struct spa_filter_graph *graph, float vol, float soft, int mute)
+{
+	uint8_t buffer[1024];
+	struct spa_pod_builder b = SPA_POD_BUILDER_INIT(buffer, sizeof(buffer));
+	struct spa_pod_frame f;
+	const struct spa_pod *props;
+
+	spa_pod_builder_push_object(&b, &f, SPA_TYPE_OBJECT_Props, SPA_PARAM_Props);
+	if (vol >= 0.0f) {
+		spa_pod_builder_prop(&b, SPA_PROP_channelVolumes, 0);
+		spa_pod_builder_array(&b, sizeof(float), SPA_TYPE_Float, 1, &vol);
+	}
+	if (soft >= 0.0f) {
+		spa_pod_builder_prop(&b, SPA_PROP_softVolumes, 0);
+		spa_pod_builder_array(&b, sizeof(float), SPA_TYPE_Float, 1, &soft);
+	}
+	if (mute >= 0) {
+		spa_pod_builder_prop(&b, SPA_PROP_mute, 0);
+		spa_pod_builder_bool(&b, mute != 0);
+	}
+	props = spa_pod_builder_pop(&b, &f);
+	pwtest_neg_errno_ok(spa_filter_graph_set_props(graph, SPA_DIRECTION_INPUT, props));
+}
+
+static struct spa_handle *load_graph(struct pw_context *context, const char *graph_json,
+		struct spa_filter_graph **graph)
+{
+	struct pw_properties *props;
+	struct spa_handle *handle;
+
+	props = pw_properties_new(
+			SPA_KEY_LIBRARY_NAME, "filter-graph/libspa-filter-graph",
+			"clock.quantum-limit", "256",
+			"filter-graph.n_inputs", "1",
+			"filter-graph.n_outputs", "1",
+			NULL);
+	pw_properties_set(props, "filter.graph", graph_json);
+	handle = pw_context_load_spa_handle(context, "filter.graph", &props->dict);
+	pw_properties_free(props);
+	pwtest_ptr_notnull(handle);
+	pwtest_neg_errno_ok(spa_handle_get_interface(handle,
+				SPA_TYPE_INTERFACE_FilterGraph, (void **)graph));
+	pwtest_ptr_notnull(*graph);
+
+	props = pw_properties_new(SPA_KEY_AUDIO_RATE, "48000", NULL);
+	pwtest_neg_errno_ok(spa_filter_graph_activate(*graph, &props->dict));
+	pw_properties_free(props);
+	return handle;
+}
+
+PWTEST(filter_graph_volume_applied_once)
+{
+	struct pw_main_loop *ml;
+	struct pw_context *context;
+	struct spa_handle *handle;
+	struct spa_filter_graph *graph = NULL;
+	struct spa_hook listener;
+	struct data d = { 0 };
+
+	pw_init(0, NULL);
+	ml = pw_main_loop_new(NULL);
+	pwtest_ptr_notnull(ml);
+	context = pw_context_new(pw_main_loop_get_loop(ml),
+			pw_properties_new(PW_KEY_CONFIG_NAME, "null", NULL), 0);
+	pwtest_ptr_notnull(context);
+
+	/* the graph carries the volume on vol:Mult */
+	handle = load_graph(context,
+			"{ nodes = [ { type = builtin name = vol label = linear } ] "
+			"capture.volumes = [ { control = \"vol:Mult\" min = 0.0 max = 1.0 scale = cubic } ] }",
+			&graph);
+	spa_filter_graph_add_listener(graph, &listener, &graph_events, &d);
+
+	/* a volume change: software stays at unity */
+	set_props(graph, 0.027f, 0.027f, -1);
+	pwtest_int_eq(d.n_soft, 1u);
+	pwtest_double_eq(d.soft[0], 1.0);
+	pwtest_bool_true(d.have_soft_mute);
+	pwtest_bool_false(d.soft_mute);
+
+	/* the same volume again, as a desktop or a restore script sends it */
+	set_props(graph, 0.027f, 0.027f, -1);
+	pwtest_int_eq(d.n_soft, 1u);
+	pwtest_double_eq(d.soft[0], 1.0);
+
+	/* the same volume with no softVolumes: the converter would fall back to
+	 * the channel volumes, so unity has to be added */
+	set_props(graph, 0.027f, -1.0f, -1);
+	pwtest_int_eq(d.n_soft, 1u);
+	pwtest_double_eq(d.soft[0], 1.0);
+
+	/* an unmute of a sink that is not muted (mute only) */
+	set_props(graph, -1.0f, -1.0f, 0);
+	pwtest_int_eq(d.n_soft, 1u);
+	pwtest_double_eq(d.soft[0], 1.0);
+	pwtest_bool_true(d.have_soft_mute);
+	pwtest_bool_false(d.soft_mute);
+
+	/* mute and unmute still work */
+	set_props(graph, -1.0f, -1.0f, 1);
+	pwtest_int_eq(d.n_soft, 1u);
+	pwtest_double_eq(d.soft[0], 0.0);
+	pwtest_bool_true(d.soft_mute);
+	set_props(graph, -1.0f, -1.0f, 0);
+	pwtest_double_eq(d.soft[0], 1.0);
+	pwtest_bool_false(d.soft_mute);
+
+	spa_hook_remove(&listener);
+	pw_unload_spa_handle(handle);
+
+	/* a graph without volume controls passes softVolumes on unmodified */
+	handle = load_graph(context,
+			"{ nodes = [ { type = builtin name = vol label = linear } ] }",
+			&graph);
+	spa_zero(d);
+	spa_filter_graph_add_listener(graph, &listener, &graph_events, &d);
+	set_props(graph, 0.5f, 0.125f, -1);
+	pwtest_int_eq(d.n_soft, 1u);
+	pwtest_double_eq(d.soft[0], 0.125);
+	set_props(graph, -1.0f, -1.0f, 0);
+	pwtest_int_eq(d.n_soft, 0u);
+
+	spa_hook_remove(&listener);
+	pw_unload_spa_handle(handle);
+	pw_context_destroy(context);
+	pw_main_loop_destroy(ml);
+	pw_deinit();
+
+	return PWTEST_PASS;
+}
+
+PWTEST_SUITE(filter_graph_volume)
+{
+	pwtest_add(filter_graph_volume_applied_once, PWTEST_NOARG);
+	return PWTEST_PASS;
+}
-- 

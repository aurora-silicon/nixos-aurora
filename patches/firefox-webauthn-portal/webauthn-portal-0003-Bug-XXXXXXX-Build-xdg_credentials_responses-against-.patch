From 3539655c0f3f301ac9e660b11c5d05fdbac77a47 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Fri, 13 Nov 2026 17:25:46 +1100
Subject: [PATCH 3/7] Bug XXXXXXX - Build xdg_credentials_responses against the
 in-tree authenticator crate. r?mfarrell

authenticator-rs now lives in dom/webauthn/authenticator and authrs_bridge
uses it by path. xdg_credentials_responses still asked for the v0.6.0 git
tag, which is not vendored, and a second copy of the crate would not
match the AttestationObject type that authrs_bridge uses. Use the same
path dependency.
---
 dom/webauthn/xdg_credentials_responses/Cargo.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dom/webauthn/xdg_credentials_responses/Cargo.toml b/dom/webauthn/xdg_credentials_responses/Cargo.toml
index 63bcf505..e7eb340d 100644
--- a/dom/webauthn/xdg_credentials_responses/Cargo.toml
+++ b/dom/webauthn/xdg_credentials_responses/Cargo.toml
@@ -5,7 +5,7 @@ edition = "2021"
 authors = ["Martin Sirringhaus"]
 
 [dependencies]
-authenticator = { tag = "v0.6.0", git = "https://github.com/mozilla/authenticator-rs", features = ["gecko"] }
+authenticator = { path = "../authenticator" }
 authrs_bridge = { path = "../authrs_bridge" }
 base64 = "^0.22"
 log = "0.4"
-- 

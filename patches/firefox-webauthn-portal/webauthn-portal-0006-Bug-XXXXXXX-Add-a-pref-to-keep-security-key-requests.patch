diff --git a/dom/webauthn/WebAuthnUtil.cpp b/dom/webauthn/WebAuthnUtil.cpp
index f4a4662d..9175a1c7 100644
--- a/dom/webauthn/WebAuthnUtil.cpp
+++ b/dom/webauthn/WebAuthnUtil.cpp
@@ -4,12 +4,15 @@
 
 #include "mozilla/dom/WebAuthnUtil.h"
 
+#include "WebAuthnEnumStrings.h"
+#include "WebAuthnTransportIdentifiers.h"
 #include "hasht.h"
 #include "js/Exception.h"
 #include "mozilla/Base64.h"
 #include "mozilla/BasePrincipal.h"
 #include "mozilla/Components.h"
 #include "mozilla/ExtensionPolicyService.h"
+#include "mozilla/Maybe.h"
 #include "mozilla/StaticPrefs_security.h"
 #include "mozilla/dom/BrowsingContextGroup.h"
 #include "mozilla/dom/RemoteType.h"
@@ -803,4 +806,50 @@ nsresult SerializeWebAuthnRequestOptions(
   return NS_OK;
 }
 
+// Returns Some(true) for a "security-key" hint, Some(false) for a
+// "client-device" or "hybrid" hint, and Nothing if aHints has neither.
+static Maybe<bool> SecurityKeyHint(const nsTArray<nsString>& aHints) {
+  for (const nsString& hint : aHints) {
+    if (hint.EqualsLiteral("security-key")) {
+      return Some(true);
+    }
+    if (hint.EqualsLiteral("client-device") || hint.EqualsLiteral("hybrid")) {
+      return Some(false);
+    }
+  }
+  return Nothing();
+}
+
+bool IsSecurityKeyRegistration(const nsAString& aAuthenticatorAttachment,
+                               const nsTArray<nsString>& aHints) {
+  if (aAuthenticatorAttachment.EqualsLiteral(
+          MOZ_WEBAUTHN_AUTHENTICATOR_ATTACHMENT_PLATFORM)) {
+    return false;
+  }
+  if (Maybe<bool> hint = SecurityKeyHint(aHints)) {
+    return *hint;
+  }
+  return aAuthenticatorAttachment.EqualsLiteral(
+      MOZ_WEBAUTHN_AUTHENTICATOR_ATTACHMENT_CROSS_PLATFORM);
+}
+
+bool IsSecurityKeyAssertion(const nsTArray<uint8_t>& aAllowListTransports,
+                            const nsTArray<nsString>& aHints) {
+  if (Maybe<bool> hint = SecurityKeyHint(aHints)) {
+    return *hint;
+  }
+  if (aAllowListTransports.IsEmpty()) {
+    return false;
+  }
+  const uint8_t passkeyTransports =
+      MOZ_WEBAUTHN_AUTHENTICATOR_TRANSPORT_ID_INTERNAL |
+      MOZ_WEBAUTHN_AUTHENTICATOR_TRANSPORT_ID_HYBRID;
+  for (uint8_t transports : aAllowListTransports) {
+    if (transports == 0 || (transports & passkeyTransports)) {
+      return false;
+    }
+  }
+  return true;
+}
+
 }  // namespace mozilla::dom
diff --git a/dom/webauthn/WebAuthnUtil.h b/dom/webauthn/WebAuthnUtil.h
index a134eeb5..541cdfd7 100644
--- a/dom/webauthn/WebAuthnUtil.h
+++ b/dom/webauthn/WebAuthnUtil.h
@@ -47,6 +47,18 @@ nsresult SerializeWebAuthnRequestOptions(
     const PublicKeyCredentialRequestOptions& aOptions,
     /* out */ nsString& aOut);
 
+// Whether a request is meant for a security key rather than a platform or
+// hybrid authenticator. A registration with authenticatorAttachment
+// "platform" never is. Otherwise the first of "security-key",
+// "client-device" and "hybrid" in aHints decides. Without such a hint, a
+// registration is when its authenticatorAttachment is "cross-platform", and
+// an assertion is when every allowed credential lists its transports and none
+// of them is "internal" or "hybrid".
+bool IsSecurityKeyRegistration(const nsAString& aAuthenticatorAttachment,
+                               const nsTArray<nsString>& aHints);
+bool IsSecurityKeyAssertion(const nsTArray<uint8_t>& aAllowListTransports,
+                            const nsTArray<nsString>& aHints);
+
 }  // namespace mozilla::dom
 
 #endif  // mozilla_dom_WebAuthnUtil_h
diff --git a/dom/webauthn/tests/gtest/TestWebAuthnRouting.cpp b/dom/webauthn/tests/gtest/TestWebAuthnRouting.cpp
new file mode 100644
index 00000000..33ffaabc
--- /dev/null
+++ b/dom/webauthn/tests/gtest/TestWebAuthnRouting.cpp
@@ -0,0 +1,55 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "gtest/gtest.h"
+#include "mozilla/dom/WebAuthnTransportIdentifiers.h"
+#include "mozilla/dom/WebAuthnUtil.h"
+
+using namespace mozilla::dom;
+
+static const uint8_t kUsb = MOZ_WEBAUTHN_AUTHENTICATOR_TRANSPORT_ID_USB;
+static const uint8_t kNfc = MOZ_WEBAUTHN_AUTHENTICATOR_TRANSPORT_ID_NFC;
+static const uint8_t kInternal =
+    MOZ_WEBAUTHN_AUTHENTICATOR_TRANSPORT_ID_INTERNAL;
+static const uint8_t kHybrid = MOZ_WEBAUTHN_AUTHENTICATOR_TRANSPORT_ID_HYBRID;
+
+TEST(WebAuthnRouting, Registration)
+{
+  nsTArray<nsString> none;
+  EXPECT_FALSE(IsSecurityKeyRegistration(u""_ns, none));
+  EXPECT_FALSE(IsSecurityKeyRegistration(u"platform"_ns, none));
+  EXPECT_TRUE(IsSecurityKeyRegistration(u"cross-platform"_ns, none));
+
+  nsTArray<nsString> securityKey{u"security-key"_ns};
+  EXPECT_TRUE(IsSecurityKeyRegistration(u""_ns, securityKey));
+  EXPECT_FALSE(IsSecurityKeyRegistration(u"platform"_ns, securityKey));
+
+  nsTArray<nsString> hybridFirst{u"hybrid"_ns, u"security-key"_ns};
+  EXPECT_FALSE(IsSecurityKeyRegistration(u"cross-platform"_ns, hybridFirst));
+
+  nsTArray<nsString> clientDevice{u"client-device"_ns};
+  EXPECT_FALSE(IsSecurityKeyRegistration(u""_ns, clientDevice));
+
+  nsTArray<nsString> unknown{u"something-else"_ns};
+  EXPECT_TRUE(IsSecurityKeyRegistration(u"cross-platform"_ns, unknown));
+}
+
+TEST(WebAuthnRouting, Assertion)
+{
+  nsTArray<nsString> none;
+  EXPECT_FALSE(IsSecurityKeyAssertion({}, none));
+  EXPECT_TRUE(IsSecurityKeyAssertion({kUsb}, none));
+  EXPECT_TRUE(IsSecurityKeyAssertion({kUsb, uint8_t(kUsb | kNfc)}, none));
+  EXPECT_FALSE(IsSecurityKeyAssertion({kUsb, kInternal}, none));
+  EXPECT_FALSE(IsSecurityKeyAssertion({uint8_t(kUsb | kHybrid)}, none));
+  // A credential without transports could be a passkey.
+  EXPECT_FALSE(IsSecurityKeyAssertion({kUsb, 0}, none));
+
+  nsTArray<nsString> securityKey{u"security-key"_ns};
+  EXPECT_TRUE(IsSecurityKeyAssertion({}, securityKey));
+  EXPECT_TRUE(IsSecurityKeyAssertion({kInternal}, securityKey));
+
+  nsTArray<nsString> clientDevice{u"client-device"_ns};
+  EXPECT_FALSE(IsSecurityKeyAssertion({kUsb}, clientDevice));
+}

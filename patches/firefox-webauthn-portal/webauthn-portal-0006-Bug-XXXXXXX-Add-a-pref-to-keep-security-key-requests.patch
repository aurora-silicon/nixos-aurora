diff --git a/dom/webauthn/WebAuthnService.h b/dom/webauthn/WebAuthnService.h
index 8f3f87d6..36780b94 100644
--- a/dom/webauthn/WebAuthnService.h
+++ b/dom/webauthn/WebAuthnService.h
@@ -106,6 +106,15 @@ class WebAuthnService final : public nsIWebAuthnService {
     return mPlatformService;
   }
 
+#if defined(MOZ_WIDGET_GTK) && defined(MOZ_ENABLE_DBUS)
+  // Whether requests meant for a security key bypass the credential portal.
+  bool KeepSecurityKeysOnAuthrs() {
+    return DefaultService() != mAuthrsService &&

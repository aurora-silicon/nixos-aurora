+# authenticator-rs and the portal only gets platform and hybrid requests.
+- name: security.webauthn.use-xdg-desktop-portal.security-keys
+  type: RelaxedAtomicBool
+  value: true
+  mirror: always
 #endif
 
 # Dispatch WebAuthn requests to authenticator-rs

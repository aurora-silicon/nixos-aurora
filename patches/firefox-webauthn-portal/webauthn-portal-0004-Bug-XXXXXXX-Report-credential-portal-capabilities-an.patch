From 23c734362a049e3a1f39eb68289a1e246426e555 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Fri, 13 Nov 2026 17:18:06 +1100
Subject: [PATCH 4/7] Bug XXXXXXX - Report credential portal capabilities and
 isUVPAA on Linux. r?mfarrell

The credential portal (org.freedesktop.portal.experimental.Credential)
exports the WebAuthn client capabilities of its backend as boolean
properties. Read HybridTransport, PasskeyPlatformAuthenticator and
UserVerifyingPlatformAuthenticator from it, so that
getClientCapabilities() and isUserVerifyingPlatformAuthenticatorAvailable()
report true when the backend has a platform authenticator, such as a
TPM or Secure Enclave provider behind credentialsd. Properties the portal
does not export are reported as false.

Both callers run off the main thread, so the properties are read with a
synchronous proxy.

This builds on the portal service from bug 1983767 and the capability
plumbing from bug 2088324, both by Martin Sirringhaus.
---
 dom/webauthn/XdgPortalWebAuthnService.cpp | 56 ++++++++++++++++++++++-
 1 file changed, 55 insertions(+), 1 deletion(-)

diff --git a/dom/webauthn/XdgPortalWebAuthnService.cpp b/dom/webauthn/XdgPortalWebAuthnService.cpp
index e7b10afc..3df44894 100644
--- a/dom/webauthn/XdgPortalWebAuthnService.cpp
+++ b/dom/webauthn/XdgPortalWebAuthnService.cpp
@@ -57,6 +57,45 @@ static bool IsCredentialPortalAvailable() {
   return !!version;
 }
 
+// Maps the portal's capability properties to getClientCapabilities() keys.
+// conditionalCreate and the signal* capabilities are left out because Firefox
+// does not implement them, and relatedOrigins is decided by WebAuthnService.
+static constexpr struct {
+  const char* mProperty;
+  const char* mCapability;
+} kPortalCapabilities[] = {
+    {"HybridTransport", "hybridTransport"},
+    {"PasskeyPlatformAuthenticator", "passkeyPlatformAuthenticator"},
+    {"UserVerifyingPlatformAuthenticator",
+     "userVerifyingPlatformAuthenticator"},
+};
+
+// Reads the capability properties of the portal. This blocks on D-Bus; the
+// callers in WebAuthnTransactionParent run it off the main thread.
+// Properties that the portal does not export are reported as unsupported.
+static nsTArray<nsCString> ReadPortalCapabilities() {
+  nsTArray<nsCString> capabilities;
+  RefPtr<GDBusProxy> proxy = dont_AddRef(g_dbus_proxy_new_for_bus_sync(
+      G_BUS_TYPE_SESSION,
+      GDBusProxyFlags(G_DBUS_PROXY_FLAGS_DO_NOT_CONNECT_SIGNALS |
+                      G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START),
+      nullptr, "org.freedesktop.portal.Desktop",
+      "/org/freedesktop/portal/desktop",
+      "org.freedesktop.portal.experimental.Credential", nullptr, nullptr));
+  if (!proxy) {
+    return capabilities;
+  }
+  for (const auto& entry : kPortalCapabilities) {
+    RefPtr<GVariant> value =
+        dont_AddRef(g_dbus_proxy_get_cached_property(proxy, entry.mProperty));
+    if (value && g_variant_is_of_type(value, G_VARIANT_TYPE_BOOLEAN) &&
+        g_variant_get_boolean(value)) {
+      capabilities.AppendElement(nsDependentCString(entry.mCapability));
+    }
+  }
+  return capabilities;
+}
+
 already_AddRefed<nsIWebAuthnService>
 XdgPortalWebAuthnService::NewIfAvailable() {
   if (widget::ShouldUsePortal(widget::PortalKind::Credentials) &&
@@ -69,7 +108,22 @@ XdgPortalWebAuthnService::NewIfAvailable() {
 
 NS_IMETHODIMP
 XdgPortalWebAuthnService::GetIsUVPAA(bool* aAvailable) {
-  return NS_ERROR_NOT_IMPLEMENTED;
+  *aAvailable = ReadPortalCapabilities().Contains(
+      "userVerifyingPlatformAuthenticator"_ns);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+XdgPortalWebAuthnService::GetClientCapabilities(
+    nsTArray<nsCString>& aClientCapabilities) {
+  aClientCapabilities = ReadPortalCapabilities();
+  // The extension results that xdg_credentials_responses passes on from the
+  // portal's response.
+  aClientCapabilities.AppendElement("extension:credProps"_ns);
+  aClientCapabilities.AppendElement("extension:hmacCreateSecret"_ns);
+  aClientCapabilities.AppendElement("extension:largeBlob"_ns);
+  aClientCapabilities.AppendElement("extension:prf"_ns);
+  return NS_OK;
 }
 
 NS_IMETHODIMP

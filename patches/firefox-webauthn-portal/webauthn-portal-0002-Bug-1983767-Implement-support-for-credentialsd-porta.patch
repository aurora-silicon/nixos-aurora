+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#[macro_use]
+extern crate xpcom;
+
+use nserror::{nsresult, NS_ERROR_FAILURE, NS_OK};
+use nsstring::nsACString;
+use xpcom::interfaces::{nsIWebAuthnRegisterPromise, nsIWebAuthnSignPromise};
+use xpcom::RefPtr;
+
+mod register;
+pub use register::WebAuthnRegisterResult;
+use register::{RegisterPromise, RegisterResult};
+
+mod sign;
+use sign::{SignPromise, SignResult};
+
+#[no_mangle]
+pub extern "C" fn xdg_credentials_parse_register_response(
+    response_json: &nsACString,
+    promise: *const nsIWebAuthnRegisterPromise,
+) -> nsresult {
+    if promise.is_null() {
+        return NS_ERROR_FAILURE;
+    }
+
+    let promise = RegisterPromise(RefPtr::new(unsafe { &*promise }));
+    let json_str = response_json.to_string();
+
+    let result = RegisterResult::parse_from_json(&json_str).map_err(|e| {
+        log::error!("Failed to parse register response: {:?}", e);
+        NS_ERROR_FAILURE
+    });
+
+    match promise.resolve_or_reject(result) {
+        Ok(()) => NS_OK,
+        Err(e) => e,
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn xdg_credentials_parse_sign_response(
+    response_json: &nsACString,
+    promise: *const nsIWebAuthnSignPromise,
+) -> nsresult {
+    if promise.is_null() {
+        return NS_ERROR_FAILURE;
+    }
+
+    let promise = SignPromise(RefPtr::new(unsafe { &*promise }));
+    let json_str = response_json.to_string();
+
+    let result = SignResult::parse_from_json(&json_str).map_err(|e| {
+        log::error!("Failed to parse sign response: {:?}", e);
+        NS_ERROR_FAILURE
+    });
+
+    match promise.resolve_or_reject(result) {
+        Ok(()) => NS_OK,
+        Err(e) => e,
+    }
+}

+static RefPtr<DBusProxyPromise> CreateCredentialPortalPromise() {
+  return CreateDBusProxyForBus(
+      G_BUS_TYPE_SESSION, G_DBUS_PROXY_FLAGS_DO_NOT_CONNECT_SIGNALS, nullptr,
+      "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
+      "org.freedesktop.portal.experimental.Credential");
+}
+
+// The experimental Credential interface is only exported when the portal
+// runs with XDG_DESKTOP_PORTAL_ENABLE_EXPERIMENTAL=credential and has a
+// backend configured, so the presence of its "version" property signals
+// support. xdg-desktop-portal itself is expected to be running already
+// (nsLookAndFeel auto-starts it); the backend is started by the portal on
+// demand, so we don't auto-start anything here.
+static bool IsCredentialPortalAvailable() {
+  RefPtr<GDBusProxy> proxy = dont_AddRef(g_dbus_proxy_new_for_bus_sync(
+      G_BUS_TYPE_SESSION,
+      GDBusProxyFlags(G_DBUS_PROXY_FLAGS_DO_NOT_CONNECT_SIGNALS |
+                      G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START),
+      nullptr, "org.freedesktop.portal.Desktop",
+      "/org/freedesktop/portal/desktop",
+      "org.freedesktop.portal.experimental.Credential", nullptr, nullptr));
+  if (!proxy) {
+    return false;
+  }
+  RefPtr<GVariant> version =
+      dont_AddRef(g_dbus_proxy_get_cached_property(proxy, "version"));
+  return !!version;
+}
+
+already_AddRefed<nsIWebAuthnService>
+XdgPortalWebAuthnService::NewIfAvailable() {
+  if (widget::ShouldUsePortal(widget::PortalKind::Credentials) &&
+      IsCredentialPortalAvailable()) {
+    nsCOMPtr<nsIWebAuthnService> service(new XdgPortalWebAuthnService());
+    return service.forget();
+  }
+  return nullptr;
+}

+void XdgPortalWebAuthnService::DoMakeCredential(
+    const nsCString& aWindowHandle, nsIWebAuthnRegisterArgs* aArgs,
+    RefPtr<nsIWebAuthnRegisterPromise> aPromise, nsCOMPtr<nsIWidget> aWidget) {
+  nsAutoString origin;
+  nsresult rv = aArgs->GetOrigin(origin);
+  if (NS_FAILED(rv)) {
+    aPromise->Reject(rv);
+    UnexportWindowHandle(aWidget);
+    return;
+  }
+
+  nsCString topOrigin;
+  rv = aArgs->GetTopOrigin(topOrigin);
+  if (NS_FAILED(rv)) {
+    aPromise->Reject(rv);
+    UnexportWindowHandle(aWidget);
+    return;
+  }
+
+  nsAutoString publicKeyJson;
+  rv = aArgs->GetJson(publicKeyJson);
+  if (NS_FAILED(rv)) {
+    aPromise->Reject(rv);
+    UnexportWindowHandle(aWidget);
+    return;
+  }
+
+  uint32_t timeout;
+  if NS_FAILED (aArgs->GetTimeoutMS(&timeout)) {
+    aPromise->Reject(rv);
+    UnexportWindowHandle(aWidget);
+    return;
+  }
+
+  CreateCredentialPortalPromise()->Then(
+      GetCurrentSerialEventTarget(), __func__,
+      [aWindowHandle, origin = NS_ConvertUTF16toUTF8(origin), topOrigin,
+       publicKeyJson = NS_ConvertUTF16toUTF8(publicKeyJson), aPromise, aWidget,
+       timeout](RefPtr<GDBusProxy>&& aProxy) {
+        nsAutoCString token;
+        widget::MakePortalRequestToken("webauthn_create"_ns, token);
+
+        GVariantBuilder optBuilder;
+        g_variant_builder_init(&optBuilder, G_VARIANT_TYPE_VARDICT);
+        g_variant_builder_add(&optBuilder, "{sv}", "handle_token",
+                              g_variant_new_string(token.get()));
+        g_variant_builder_add(&optBuilder, "{sv}", "top_origin",
+                              g_variant_new_string(topOrigin.get()));
+        g_variant_builder_add(&optBuilder, "{sv}", "public_key",
+                              g_variant_new_string(publicKeyJson.get()));
+
+        guint subscriptionId = widget::OnDBusPortalResponse(
+            aProxy, token, [aPromise, aWidget](GVariant* aResult) {
+              UnexportWindowHandle(aWidget);
+
+              uint32_t responseCode = 0;
+              RefPtr<GVariant> responseCodeVariant =
+                  dont_AddRef(g_variant_get_child_value(aResult, 0));
+              responseCode = g_variant_get_uint32(responseCodeVariant);
+
+              if (responseCode != 0) {
+                aPromise->Reject(NS_ERROR_DOM_NOT_ALLOWED_ERR);
+                return;
+              }
+
+              RefPtr<GVariant> results =
+                  dont_AddRef(g_variant_get_child_value(aResult, 1));
+
+              GVariant* typeValue = g_variant_lookup_value(
+                  results, "type", G_VARIANT_TYPE_STRING);
+              if (!typeValue || strcmp(g_variant_get_string(typeValue, nullptr),
+                                       "public-key") != 0) {
+                g_variant_unref(typeValue);
+                aPromise->Reject(NS_ERROR_DOM_INVALID_STATE_ERR);
+                return;
+              }
+              g_variant_unref(typeValue);
+
+              GVariant* publicKeyDict = g_variant_lookup_value(
+                  results, "public_key", G_VARIANT_TYPE_VARDICT);
+              if (!publicKeyDict) {
+                aPromise->Reject(NS_ERROR_DOM_INVALID_STATE_ERR);
+                return;
+              }
+
+              GVariant* jsonValue = g_variant_lookup_value(
+                  publicKeyDict, "registration_response_json",
+                  G_VARIANT_TYPE_STRING);
+              g_variant_unref(publicKeyDict);
+
+              if (!jsonValue) {
+                aPromise->Reject(NS_ERROR_DOM_INVALID_STATE_ERR);
+                return;
+              }
+
+              const char* jsonString = g_variant_get_string(jsonValue, nullptr);
+              nsresult rv = xdg_credentials_parse_register_response(
+                  nsDependentCString(jsonString), aPromise);
+              g_variant_unref(jsonValue);
+
+              if (NS_FAILED(rv)) {
+                aPromise->Reject(rv);
+              }
+            });
+
+        DBusProxyCall(
+            aProxy, "CreateCredential",
+            g_variant_new("(sss@a{sv})", aWindowHandle.get(), origin.get(),
+                          "publicKey", g_variant_builder_end(&optBuilder)),
+            G_DBUS_CALL_FLAGS_NONE, static_cast<int>(timeout))
+            ->Then(
+                GetCurrentSerialEventTarget(), __func__,
+                [](RefPtr<GVariant>&& aResult) {},
+                [subscriptionId, aProxy, aPromise,
+                 aWidget](GUniquePtr<GError>&& aError) {
+                  UnexportWindowHandle(aWidget);
+                  g_dbus_connection_signal_unsubscribe(
+                      g_dbus_proxy_get_connection(aProxy), subscriptionId);
+                  aPromise->Reject(NS_ERROR_DOM_NOT_ALLOWED_ERR);
+                });
+      },
+      [aPromise, aWidget](GUniquePtr<GError>&& aError) {
+        UnexportWindowHandle(aWidget);
+        aPromise->Reject(NS_ERROR_DOM_NOT_ALLOWED_ERR);
+      });
+}

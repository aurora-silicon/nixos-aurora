+NS_IMETHODIMP
+XdgPortalWebAuthnService::MakeCredential(uint64_t aTransactionId,
+                                         uint64_t aBrowsingContextId,
+                                         nsIWebAuthnRegisterArgs* aArgs,
+                                         nsIWebAuthnRegisterPromise* aPromise) {
+  Reset();
+
+  RefPtr<BrowsingContext> bc = BrowsingContext::Get(aBrowsingContextId);
+  nsCOMPtr<nsIWidget> widget =
+      bc ? bc->Canonical()->GetParentProcessWidgetContaining() : nullptr;
+  RefPtr<nsIWebAuthnRegisterPromise> promise = RefPtr{aPromise};
+  RefPtr<nsIWebAuthnRegisterArgs> args = RefPtr{aArgs};
+  if (!widget) {
+    DoMakeCredential(""_ns, args, promise, nullptr);
+    return NS_OK;
+  }
+
+  ExportWindowHandle(widget.get())
+      ->Then(
+          GetCurrentSerialEventTarget(), __func__,
+          [self = RefPtr{this}, args, promise,
+           widget](const nsCString& aHandle) {
+            self->DoMakeCredential(aHandle, args, promise, widget);
+          },
+          [self = RefPtr{this}, args, promise](bool) {
+            self->DoMakeCredential(""_ns, args, promise, nullptr);
+          });
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+XdgPortalWebAuthnService::GetAssertion(uint64_t aTransactionId,
+                                       uint64_t aBrowsingContextId,
+                                       nsIWebAuthnSignArgs* aArgs,
+                                       nsIWebAuthnSignPromise* aPromise) {
+  Reset();
+
+  // Check if this is a conditional mediation request
+  bool conditionallyMediated = false;
+  nsresult rv = aArgs->GetConditionallyMediated(&conditionallyMediated);
+  if (NS_FAILED(rv)) {
+    aPromise->Reject(rv);
+    return NS_OK;
+  }
+
+  if (conditionallyMediated) {
+    // Cache the request and wait for the conditional UI to trigger it
+    nsAutoString origin;
+    rv = aArgs->GetOrigin(origin);
+    if (NS_FAILED(rv)) {
+      aPromise->Reject(rv);
+      return NS_OK;
+    }
+
+    RefPtr<BrowsingContext> bc = BrowsingContext::Get(aBrowsingContextId);
+    nsCOMPtr<nsIWidget> widget =
+        bc ? bc->Canonical()->GetParentProcessWidgetContaining() : nullptr;
+
+    mPendingConditionalGet.emplace(aTransactionId, aBrowsingContextId, origin,
+                                   ""_ns, aArgs, aPromise, widget.get());
+    return NS_OK;
+  }
+
+  // Not conditional - proceed immediately
+  RefPtr<BrowsingContext> bc = BrowsingContext::Get(aBrowsingContextId);
+  nsCOMPtr<nsIWidget> widget =
+      bc ? bc->Canonical()->GetParentProcessWidgetContaining() : nullptr;
+  if (!widget) {
+    DoGetAssertion(""_ns, aArgs, RefPtr{aPromise}, nullptr);
+    return NS_OK;
+  }
+
+  ExportWindowHandle(widget.get())
+      ->Then(
+          GetCurrentSerialEventTarget(), __func__,
+          [self = RefPtr{this}, aArgs = RefPtr{aArgs},
+           aPromise = RefPtr{aPromise}, widget](const nsCString& aHandle) {
+            self->DoGetAssertion(aHandle, aArgs, aPromise, widget);
+          },
+          [self = RefPtr{this}, aArgs = RefPtr{aArgs},
+           aPromise = RefPtr{aPromise}](bool) {
+            self->DoGetAssertion(""_ns, aArgs, aPromise, nullptr);
+          });
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+XdgPortalWebAuthnService::Reset() {
+  if (auto pending = std::move(mPendingConditionalGet)) {
+    pending->mPromise->Reject(NS_ERROR_ABORT);
+  }
+  MOZ_ASSERT(!mPendingConditionalGet);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+XdgPortalWebAuthnService::Cancel(uint64_t aTransactionId) {
+  if (mPendingConditionalGet.isSome() &&
+      mPendingConditionalGet->mTransactionId == aTransactionId) {
+    mPendingConditionalGet->mPromise->Reject(NS_ERROR_ABORT);
+    mPendingConditionalGet.reset();
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+XdgPortalWebAuthnService::HasPendingConditionalGet(uint64_t aBrowsingContextId,
+                                                   const nsAString& aOrigin,
+                                                   uint64_t* aRv) {
+  if (mPendingConditionalGet.isNothing()) {
+    *aRv = 0;
+    return NS_OK;
+  }
+
+  const auto& pending = mPendingConditionalGet.ref();
+  if (pending.mBrowsingContextId == aBrowsingContextId &&
+      pending.mOrigin.Equals(aOrigin)) {
+    *aRv = pending.mTransactionId;
+  } else {
+    *aRv = 0;
+  }
+  return NS_OK;
+}

+
+NS_IMETHODIMP
+XdgPortalWebAuthnService::ResumeConditionalGet(uint64_t aTransactionId) {
+  if (mPendingConditionalGet.isNothing()) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  auto pending = mPendingConditionalGet.extract();
+
+  if (pending.mTransactionId != aTransactionId) {
+    return NS_ERROR_INVALID_ARG;
+  }
+
+  // Copy values so both lambdas can capture them
+  RefPtr<nsIWebAuthnSignArgs> args = pending.mArgs;
+  RefPtr<nsIWebAuthnSignPromise> promise = pending.mPromise;
+  nsCOMPtr<nsIWidget> widget = pending.mWidget;
+
+  // Now execute the cached request
+  if (!widget) {
+    DoGetAssertion(""_ns, args, promise, nullptr);
+    return NS_OK;
+  }
+
+  ExportWindowHandle(widget.get())
+      ->Then(
+          GetCurrentSerialEventTarget(), __func__,
+          [self = RefPtr{this}, args, promise,
+           widget](const nsCString& aHandle) {
+            self->DoGetAssertion(aHandle, args, promise, widget);
+          },
+          [self = RefPtr{this}, args, promise](bool) {
+            self->DoGetAssertion(""_ns, args, promise, nullptr);
+          });
+  return NS_OK;
+}

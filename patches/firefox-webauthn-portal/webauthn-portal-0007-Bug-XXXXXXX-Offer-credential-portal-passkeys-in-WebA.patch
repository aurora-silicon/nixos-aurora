+// Reads the ListConditional reply, (aa{sv}), into autofill entries. Each
+// credential has "id" (ay, or a base64url string), and "user_name" (s).
+// Credentials that are not in a non-empty aAllowList are dropped.
+static nsTArray<RefPtr<nsIWebAuthnAutoFillEntry>> ParseConditionalCredentials(
+    GVariant* aReply, const nsAString& aRpId,
+    const nsTArray<nsTArray<uint8_t>>& aAllowList) {
+  nsTArray<RefPtr<nsIWebAuthnAutoFillEntry>> entries;
+  if (!g_variant_is_of_type(aReply, G_VARIANT_TYPE("(aa{sv})"))) {
+    return entries;
+  }
+  RefPtr<GVariant> credentials =
+      dont_AddRef(g_variant_get_child_value(aReply, 0));
+  GVariantIter iter;
+  g_variant_iter_init(&iter, credentials);
+  while (GVariant* rawCredential = g_variant_iter_next_value(&iter)) {
+    RefPtr<GVariant> credential = dont_AddRef(rawCredential);
+    nsTArray<uint8_t> credentialId;
+    if (RefPtr<GVariant> id = dont_AddRef(g_variant_lookup_value(
+            credential, "id", G_VARIANT_TYPE_BYTESTRING))) {
+      gsize length = 0;
+      const auto* data = static_cast<const uint8_t*>(
+          g_variant_get_fixed_array(id, &length, sizeof(uint8_t)));
+      credentialId.AppendElements(data, length);
+    } else if (RefPtr<GVariant> encodedId = dont_AddRef(g_variant_lookup_value(
+                   credential, "id", G_VARIANT_TYPE_STRING))) {
+      FallibleTArray<uint8_t> decoded;
+      if (NS_FAILED(Base64URLDecode(
+              nsDependentCString(g_variant_get_string(encodedId, nullptr)),
+              Base64URLDecodePaddingPolicy::Ignore, decoded))) {
+        continue;
+      }
+      credentialId.AppendElements(decoded);
+    }
+    if (credentialId.IsEmpty() ||
+        (!aAllowList.IsEmpty() && !aAllowList.Contains(credentialId))) {
+      continue;
+    }
+    nsAutoString userName;
+    if (RefPtr<GVariant> name = dont_AddRef(g_variant_lookup_value(
+            credential, "user_name", G_VARIANT_TYPE_STRING))) {
+      CopyUTF8toUTF16(nsDependentCString(g_variant_get_string(name, nullptr)),
+                      userName);
+    }
+    entries.AppendElement(new WebAuthnAutoFillEntry(
+        nsIWebAuthnAutoFillEntry::PROVIDER_PLATFORM_LINUX, userName, aRpId,
+        credentialId));
+  }
+  return entries;
+}

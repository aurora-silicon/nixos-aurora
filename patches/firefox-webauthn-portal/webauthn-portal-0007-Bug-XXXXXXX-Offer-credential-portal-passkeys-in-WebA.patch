+/// Returns `request_json`, a PublicKeyCredentialRequestOptions JSON, with
+/// `allowCredentials` set to `allow_list`. Entries the page already listed
+/// keep their transports.
+fn set_allow_list(
+    request_json: &str,
+    allow_list: &[Vec<u8>],
+) -> Result<String, Box<dyn std::error::Error>> {
+    let mut request: serde_json::Value = serde_json::from_str(request_json)?;
+    let request = request
+        .as_object_mut()
+        .ok_or("request options are not an object")?;
+    let listed = request
+        .get("allowCredentials")
+        .and_then(|list| list.as_array())
+        .cloned()
+        .unwrap_or_default();
+    let allow_credentials = allow_list
+        .iter()
+        .map(|id| {
+            let id = URL_SAFE_NO_PAD.encode(id);
+            listed
+                .iter()
+                .find(|entry| entry.get("id").and_then(|x| x.as_str()) == Some(id.as_str()))
+                .cloned()
+                .unwrap_or_else(|| serde_json::json!({"type": "public-key", "id": id}))
+        })
+        .collect();
+    request.insert(
+        "allowCredentials".to_string(),
+        serde_json::Value::Array(allow_credentials),
+    );
+    Ok(serde_json::to_string(request)?)
+}
+
+#[no_mangle]
+pub extern "C" fn xdg_credentials_set_allow_list(
+    request_json: &nsACString,
+    allow_list: &ThinVec<ThinVec<u8>>,
+    result: &mut nsACString,
+) -> nsresult {
+    let allow_list: Vec<Vec<u8>> = allow_list.iter().map(|id| id.to_vec()).collect();
+    match set_allow_list(&request_json.to_string(), &allow_list) {
+        Ok(json) => {
+            result.assign(&json);
+            NS_OK
+        }
+        Err(e) => {
+            log::error!("Failed to set the allow list: {:?}", e);
+            NS_ERROR_FAILURE
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::set_allow_list;
+
+    #[test]
+    fn keeps_listed_entry() {
+        let json = r#"{"challenge":"AA","rpId":"example.com","allowCredentials":[{"type":"public-key","id":"AQI","transports":["internal"]},{"type":"public-key","id":"AwQ"}]}"#;
+        let out: serde_json::Value =
+            serde_json::from_str(&set_allow_list(json, &[vec![1, 2]]).unwrap()).unwrap();
+        assert_eq!(
+            out["allowCredentials"],
+            serde_json::json!([{"type": "public-key", "id": "AQI", "transports": ["internal"]}])
+        );
+        assert_eq!(out["rpId"], "example.com");
+        assert_eq!(out["challenge"], "AA");
+    }
+
+    #[test]
+    fn adds_discoverable_entry() {
+        let json = r#"{"challenge":"AA","rpId":"example.com"}"#;
+        let out: serde_json::Value =
+            serde_json::from_str(&set_allow_list(json, &[vec![0xff, 0xee]]).unwrap()).unwrap();
+        assert_eq!(
+            out["allowCredentials"],
+            serde_json::json!([{"type": "public-key", "id": "_-4"}])
+        );
+    }
+
+    #[test]
+    fn rejects_non_object() {
+        assert!(set_allow_list("[]", &[]).is_err());
+        assert!(set_allow_list("not json", &[]).is_err());
+    }
+}

+void XdgPortalWebAuthnService::GetAutoFillEntriesForArgs(
+    nsIWebAuthnSignArgs* aArgs, nsIWebAuthnAutoFillEntriesCallback* aCallback) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsCOMPtr<nsIWebAuthnAutoFillEntriesCallback> callback(aCallback);
+  nsAutoString origin;
+  nsAutoCString topOrigin;
+  nsAutoString publicKeyJson;
+  nsAutoString rpId;
+  nsTArray<nsTArray<uint8_t>> allowList;
+  if (NS_FAILED(aArgs->GetOrigin(origin)) ||
+      NS_FAILED(aArgs->GetTopOrigin(topOrigin)) ||
+      NS_FAILED(aArgs->GetJson(publicKeyJson)) ||
+      NS_FAILED(aArgs->GetRpId(rpId)) ||
+      NS_FAILED(aArgs->GetAllowList(allowList))) {
+    callback->Reject(NS_ERROR_NOT_AVAILABLE);
+    return;
+  }
+
+  CreateCredentialPortalPromise()->Then(
+      GetCurrentSerialEventTarget(), __func__,
+      [origin = NS_ConvertUTF16toUTF8(origin), topOrigin,
+       publicKeyJson = NS_ConvertUTF16toUTF8(publicKeyJson), rpId,
+       allowList = std::move(allowList),
+       callback](RefPtr<GDBusProxy>&& aProxy) {
+        GVariantBuilder optBuilder;
+        g_variant_builder_init(&optBuilder, G_VARIANT_TYPE_VARDICT);
+        g_variant_builder_add(&optBuilder, "{sv}", "top_origin",
+                              g_variant_new_string(topOrigin.get()));
+        g_variant_builder_add(&optBuilder, "{sv}", "public_key",
+                              g_variant_new_string(publicKeyJson.get()));
+        DBusProxyCall(aProxy, "ListConditional",
+                      g_variant_new("(ss@a{sv})", "", origin.get(),
+                                    g_variant_builder_end(&optBuilder)),
+                      G_DBUS_CALL_FLAGS_NONE)
+            ->Then(
+                GetCurrentSerialEventTarget(), __func__,
+                [rpId, allowList = allowList.Clone(),
+                 callback](RefPtr<GVariant>&& aReply) {
+                  callback->Resolve(
+                      ParseConditionalCredentials(aReply, rpId, allowList));
+                },
+                [callback](GUniquePtr<GError>&& aError) {
+                  callback->Reject(NS_ERROR_NOT_AVAILABLE);
+                });
+      },
+      [callback](GUniquePtr<GError>&& aError) {
+        callback->Reject(NS_ERROR_NOT_AVAILABLE);
+      });
+}

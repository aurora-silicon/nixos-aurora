diff --git a/src/plugins/nightlight/autotests/ambientpolicytest.cpp b/src/plugins/nightlight/autotests/ambientpolicytest.cpp
new file mode 100644
index 0000000000..daf0ed425e
--- /dev/null
+++ b/src/plugins/nightlight/autotests/ambientpolicytest.cpp
@@ -0,0 +1,75 @@
+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "../ambientwhitepoint.h"
+#include "ambient-test-vectors.h"
+
+#include <QTest>
+#include <cmath>
+#include <iterator>
+
+using namespace KWin;
+
+class AmbientPolicyTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void targets();
+    void trajectory();
+    void limits();
+    void compose();
+};
+
+void AmbientPolicyTest::targets()
+{
+    const AmbientModel model;
+    for (const AmbientTargetVector &v : ambient_target_vectors) {
+        const double kelvin = 1e6 / AmbientPolicy::targetMired(model, v.valid, v.lux, v.kelvin);
+        QVERIFY2(std::abs(kelvin - v.expect_k) < 1e-3, qPrintable(QStringLiteral("%1 lux %2 K gave %3 K, expected %4 K").arg(v.lux).arg(v.kelvin).arg(kelvin).arg(v.expect_k)));
+    }
+}
+
+void AmbientPolicyTest::trajectory()
+{
+    AmbientPolicy policy;
+    size_t tick = 0;
+    for (const AmbientTickRun &run : ambient_tick_runs) {
+        for (int i = 0; i < run.count; i++, tick++) {
+            const double kelvin = policy.tick(run.releasing, run.valid, run.lux, run.kelvin);
+            QVERIFY(tick < std::size(ambient_tick_expect_k));
+            QVERIFY2(std::abs(kelvin - ambient_tick_expect_k[tick]) < 1e-3, qPrintable(QStringLiteral("tick %1 gave %2 K, expected %3 K").arg(tick).arg(kelvin).arg(ambient_tick_expect_k[tick])));
+        }
+    }
+    QCOMPARE(tick, std::size(ambient_tick_expect_k));
+    QVERIFY(policy.isNeutral());
+}
+
+void AmbientPolicyTest::limits()
+{
+    const AmbientModel model;
+    AmbientPolicy policy(model);
+    double previous = 6500;
+    for (int i = 0; i < 2000; i++) {
+        const double lux = (i * 7919) % 3000;
+        const double kelvin = 1000 + (i * 104729) % 15000;
+        const double out = policy.tick(false, true, lux, kelvin);
+        QVERIFY(out >= model.warmestK - 1e-6);
+        QVERIFY(out <= model.coolestK + 1e-6);
+        QVERIFY(std::abs(1e6 / out - 1e6 / previous) <= model.rampMiredPerSecond * AmbientPolicy::tickSeconds + 1e-9);
+        previous = out;
+    }
+}
+
+void AmbientPolicyTest::compose()
+{
+    QCOMPARE(composeTemperature(6500, 5600), 5600);
+    QCOMPARE(composeTemperature(2700, 5600), 2700);
+    QCOMPARE(composeTemperature(4000, 6500), 4000);
+}
+

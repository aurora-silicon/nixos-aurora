+bool NightLightManager::ambientWanted() const
+{
+    const LightSensor *sensor = workspace() ? workspace()->lightSensor() : nullptr;
+    return m_ambientEnabled && !isInhibited() && sensor && sensor->isAvailable()
+        && kwinApp()->session()->isActive();
+}
+
+// Claims the light sensor and runs the policy while wanted; otherwise lets
+// the white point return to neutral, then stops and releases the sensor.
+void NightLightManager::updateAmbient()
+{
+    LightSensor *sensor = workspace() ? workspace()->lightSensor() : nullptr;
+    if (!sensor) {
+        return;
+    }
+    const bool wanted = ambientWanted();
+    if (wanted && !m_ambientSensorHeld) {
+        sensor->acquire();
+        m_ambientSensorHeld = true;
+    }
+    if (!m_ambientTimer.isActive() && kwinApp()->session()->isActive()
+        && (wanted || !m_ambientPolicy.isNeutral())) {
+        m_ambientTimer.start();
+    }
+    if (!wanted && m_ambientSensorHeld) {
+        sensor->release();
+        m_ambientSensorHeld = false;
+    }
+    Q_EMIT ambientWhitePointChanged();
+}
+
+void NightLightManager::ambientTick()
+{
+    const LightSensor *sensor = workspace() ? workspace()->lightSensor() : nullptr;
+    const bool wanted = ambientWanted();
+    // reading() is only set for readings in lux, which the policy needs.
+    const auto lux = sensor ? sensor->reading() : std::nullopt;
+    const auto kelvin = sensor ? sensor->colorTemperature() : std::nullopt;
+    const bool valid = wanted && lux && kelvin;
+
+    m_ambientPolicy.tick(!wanted, valid, valid ? *lux : 0, valid ? *kelvin : 0);
+    if (!wanted && m_ambientPolicy.isNeutral()) {
+        m_ambientPolicy.reset();
+        m_ambientTimer.stop();
+    }
+    applyChannelFactors();
+}
+
+bool NightLightManager::isAmbientWhitePointEnabled() const
+{
+    return m_ambientEnabled;
+}
+
+bool NightLightManager::isAmbientWhitePointAvailable() const
+{
+    const LightSensor *sensor = workspace() ? workspace()->lightSensor() : nullptr;
+    // The colour temperature is only known while the light sensor is claimed.
+    return sensor && sensor->isAvailable() && sensor->colorTemperature().has_value();
+}
+
+bool NightLightManager::isAmbientWhitePointActive() const
+{
+    return !m_ambientPolicy.isNeutral() && m_appliedTemperature < m_currentTemperature;
+}
+
+int NightLightManager::ambientColorTemperature() const
+{
+    const LightSensor *sensor = workspace() ? workspace()->lightSensor() : nullptr;
+    const auto kelvin = sensor ? sensor->colorTemperature() : std::nullopt;
+    return kelvin ? int(std::round(*kelvin)) : 0;
+}

diff --git a/src/plugins/nightlight/ambientwhitepoint.cpp b/src/plugins/nightlight/ambientwhitepoint.cpp
new file mode 100644
index 0000000000..122e8b71b3
--- /dev/null
+++ b/src/plugins/nightlight/ambientwhitepoint.cpp
@@ -0,0 +1,111 @@
+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "ambientwhitepoint.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace KWin
+{
+
+static double mired(double kelvin)
+{
+    return 1e6 / kelvin;
+}
+
+// Starting constants: follow half of the ambient shift in mired, never warmer
+// than 5000 K and never cooler than the native white, fade out between 50 and
+// 5 lux where the screen dominates the room and the colour reading gets noisy,
+// ignore anything shorter than about half of a 10 s window, and move at
+// 1 mired/s (a full 6500 to 5000 K swing takes about 45 s). Replace them with
+// the measured macOS model when it is available; the test vectors pin the
+// behaviour.
+AmbientPolicy::AmbientPolicy(const AmbientModel &model)
+    : m_model(model)
+    , m_window(std::clamp(int(std::round(model.windowSeconds / tickSeconds)), 1, maxSamples))
+{
+    reset();
+}
+
+double AmbientPolicy::targetMired(const AmbientModel &model, bool valid, double lux, double kelvin)
+{
+    const double neutral = mired(model.neutralK);
+    if (!valid || !std::isfinite(lux) || !std::isfinite(kelvin) || lux < 0
+        || kelvin < model.minValidK || kelvin > model.maxValidK) {
+        return neutral;
+    }
+    if (lux <= model.luxOff) {
+        return neutral;
+    }
+    double fraction = (std::log10(lux) - std::log10(model.luxOff)) / (std::log10(model.luxFull) - std::log10(model.luxOff));
+    fraction = std::clamp(fraction, 0.0, 1.0);
+    const double target = neutral + model.strength * fraction * (mired(kelvin) - neutral);
+    return std::clamp(target, mired(model.coolestK), mired(model.warmestK));
+}
+
+void AmbientPolicy::reset()
+{
+    m_sampleCount = 0;
+    m_nextSample = 0;
+    m_haveTarget = false;
+    m_heldMired = mired(m_model.neutralK);
+    m_currentMired = m_heldMired;
+}
+
+double AmbientPolicy::median() const
+{
+    std::array<double, maxSamples> sorted = m_samples;
+    std::sort(sorted.begin(), sorted.begin() + m_sampleCount);
+    const int n = m_sampleCount;
+    return n % 2 ? sorted[n / 2] : (sorted[n / 2 - 1] + sorted[n / 2]) / 2;
+}
+
+double AmbientPolicy::tick(bool releasing, bool valid, double lux, double colorTemperature)
+{
+    const double neutral = mired(m_model.neutralK);
+    double target;
+    double step;
+
+    if (releasing) {
+        m_sampleCount = 0;
+        m_nextSample = 0;
+        m_haveTarget = false;
+        m_heldMired = neutral;
+        target = neutral;
+        step = m_model.releaseMiredPerSecond * tickSeconds;
+    } else {
+        m_samples[m_nextSample] = targetMired(m_model, valid, lux, colorTemperature);
+        m_nextSample = (m_nextSample + 1) % m_window;
+        m_sampleCount = std::min(m_sampleCount + 1, m_window);
+        const double filtered = median();
+
+        // The deadband keeps small wobbles off the screen, but the neutral
+        // point and the warm limit are always reachable.
+        const bool atBound = filtered == neutral || filtered == mired(m_model.warmestK);
+        if (!m_haveTarget || atBound || std::abs(filtered - m_heldMired) >= m_model.deadbandMired) {
+            m_heldMired = filtered;
+            m_haveTarget = true;
+        }
+        target = m_heldMired;
+        step = m_model.rampMiredPerSecond * tickSeconds;
+    }
+
+    m_currentMired += std::clamp(target - m_currentMired, -step, step);
+    return kelvin();
+}
+
+double AmbientPolicy::kelvin() const
+{
+    return 1e6 / m_currentMired;
+}
+
+bool AmbientPolicy::isNeutral() const
+{
+    return std::abs(m_currentMired - mired(m_model.neutralK)) < 1e-9;
+}
+
+} // namespace KWin
diff --git a/src/plugins/nightlight/ambientwhitepoint.h b/src/plugins/nightlight/ambientwhitepoint.h
new file mode 100644
index 0000000000..45a12a1d85
--- /dev/null
+++ b/src/plugins/nightlight/ambientwhitepoint.h
@@ -0,0 +1,89 @@
+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <array>
+
+namespace KWin
+{
+
+/**
+ * Ambient white point policy: maps the ambient light's correlated colour
+ * temperature and illuminance to a display white point, expressed as a
+ * colour temperature for Night Light's channel factors.
+ *
+ * gnome-settings-daemon carries the same model with the same constants and
+ * test vectors, so both desktops behave the same.
+ */
+struct AmbientModel
+{
+    double neutralK = 6500; // display native white, identity output
+    double warmestK = 5000; // never warmer than this
+    double coolestK = 6500; // never cooler than this
+    double strength = 0.5; // fraction of the ambient shift followed, in mired
+    double luxOff = 5; // at or below this, no adaptation
+    double luxFull = 50; // at or above this, full strength
+    double minValidK = 1500; // sensor readings outside are ignored
+    double maxValidK = 20000;
+    double windowSeconds = 10; // median filter window
+    double deadbandMired = 2.5; // ignore target changes smaller than this
+    double rampMiredPerSecond = 1.0; // following ambient changes
+    double releaseMiredPerSecond = 25.0; // returning to neutral when switched off
+};
+
+class AmbientPolicy
+{
+public:
+    static constexpr double tickSeconds = 0.5;
+    static constexpr int maxSamples = 64;
+
+    explicit AmbientPolicy(const AmbientModel &model = AmbientModel());
+
+    /**
+     * Instantaneous target, in mired, for one sensor reading. Invalid input
+     * gives the neutral point.
+     */
+    static double targetMired(const AmbientModel &model, bool valid, double lux, double kelvin);
+
+    /**
+     * Forgets all samples and jumps to neutral.
+     */
+    void reset();
+
+    /**
+     * Advances by one tick. When releasing, returns quickly to neutral and
+     * ignores the sensor. Returns the white point in kelvin.
+     */
+    double tick(bool releasing, bool valid, double lux, double colorTemperature);
+
+    double kelvin() const;
+    bool isNeutral() const;
+
+private:
+    double median() const;
+
+    AmbientModel m_model;
+    std::array<double, maxSamples> m_samples{};
+    int m_sampleCount = 0;
+    int m_nextSample = 0;
+    int m_window = 1;
+    double m_heldMired = 0;
+    double m_currentMired = 0;
+    bool m_haveTarget = false;
+};
+
+/**
+ * Night Light always wins: ambient adaptation can never make the screen
+ * cooler than Night Light asks for. The warmer of the two is used, which
+ * also makes hand-overs continuous.
+ */
+inline int composeTemperature(int nightLight, int ambient)
+{
+    return nightLight < ambient ? nightLight : ambient;
+}
+
+} // namespace KWin

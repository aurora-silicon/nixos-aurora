diff --git a/src/plugins/nightlight/ambientwhitepoint.cpp b/src/plugins/nightlight/ambientwhitepoint.cpp
new file mode 100644
index 0000000000..b9849d74ce
--- /dev/null
+++ b/src/plugins/nightlight/ambientwhitepoint.cpp
@@ -0,0 +1,166 @@
+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "ambientwhitepoint.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace KWin
+{
+
+static double mired(double kelvin)
+{
+    return 1e6 / kelvin;
+}
+
+// The low-light branch points (no adaptation through 10 lux, blending in to
+// full at 15 lux, no high-lux cut-off) and the fade durations (2 s when
+// switched on or off, 5 s when the ambient target moves) are macOS 26A428's
+// True Tone policy on the M4 Pro. The amount of adaptation is a starting value
+// until macOS has been measured under changing light, applied as a fraction of
+// the ambient shift in mired and limited to 5000 to 6500 K. The test vectors
+// pin the behaviour.
+
+// A monotone cubic through the quartiles of macOS's fade (0.25033, 0.66672 and
+// 0.91656 of the change at a quarter, half and three quarters of the time),
+// with Fritsch-Carlson slopes.
+static constexpr double easeY[] = {0.0, 0.25033, 0.66672, 0.91656, 1.0};
+static constexpr double easeM[] = {1.00132, 1.25072, 1.24919, 0.50040, 0.33376};
+
+double AmbientPolicy::ease(double x)
+{
+    if (x <= 0) {
+        return 0;
+    }
+    if (x >= 1) {
+        return 1;
+    }
+    const double h = 0.25;
+    const int i = std::min(int(x * 4), 3);
+    const double t = (x - i * h) / h;
+    return (2 * t * t * t - 3 * t * t + 1) * easeY[i]
+        + (t * t * t - 2 * t * t + t) * h * easeM[i]
+        + (-2 * t * t * t + 3 * t * t) * easeY[i + 1]
+        + (t * t * t - t * t) * h * easeM[i + 1];
+}
+
+AmbientPolicy::AmbientPolicy(const AmbientModel &model)
+    : m_model(model)
+    , m_window(std::clamp(int(std::round(model.windowSeconds / tickSeconds)), 1, maxSamples))
+{
+    reset();
+}
+
+double AmbientPolicy::targetMired(const AmbientModel &model, bool valid, double lux, double kelvin)
+{
+    const double neutral = mired(model.neutralK);
+    if (!valid || !std::isfinite(lux) || !std::isfinite(kelvin) || lux < 0
+        || kelvin < model.minValidK || kelvin > model.maxValidK) {
+        return neutral;
+    }
+    if (lux <= model.luxLow) {
+        return neutral;
+    }
+    const double fraction = std::clamp((lux - model.luxLow) / (model.luxFull - model.luxLow), 0.0, 1.0);
+    const double target = neutral + model.strength * fraction * (mired(kelvin) - neutral);
+    return std::clamp(target, mired(model.coolestK), mired(model.warmestK));
+}
+
+void AmbientPolicy::reset()
+{
+    m_sampleCount = 0;
+    m_nextSample = 0;
+    m_haveTarget = false;
+    m_heldMired = mired(m_model.neutralK);
+    m_currentMired = m_heldMired;
+    m_rampFrom = m_heldMired;
+    m_rampTo = m_heldMired;
+    m_rampDuration = m_model.toggleRampSeconds;
+    m_rampElapsed = m_rampDuration;
+}
+
+double AmbientPolicy::median() const
+{
+    std::array<double, maxSamples> sorted = m_samples;
+    std::sort(sorted.begin(), sorted.begin() + m_sampleCount);
+    const int n = m_sampleCount;
+    return n % 2 ? sorted[n / 2] : (sorted[n / 2 - 1] + sorted[n / 2]) / 2;
+}
+
+void AmbientPolicy::sample(bool releasing, bool valid, double lux, double colorTemperature)
+{
+    const double neutral = mired(m_model.neutralK);
+    // Switching on or off fades like a manual change; later moves use the
+    // slower ambient fade.
+    const bool toggle = releasing || !m_haveTarget;
+
+    if (releasing) {
+        m_sampleCount = 0;
+        m_nextSample = 0;
+        m_haveTarget = false;
+        m_heldMired = neutral;
+    } else {
+        m_samples[m_nextSample] = targetMired(m_model, valid, lux, colorTemperature);
+        m_nextSample = (m_nextSample + 1) % m_window;
+        m_sampleCount = std::min(m_sampleCount + 1, m_window);
+        const double filtered = median();
+
+        // The deadband keeps small wobbles off the screen, but the neutral
+        // point and the warm limit are always reachable.
+        const bool atBound = filtered == neutral || filtered == mired(m_model.warmestK);
+        if (!m_haveTarget || atBound || std::abs(filtered - m_heldMired) >= m_model.deadbandMired) {
+            m_heldMired = filtered;
+            m_haveTarget = true;
+        }
+    }
+
+    // A new target starts a fresh ramp from wherever the screen is now.
+    if (m_heldMired != m_rampTo) {
+        m_rampFrom = m_currentMired;
+        m_rampTo = m_heldMired;
+        m_rampElapsed = 0;
+        m_rampDuration = toggle ? m_model.toggleRampSeconds : m_model.ambientRampSeconds;
+    }
+}
+
+double AmbientPolicy::advance(double seconds)
+{
+    // In mired, where equal steps look about equally large, with the macOS
+    // fade shape.
+    if (m_rampElapsed < m_rampDuration) {
+        m_rampElapsed += seconds;
+        // Finish exactly, whatever rounding the steps collected.
+        if (m_rampElapsed > m_rampDuration - 1e-9) {
+            m_rampElapsed = m_rampDuration;
+        }
+        m_currentMired = m_rampFrom + (m_rampTo - m_rampFrom) * ease(m_rampElapsed / m_rampDuration);
+    }
+    return kelvin();
+}
+
+double AmbientPolicy::tick(bool releasing, bool valid, double lux, double colorTemperature)
+{
+    sample(releasing, valid, lux, colorTemperature);
+    return advance(tickSeconds);
+}
+
+bool AmbientPolicy::isSettled() const
+{
+    return m_rampElapsed >= m_rampDuration;
+}
+
+double AmbientPolicy::kelvin() const
+{
+    return 1e6 / m_currentMired;
+}
+
+bool AmbientPolicy::isNeutral() const
+{
+    return std::abs(m_currentMired - mired(m_model.neutralK)) < 1e-9;
+}
+
+} // namespace KWin

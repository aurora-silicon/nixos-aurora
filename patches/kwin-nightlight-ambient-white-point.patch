new file mode 100644
index 0000000000..969b9e4dc8
--- /dev/null
+++ b/src/plugins/nightlight/autotests/ambientpolicytest.cpp
@@ -0,0 +1,135 @@
+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "../ambientwhitepoint.h"
+#include "ambient-test-vectors.h"
+
+#include <QTest>
+#include <cmath>
+#include <iterator>
+
+using namespace KWin;
+
+class AmbientPolicyTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void targets();
+    void trajectory();
+    void limits();
+    void ramp();
+    void compose();
+};
+
+void AmbientPolicyTest::targets()
+{
+    const AmbientModel model;
+    for (const AmbientTargetVector &v : ambient_target_vectors) {
+        const double kelvin = 1e6 / AmbientPolicy::targetMired(model, v.valid, v.lux, v.kelvin);
+        QVERIFY2(std::abs(kelvin - v.expect_k) < 1e-3, qPrintable(QStringLiteral("%1 lux %2 K gave %3 K, expected %4 K").arg(v.lux).arg(v.kelvin).arg(kelvin).arg(v.expect_k)));
+    }
+}
+
+void AmbientPolicyTest::trajectory()
+{
+    AmbientPolicy policy;
+    size_t tick = 0;
+    for (const AmbientTickRun &run : ambient_tick_runs) {
+        for (int i = 0; i < run.count; i++, tick++) {
+            const double kelvin = policy.tick(run.releasing, run.valid, run.lux, run.kelvin);
+            QVERIFY(tick < std::size(ambient_tick_expect_k));
+            QVERIFY2(std::abs(kelvin - ambient_tick_expect_k[tick]) < 1e-3, qPrintable(QStringLiteral("tick %1 gave %2 K, expected %3 K").arg(tick).arg(kelvin).arg(ambient_tick_expect_k[tick])));
+        }
+    }
+    QCOMPARE(tick, std::size(ambient_tick_expect_k));
+    QVERIFY(policy.isNeutral());
+}
+
+void AmbientPolicyTest::limits()
+{
+    const AmbientModel model;
+    const double swing = 1e6 / model.warmestK - 1e6 / model.coolestK;
+    AmbientPolicy policy(model);
+    double previous = 6500;
+    for (int i = 0; i < 2000; i++) {
+        const double lux = (i * 7919) % 3000;
+        const double kelvin = 1000 + (i * 104729) % 15000;
+        policy.sample(false, true, lux, kelvin);
+        for (int step = 0; step < 10; step++) {
+            const double out = policy.advance(AmbientPolicy::stepSeconds);
+            QVERIFY(out >= model.warmestK - 1e-6);
+            QVERIFY(out <= model.coolestK + 1e-6);
+            QVERIFY(std::abs(1e6 / out - 1e6 / previous) <= 1.9 * swing * AmbientPolicy::stepSeconds / model.toggleRampSeconds + 1e-9);
+            previous = out;
+        }
+    }
+}
+
+static int fadeSteps(AmbientPolicy &policy)
+{
+    int steps = 0;
+    while (!policy.isSettled()) {
+        policy.advance(AmbientPolicy::stepSeconds);
+        steps++;
+    }
+    return steps;
+}
+
+void AmbientPolicyTest::ramp()
+{
+    const AmbientModel model;
+    const int toggleSteps = int(std::round(model.toggleRampSeconds / AmbientPolicy::stepSeconds));
+    const int ambientSteps = int(std::round(model.ambientRampSeconds / AmbientPolicy::stepSeconds));
+    const double n = 1e6 / 6500;
+    const double w = 1e6 / 5000;
+
+    // The fade shape passes through the macOS quartiles and is monotonic.
+    QVERIFY(std::abs(AmbientPolicy::ease(0.25) - 0.25033) < 1e-9);
+    QVERIFY(std::abs(AmbientPolicy::ease(0.5) - 0.66672) < 1e-9);
+    QVERIFY(std::abs(AmbientPolicy::ease(0.75) - 0.91656) < 1e-9);
+    for (int i = 0; i < 200; i++) {
+        QVERIFY(AmbientPolicy::ease(i / 200.0) <= AmbientPolicy::ease((i + 1) / 200.0));
+    }
+
+    // Switching on fades over the 2 s toggle time along that shape.
+    AmbientPolicy policy(model);
+    policy.sample(false, true, 300, 3000);
+    QVERIFY(!policy.isSettled());
+    int steps = 0;
+    while (!policy.isSettled()) {
+        const double out = policy.advance(AmbientPolicy::stepSeconds);
+        steps++;
+        const double expected = n + (w - n) * AmbientPolicy::ease(std::min(steps * AmbientPolicy::stepSeconds / model.toggleRampSeconds, 1.0));
+        QVERIFY(std::abs(1e6 / out - expected) < 1e-6);
+    }
+    QCOMPARE(steps, toggleSteps);
+    QVERIFY(std::abs(policy.kelvin() - 5000) < 1e-6);
+
+    // A move of the ambient target afterwards takes the 5 s ambient fade.
+    for (int i = 0; i < 40; i++) {
+        policy.sample(false, true, 300, 6000);
+    }
+    QVERIFY(!policy.isSettled());
+    steps = fadeSteps(policy);
+    QVERIFY(steps <= ambientSteps);
+    QVERIFY(steps > toggleSteps);
+
+    // Switching off returns to neutral in the toggle time.
+    policy.sample(true, true, 300, 3000);
+    QCOMPARE(fadeSteps(policy), toggleSteps);
+    QVERIFY(policy.isNeutral());
+}
+
+void AmbientPolicyTest::compose()
+{
+    QCOMPARE(composeTemperature(6500, 5600), 5600);
+    QCOMPARE(composeTemperature(2700, 5600), 2700);
+    QCOMPARE(composeTemperature(4000, 6500), 4000);
+}
+
+QTEST_GUILESS_MAIN(AmbientPolicyTest)
+#include "ambientpolicytest.moc"

From b5d3a5d5d59296e6bf7ab45b3e996d19982d41f6 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Fri, 13 Nov 2026 18:05:23 +1100
Subject: [PATCH] credential: Follow the handler's client capabilities

The Credential portal reported fixed capability properties, so browsers
always saw no user-verifying platform authenticator. Read them from the
handler's new GetClientCapabilities() method when a client reads one,
at most every two seconds and with a three second timeout. A handler
without the method keeps the previous defaults.

Desktop portals.conf files do not name the experimental Credential
interface, so under GNOME (default=gnome;gtk) or KDE the portal never
found credentialsd. When the experimental flag is set and no
configuration picks a backend, use an installed backend that implements
the interface, unless a configuration asks for none.
---
 ...handler.portal.experimental.Credential.xml |  22 +++
 src/credential.c                              | 125 +++++++++++++++++-
 src/xdp-portal-config.c                       |  34 +++++
 src/xdp-portal-config.h                       |   3 +
 4 files changed, 183 insertions(+), 1 deletion(-)

diff --git a/data/org.freedesktop.handler.portal.experimental.Credential.xml b/data/org.freedesktop.handler.portal.experimental.Credential.xml
index be6acca..ab0830e 100644
--- a/data/org.freedesktop.handler.portal.experimental.Credential.xml
+++ b/data/org.freedesktop.handler.portal.experimental.Credential.xml
@@ -147,6 +147,28 @@
       <arg type="a{sv}" name="results" direction="out"/>
     </method>
 
+    <!--
+        GetClientCapabilities:
+        @capabilities: Vardict of booleans, keyed by the WebAuthn client
+          capability names in snake_case.
+
+        Returns what the handler can do right now, for example
+        ``user_verifying_platform_authenticator`` when a platform
+        authenticator with user verification is available. The frontend
+        reports these values in its properties.
+
+        Supported keys: ``conditional_create``, ``conditional_get``,
+        ``hybrid_transport``, ``passkey_platform_authenticator``,
+        ``user_verifying_platform_authenticator``, ``related_origins``,
+        ``signal_all_accepted_credentials``, ``signal_current_user_details``
+        and ``signal_unknown_credential``. Missing keys keep the frontend's
+        default.
+    -->
+    <method name="GetClientCapabilities">
+      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
+      <arg type="a{sv}" name="capabilities" direction="out"/>
+    </method>
+
     <property name="version" type="u" access="read"/>
   </interface>
 </node>
diff --git a/src/credential.c b/src/credential.c
index 89bad0c..1e19b35 100644
--- a/src/credential.c
+++ b/src/credential.c
@@ -56,6 +56,9 @@ struct _XdpCredential
 
   XdpContext *context;
   XdpDbusExperimentalHandlerCredential *handler;
+
+  /* When the capabilities were last read from the handler. */
+  gint64 capabilities_read_at;
 };
 
 #define XDP_TYPE_CREDENTIAL (xdp_dbus_experimental_credential_get_type ())
@@ -88,11 +91,131 @@ static void xdp_credential_dispose (GObject *object)
 
 static void xdp_credential_init (XdpCredential *credential) {}
 
+/*
+ * The capability properties follow the handler: it knows whether a platform
+ * authenticator is available right now (one may be installed, unlocked or
+ * started at any time). They are read from GetClientCapabilities() when a
+ * client reads one of them, at most once per CAPABILITIES_TTL_US.
+ */
+#define CAPABILITIES_TTL_US (2 * G_USEC_PER_SEC)
+#define CAPABILITIES_TIMEOUT_MS 3000
+
+static GDBusInterfaceVTable *(*parent_get_vtable) (GDBusInterfaceSkeleton *skeleton);
+static GDBusInterfaceVTable credential_vtable;
+
+static const struct {
+  const char *property;
+  const char *key;
+  void (*set) (XdpDbusExperimentalCredential *object, gboolean value);
+} capabilities[] = {
+  { "ConditionalCreate", "conditional_create",
+    xdp_dbus_experimental_credential_set_conditional_create },
+  { "ConditionalGet", "conditional_get",
+    xdp_dbus_experimental_credential_set_conditional_get },
+  { "HybridTransport", "hybrid_transport",
+    xdp_dbus_experimental_credential_set_hybrid_transport },
+  { "PasskeyPlatformAuthenticator", "passkey_platform_authenticator",
+    xdp_dbus_experimental_credential_set_passkey_platform_authenticator },
+  { "UserVerifyingPlatformAuthenticator", "user_verifying_platform_authenticator",
+    xdp_dbus_experimental_credential_set_user_verifying_platform_authenticator },
+  { "RelatedOrigins", "related_origins",
+    xdp_dbus_experimental_credential_set_related_origins },
+  { "SignalAllAcceptedCredentials", "signal_all_accepted_credentials",
+    xdp_dbus_experimental_credential_set_signal_all_accepted_credentials },
+  { "SignalCurrentUserDetails", "signal_current_user_details",
+    xdp_dbus_experimental_credential_set_signal_current_user_details },
+  { "SignalUnknownCredential", "signal_unknown_credential",
+    xdp_dbus_experimental_credential_set_signal_unknown_credential },
+};
+
+static gboolean
+is_capability_property (const char *property_name)
+{
+  for (size_t i = 0; i < G_N_ELEMENTS (capabilities); i++)
+    if (g_str_equal (capabilities[i].property, property_name))
+      return TRUE;
+
+  return FALSE;
+}
+
+static void
+xdp_credential_refresh_capabilities (XdpCredential *credential)
+{
+  g_autoptr(GVariant) reply = NULL;
+  g_autoptr(GVariant) caps = NULL;
+  g_autoptr(GError) error = NULL;
+  gint64 now = g_get_monotonic_time ();
+
+  if (credential->capabilities_read_at != 0 &&
+      now - credential->capabilities_read_at < CAPABILITIES_TTL_US)
+    return;
+
+  credential->capabilities_read_at = now;
+
+  reply = g_dbus_proxy_call_sync (G_DBUS_PROXY (credential->handler),
+                                  "GetClientCapabilities",
+                                  NULL,
+                                  G_DBUS_CALL_FLAGS_NONE,
+                                  CAPABILITIES_TIMEOUT_MS,
+                                  NULL,
+                                  &error);
+  if (reply == NULL)
+    {
+      /* A handler without the method keeps the defaults. */
+      g_debug ("Could not read the handler's client capabilities: %s",
+               error->message);
+      return;
+    }
+
+  g_variant_get (reply, "(@a{sv})", &caps);
+
+  for (size_t i = 0; i < G_N_ELEMENTS (capabilities); i++)
+    {
+      gboolean value;
+
+      if (g_variant_lookup (caps, capabilities[i].key, "b", &value))
+        capabilities[i].set (XDP_DBUS_EXPERIMENTAL_CREDENTIAL (credential), value);
+    }
+}
+
+static GVariant *
+credential_get_property (GDBusConnection *connection,
+                         const char      *sender,
+                         const char      *object_path,
+                         const char      *interface_name,
+                         const char      *property_name,
+                         GError         **error,
+                         gpointer         user_data)
+{
+  /* user_data is the skeleton (GDBusInterfaceSkeleton exports it so). */
+  if (XDP_IS_CREDENTIAL (user_data) && is_capability_property (property_name))
+    xdp_credential_refresh_capabilities (XDP_CREDENTIAL (user_data));
+
+  return parent_get_vtable (G_DBUS_INTERFACE_SKELETON (user_data))->get_property (
+      connection, sender, object_path, interface_name, property_name, error, user_data);
+}
+
+static GDBusInterfaceVTable *
+credential_get_vtable (GDBusInterfaceSkeleton *skeleton)
+{
+  if (credential_vtable.get_property == NULL)
+    {
+      credential_vtable = *parent_get_vtable (skeleton);
+      credential_vtable.get_property = credential_get_property;
+    }
+
+  return &credential_vtable;
+}
+
 static void xdp_credential_class_init (XdpCredentialClass *klass)
 {
   GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GDBusInterfaceSkeletonClass *skeleton_class = G_DBUS_INTERFACE_SKELETON_CLASS (klass);
 
   object_class->dispose = xdp_credential_dispose;
+
+  parent_get_vtable = skeleton_class->get_vtable;
+  skeleton_class->get_vtable = credential_get_vtable;
 }
 
 static XdpCredential *
@@ -347,7 +470,7 @@ init_credential (gpointer user_data)
     XdpImplConfig *impl_config;
 
     impl_config =
-        xdp_portal_config_find (config, CREDENTIAL_EXPERIMENTAL_DBUS_IMPL_IFACE);
+        xdp_portal_config_find_experimental (config, CREDENTIAL_EXPERIMENTAL_DBUS_IMPL_IFACE);
 
     if (impl_config == NULL) {
       g_debug ("impl_config is NULL");
diff --git a/src/xdp-portal-config.c b/src/xdp-portal-config.c
index 931f30e..d145d3d 100644
--- a/src/xdp-portal-config.c
+++ b/src/xdp-portal-config.c
@@ -924,6 +924,40 @@ xdp_portal_config_find (XdpPortalConfig *portal_config,
                                                           interface);
 }
 
+/*
+ * An experimental portal is only started when its feature flag is set in
+ * XDG_DESKTOP_PORTAL_ENABLE_EXPERIMENTAL. Desktop portals.conf files do
+ * not name experimental interfaces yet, so when no configuration picks a
+ * backend, use any installed backend that implements the interface,
+ * unless a configuration asks for none.
+ */
+XdpImplConfig *
+xdp_portal_config_find_experimental (XdpPortalConfig *portal_config,
+                                     const char      *interface)
+{
+  GPtrArray *configs = portal_config->configs;
+  XdpImplConfig *impl_config;
+
+  impl_config = xdp_portal_config_find (portal_config, interface);
+  if (impl_config != NULL)
+    return impl_config;
+
+  for (size_t i = 0; i < configs->len; i++)
+    {
+      PortalConfig *config = g_ptr_array_index (configs, i);
+
+      if (portal_config_interface_prefers_none (config, interface))
+        return NULL;
+    }
+
+  impl_config = xdp_portal_config_find_any_impl_config (portal_config, interface);
+  if (impl_config != NULL)
+    g_debug ("Using %s.portal for experimental %s (no configuration names it)",
+             impl_config->source, interface);
+
+  return impl_config;
+}
+
 GPtrArray *
 xdp_portal_config_find_all (XdpPortalConfig *portal_config,
                             const char      *interface)
diff --git a/src/xdp-portal-config.h b/src/xdp-portal-config.h
index c5341cc..3872369 100644
--- a/src/xdp-portal-config.h
+++ b/src/xdp-portal-config.h
@@ -47,3 +47,6 @@ XdpImplConfig * xdp_portal_config_find (XdpPortalConfig *portal_config,
 
 GPtrArray * xdp_portal_config_find_all (XdpPortalConfig *portal_config,
                                         const char      *impl_interface);
+
+XdpImplConfig * xdp_portal_config_find_experimental (XdpPortalConfig *portal_config,
+                                                     const char      *impl_interface);
-- 
2.50.1 (Apple Git-155)


#!/bin/sh
# speakerguardd-v2-gate: ExecCondition of speakerguardd 1.0's units.
#
# speakerguardd 1.0 starts only on a Mac whose board passed the 1.0
# qualification (a passing audible hardware run on the shipped tree). On any
# other Mac it does not start, says so in the journal, and the kernel keeps
# the speakers at its safe level. Its protection unit type (spp3, lsm2,
# atsp) must be at parity before a board is added here.
#
# The same file ships in fedora-aurora, alarm-aurora and nixos-aurora.
#
# Exit 0: start. Exit 1: skip the unit (systemd logs the condition).

# Boards qualified on speakerguardd 1.0, by device-tree compatible.
QUALIFIED="j616s j316s j413"

# An administrator may run 1.0 on a board that has not qualified, for
# qualification itself, by naming the board in this file (one per line).
ALLOW=/etc/speakerguardd/allow-unqualified

if [ ! -r /proc/device-tree/compatible ]; then
    echo "speakerguardd-v2: no device tree; not an Apple Silicon Mac, not starting" >&2
    exit 1
fi
board=$(tr '\0' '\n' </proc/device-tree/compatible | head -n 1)
board=${board#apple,}

for b in $QUALIFIED; do
    [ "$b" = "$board" ] && exit 0
done
if [ -r "$ALLOW" ] && grep -qx "$board" "$ALLOW"; then
    echo "speakerguardd-v2: $board has not qualified on speakerguardd 1.0; starting because $ALLOW names it" >&2
    exit 0
fi
echo "speakerguardd-v2: $board has not qualified on speakerguardd 1.0 (qualified: $QUALIFIED); not starting." \
     "The kernel holds the speakers at its safe level. Remove speakerguardd-v2-replace-legacy to return to speakerguardd 0.1." >&2
exit 1

#!/usr/bin/python3
"""Exit successfully only when this boot admitted the fingerprint calibration
and the installed record is still the one admitted."""
import hashlib
import json
import os
import stat


MARKER = '/run/aurora-sep/calibration-ready'


def private(fd):
    info = os.fstat(fd)
    return (stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid()
            and info.st_nlink == 1 and stat.S_IMODE(info.st_mode) == 0o600)


def read_private(path, limit):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        if not private(fd):
            raise OSError(f'{path} is not a private regular file')
        with os.fdopen(os.dup(fd), 'rb') as f:
            data = f.read(limit + 1)
        if len(data) > limit:
            raise OSError(f'{path} is oversized')
        return data
    finally:
        os.close(fd)


def ready(marker=MARKER):
    record = json.loads(read_private(marker, 64 * 1024))
    installed = read_private(record['target'], 16 * 1024 * 1024)
    return hashlib.sha256(installed).hexdigest() == record['sha256']


if __name__ == '__main__':
    try:
        raise SystemExit(0 if ready() else 1)
    except (OSError, ValueError, KeyError, TypeError):
        raise SystemExit(1)

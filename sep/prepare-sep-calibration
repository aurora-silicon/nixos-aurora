#!/usr/bin/python3
"""Prepare this Mac's optional fingerprint calibration without writing the input."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import tempfile


DEVICE = Path('/dev/disk/by-partlabel/iBootSystemContainer')
STATE = Path('/var/lib/aurora-sep')
EXTRACTOR = Path('/usr/libexec/aurora/extract-mesa-calibration')
DT = Path('/sys/firmware/devicetree/base')


def private_directory(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    mode = path.lstat()
    if not stat.S_ISDIR(mode.st_mode) or mode.st_uid != os.geteuid():
        raise ValueError(f'unsafe state directory: {path}')
    path.chmod(0o700)


def regular(path):
    try:
        info = path.lstat()
    except FileNotFoundError:
        return False
    return (stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid()
            and info.st_nlink == 1 and not info.st_mode & 0o077)


def atomic_write(path, data, mode=0o600):
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as out:
            os.fchmod(out.fileno(), mode)
            out.write(data)
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        Path(temporary).unlink(missing_ok=True)


def firmware_name(tree):
    names = set()
    for item in tree.rglob('compatible'):
        if b'apple,mesa-fingerprint' not in item.read_bytes().split(b'\0'):
            continue
        name = item.with_name('firmware-name')
        if name.exists():
            names.add(name.read_bytes().rstrip(b'\0').decode('ascii'))
    if len(names) > 1:
        raise ValueError('conflicting fingerprint firmware names')
    name = next(iter(names), 'apple/mesa_calibration.bin')
    if not re.fullmatch(r'apple/[A-Za-z0-9_.-]+\.bin', name):
        raise ValueError('unsafe fingerprint firmware name')
    return name


def prepare(device, partuuid, state, firmware, name, extractor):
    private_directory(state)
    lock = os.open(state / '.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        blob = state / 'mesa-calibration.bin'
        identity = state / 'calibration.identity'
        data = None
        if regular(blob) and regular(identity):
            try:
                value = blob.read_bytes()
                record = json.loads(identity.read_text())
                if (value and record == {'partuuid': partuuid,
                        'sha256': hashlib.sha256(value).hexdigest()}):
                    data = value
            except (ValueError, OSError):
                pass
        if data is None:
            with tempfile.TemporaryDirectory(prefix='.extract-', dir=state) as tmp:
                output = Path(tmp) / 'calibration.bin'
                subprocess.run([str(extractor), str(device), '--output', str(output)], check=True)
                if not regular(output) or not 0 < output.stat().st_size <= 4 * 1024 * 1024:
                    raise ValueError('unsafe or oversized calibration output')
                data = output.read_bytes()
            atomic_write(blob, data)
            atomic_write(identity, (json.dumps({'partuuid': partuuid,
                'sha256': hashlib.sha256(data).hexdigest()}) + '\n').encode())
        parent = firmware / 'apple'
        parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        if not stat.S_ISDIR(parent.lstat().st_mode):
            raise ValueError('unsafe fingerprint firmware directory')
        atomic_write(firmware / name, data)
    finally:
        os.close(lock)


def main():
    if not stat.S_ISBLK(DEVICE.stat().st_mode):
        raise ValueError('calibration input is not a block device')
    partuuid = subprocess.check_output(['blkid', '-s', 'PARTUUID', '-o', 'value', str(DEVICE)], text=True).strip()
    if not re.fullmatch(r'[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}', partuuid):
        raise ValueError('invalid calibration source identity')
    firmware = Path('/sys/module/firmware_class/parameters/path').read_text().strip()
    prepare(DEVICE, partuuid, STATE, Path(firmware or '/usr/lib/firmware'), firmware_name(DT), EXTRACTOR)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        # Some models have no reader. SEP trusted keys must still start.
        print(f'aurora-sep: fingerprint calibration unavailable: {error}', flush=True)

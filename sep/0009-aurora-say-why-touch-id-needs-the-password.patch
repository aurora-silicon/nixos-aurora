From 290e2cafc2af5be561422d030d42babfec63e420 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:15:24 +1100
Subject: [PATCH] aurora: say why Touch ID needs the password

The kernel refuses a verify with SEP_BIO_STATUS_LOCKOUT whether Touch ID
waits for the first password since boot (the administrator's
require_password_after_boot setting), is locked after five failed
matches, or needs the password because the enclave's match credential
lapsed. All three became FP_DEVICE_ERROR_LOCKED_OUT, so the login screen
said "Too many failed fingerprint attempts" after a plain restart, where
macOS says "Your password is required to enable Touch ID".

Ask the kernel why with SEP_BIO_LOCKOUT_STATE on /dev/sep-bio, and report
the wait after boot as the new FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT,
a lockout after failed matches as FP_DEVICE_ERROR_LOCKED_OUT, and any other
reason as the new FP_DEVICE_ERROR_PASSWORD_REQUIRED. Kernels that cannot
say answer -ENOTTY there and keep FP_DEVICE_ERROR_LOCKED_OUT.

Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Assisted-by: LLM
---
 libfprint/drivers/aurora/aurora.c | 76 ++++++++++++++++++++++++++++---
 libfprint/fp-device.h             |  8 ++++
 libfprint/fpi-device.c            |  8 ++++
 3 files changed, 86 insertions(+), 6 deletions(-)

diff --git a/libfprint/drivers/aurora/aurora.c b/libfprint/drivers/aurora/aurora.c
index 308015b..3cb7509 100644
--- a/libfprint/drivers/aurora/aurora.c
+++ b/libfprint/drivers/aurora/aurora.c
@@ -57,6 +57,21 @@
 #define SEP_BIO_STATUS_LOCKOUT 8
 #endif
 
+/* Why Touch ID needs the password, from SEP_BIO_LOCKOUT_STATE. Kernels that
+ * say why answer it on /dev/sep-bio as well as on the re-arm node; older ones
+ * answer -ENOTTY there. The layout is the same in every kernel, so it is
+ * spelled out here rather than taken from headers that may predate 'flags'. */
+struct aurora_lockout_state
+{
+  guint32 locked;
+  guint32 failures;
+  guint32 reserved;
+  guint32 flags;
+};
+#define AURORA_LOCKOUT_STATE _IOR (0xB1, 0x0e, struct aurora_lockout_state)
+#define AURORA_LOCKOUT_FLAG_AFTER_BOOT      2
+#define AURORA_LOCKOUT_FLAG_FAILED_ATTEMPTS 4
+
 struct _FpiDeviceAurora
 {
   FpDevice  parent;
@@ -194,6 +209,52 @@ aurora_status_reason (guint32 status)
     }
 }
 
+/* A refused verify says only that Touch ID needs the password. Ask the kernel
+ * why, so that login screens can tell a lockout after failed attempts from
+ * the wait for the first password since boot, which the administrator asked
+ * for and which macOS words as "Your password is required to enable Touch
+ * ID". A kernel that cannot say keeps the lockout, as before. */
+static GError *
+aurora_lockout_new (FpiDeviceAurora *self, const gchar *operation)
+{
+  struct aurora_lockout_state state = { 0 };
+
+  if (self == NULL || self->fd < 0 ||
+      ioctl (self->fd, AURORA_LOCKOUT_STATE, &state) < 0)
+    return fpi_device_error_new_msg (FP_DEVICE_ERROR_LOCKED_OUT,
+                                     "%s failed: %s (driver status %u)",
+                                     operation,
+                                     aurora_status_reason (SEP_BIO_STATUS_LOCKOUT),
+                                     SEP_BIO_STATUS_LOCKOUT);
+
+  fp_dbg ("lockout state: locked %u, failures %u, flags 0x%x",
+          state.locked, state.failures, state.flags);
+
+  /* The wait after boot comes first: the kernel checks it first, and the
+   * first password ends a lockout along with it. */
+  if (state.flags & AURORA_LOCKOUT_FLAG_AFTER_BOOT)
+    return fpi_device_error_new_msg (FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT,
+                                     "%s refused: Touch ID waits for the first "
+                                     "password since the system started",
+                                     operation);
+
+  if (state.flags & AURORA_LOCKOUT_FLAG_FAILED_ATTEMPTS)
+    return fpi_device_error_new_msg (FP_DEVICE_ERROR_LOCKED_OUT,
+                                     "%s failed: Touch ID is locked after too "
+                                     "many failed attempts (%u since the last "
+                                     "match or password); authenticate with the "
+                                     "password to use it again",
+                                     operation, state.failures);
+
+  /* Locked for another reason (the enclave's match credential lapsed), or no
+   * longer locked at all because a password re-armed it meanwhile: either way
+   * the password is what the user needs, without blaming their finger. */
+  return fpi_device_error_new_msg (FP_DEVICE_ERROR_PASSWORD_REQUIRED,
+                                   "%s refused: Touch ID needs the password "
+                                   "before it matches again",
+                                   operation);
+}
+
 static GError *
 aurora_failure_new (const gchar *operation, guint32 status)
 {
@@ -202,9 +263,7 @@ aurora_failure_new (const gchar *operation, guint32 status)
   /* Its own code, so that fprintd sends the user to the password instead of
    * retrying a reader that refuses every attempt until then. */
   if (status == SEP_BIO_STATUS_LOCKOUT)
-    return fpi_device_error_new_msg (FP_DEVICE_ERROR_LOCKED_OUT,
-                                     "%s failed: %s (driver status %u)",
-                                     operation, reason, status);
+    return aurora_lockout_new (NULL, operation);
 
   if (reason == NULL)
     return fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
@@ -838,8 +897,13 @@ aurora_result_is_match (FpiDeviceAurora                *self,
 /* A verify that ended without a comparison. When the kernel says why, pass
  * that on: otherwise the log shows only an unspecified error. */
 static GError *
-aurora_not_compared_new (const struct sep_bio_verify_poll *res)
+aurora_not_compared_new (FpiDeviceAurora                 *self,
+                         const struct sep_bio_verify_poll *res)
 {
+  if (res->state == SEP_BIO_STATE_FAILED &&
+      res->status == SEP_BIO_STATUS_LOCKOUT)
+    return aurora_lockout_new (self, "verification");
+
   if (res->state == SEP_BIO_STATE_FAILED)
     return aurora_failure_new ("verification", res->status);
 
@@ -950,7 +1014,7 @@ aurora_verify_ready (gint fd, GIOCondition condition, gpointer user_data)
           /* No comparison happened, so there is no verdict to report. Saying
            * FAIL here would tell the user their finger was rejected when it
            * was never examined. */
-          fpi_device_verify_complete (device, aurora_not_compared_new (&res));
+          fpi_device_verify_complete (device, aurora_not_compared_new (self, &res));
         }
       else if (res.result == SEP_BIO_MATCH && matched == NULL)
         {
@@ -1006,7 +1070,7 @@ aurora_verify_ready (gint fd, GIOCondition condition, gpointer user_data)
         }
       else if (matched == NULL && res.result == SEP_BIO_NOT_COMPARED)
         {
-          fpi_device_identify_complete (device, aurora_not_compared_new (&res));
+          fpi_device_identify_complete (device, aurora_not_compared_new (self, &res));
         }
       else
         {
diff --git a/libfprint/fp-device.h b/libfprint/fp-device.h
index c7af2b2..ebb5277 100644
--- a/libfprint/fp-device.h
+++ b/libfprint/fp-device.h
@@ -146,6 +146,12 @@ typedef enum {
  * @FP_DEVICE_ERROR_LOCKED_OUT: The device refuses to match, after too many
  *   failed attempts, until the user authenticates another way, such as with
  *   a password
+ * @FP_DEVICE_ERROR_PASSWORD_REQUIRED: The device refuses to match until the
+ *   user authenticates with their password, for a reason other than failed
+ *   attempts
+ * @FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT: The device refuses to match
+ *   until the first password authentication since the system started, as
+ *   the administrator asked
  *
  * Error codes for device operations. More specific errors from other domains
  * such as #G_IO_ERROR or #G_USB_DEVICE_ERROR may also be reported.
@@ -165,6 +171,8 @@ typedef enum {
   FP_DEVICE_ERROR_REMOVED = 0x100,
   FP_DEVICE_ERROR_TOO_HOT,
   FP_DEVICE_ERROR_LOCKED_OUT,
+  FP_DEVICE_ERROR_PASSWORD_REQUIRED,
+  FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT,
 } FpDeviceError;
 
 GQuark fp_device_retry_quark (void);
diff --git a/libfprint/fpi-device.c b/libfprint/fpi-device.c
index 4149afc..e848ad9 100644
--- a/libfprint/fpi-device.c
+++ b/libfprint/fpi-device.c
@@ -278,6 +278,14 @@ fpi_device_error_new (FpDeviceError error)
       msg = "Fingerprint matching is locked; authenticate with your password to use it again.";
       break;
 
+    case FP_DEVICE_ERROR_PASSWORD_REQUIRED:
+      msg = "Your password is required to use fingerprint matching.";
+      break;
+
+    case FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT:
+      msg = "Your password is required to enable fingerprint matching after a restart.";
+      break;
+
     default:
       g_warning ("Unsupported error, returning general error instead!");
       error = FP_DEVICE_ERROR_GENERAL;
-- 
2.50.1 (Apple Git-155)


From c22b9fda5e1bf512087cf20649c947dcda8fc6e0 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 8 Nov 2026 21:16:06 +1100
Subject: [PATCH] fprintd: say why the reader needs the password

A reader can refuse to match for reasons other than failed attempts: Touch
ID waits for the first password since boot when the administrator asks for
that, as macOS does after a restart, and it needs the password again when
its match credential lapses. libfprint now reports these as
FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT and
FP_DEVICE_ERROR_PASSWORD_REQUIRED, which fprintd turned into
verify-unknown-error.

Report them as verify-password-required-after-boot and
verify-password-required. pam_fprintd words the first as macOS does, "Your
password is required to enable Touch ID.", the second as "Your password is
required to use Touch ID.", treats any later verify-password-required-*
result like the second, and in every case returns PAM_AUTHINFO_UNAVAIL at
once so the stack goes straight to the password. "Too many failed
fingerprint attempts" is left for verify-lockout alone.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
---
 pam/pam_fprintd.c                     | 16 ++++++++++++++++
 src/device.c                          |  4 ++++
 src/net.reactivated.Fprint.Device.xml | 12 ++++++++++++
 tests/dbusmock/fprintd.py             |  3 +++
 tests/fprintd.py                      | 11 +++++++++++
 tests/pam/test_pam_fprintd.py         | 23 +++++++++++++++++++++++
 6 files changed, 69 insertions(+)

diff --git a/pam/pam_fprintd.c b/pam/pam_fprintd.c
index f180385..56d6e78 100644
--- a/pam/pam_fprintd.c
+++ b/pam/pam_fprintd.c
@@ -629,6 +629,22 @@ do_verify (sd_bus      *bus,
               send_err_msg (data->pamh, _("Too many failed fingerprint attempts. Use your password."));
               return PAM_AUTHINFO_UNAVAIL;
             }
+          else if (str_equal (data->result, "verify-password-required-after-boot"))
+            {
+              /* Asked for by the administrator, as macOS does after a
+               * restart; not a failure, so use macOS's words for it. */
+              send_err_msg (data->pamh, _("Your password is required to enable Touch ID."));
+              return PAM_AUTHINFO_UNAVAIL;
+            }
+          else if (data->result &&
+                   strncmp (data->result, "verify-password-required",
+                            strlen ("verify-password-required")) == 0)
+            {
+              /* verify-password-required, and any later reason of the same
+               * kind: the password, without blaming the finger. */
+              send_err_msg (data->pamh, _("Your password is required to use Touch ID."));
+              return PAM_AUTHINFO_UNAVAIL;
+            }
           else
             {
               send_err_msg (data->pamh, _("An unknown error occurred"));
diff --git a/src/device.c b/src/device.c
index a7b380d..9b4cc8b 100644
--- a/src/device.c
+++ b/src/device.c
@@ -624,6 +624,10 @@ verify_result_to_name (gboolean match, GError *error)
         return "verify-disconnected";
       else if (g_error_matches (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_LOCKED_OUT))
         return "verify-lockout";
+      else if (g_error_matches (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT))
+        return "verify-password-required-after-boot";
+      else if (g_error_matches (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PASSWORD_REQUIRED))
+        return "verify-password-required";
       else if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED) ||
                g_error_matches (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_NOT_FOUND))
         return "verify-no-match";
diff --git a/src/net.reactivated.Fprint.Device.xml b/src/net.reactivated.Fprint.Device.xml
index e9c4843..fc07cb7 100644
--- a/src/net.reactivated.Fprint.Device.xml
+++ b/src/net.reactivated.Fprint.Device.xml
@@ -199,6 +199,18 @@
 							The device refuses to match after too many failed attempts. It keeps refusing until the user authenticates another way, such as with their password, so the user should be asked for that instead. The verification is over.
 						</doc:definition>
 					</doc:item>
+					<doc:item>
+						<doc:term>verify-password-required-after-boot</doc:term>
+						<doc:definition>
+							The device does not match until the first password authentication since the system started, as the administrator asked; nothing is wrong with the finger. Ask the user for their password instead, which also enables the reader again. The verification is over.
+						</doc:definition>
+					</doc:item>
+					<doc:item>
+						<doc:term>verify-password-required</doc:term>
+						<doc:definition>
+							The device does not match until the user authenticates with their password, for a reason other than failed attempts. Ask the user for their password instead, which also enables the reader again. The verification is over. Results that start with verify-password-required and are not listed here mean the same.
+						</doc:definition>
+					</doc:item>
 					<doc:item>
 						<doc:term>verify-unknown-error</doc:term>
 						<doc:definition>
diff --git a/tests/dbusmock/fprintd.py b/tests/dbusmock/fprintd.py
index bc427cb..9263583 100644
--- a/tests/dbusmock/fprintd.py
+++ b/tests/dbusmock/fprintd.py
@@ -58,6 +58,9 @@ VALID_VERIFY_STATUS = [
     'verify-finger-not-centered',
     'verify-remove-and-retry',
     'verify-disconnected',
+    'verify-lockout',
+    'verify-password-required-after-boot',
+    'verify-password-required',
     'verify-unknown-error'
 ]
 
diff --git a/tests/fprintd.py b/tests/fprintd.py
index bc45720..9938875 100644
--- a/tests/fprintd.py
+++ b/tests/fprintd.py
@@ -2794,6 +2794,17 @@ class FPrintdVirtualDeviceVerificationTests(FPrintdVirtualDeviceBaseTest):
     def test_verify_error_data_full(self):
         self.assertVerifyError(FPrint.DeviceError.DATA_FULL, 'verify-unknown-error')
 
+    def test_verify_error_locked_out(self):
+        self.assertVerifyError(FPrint.DeviceError.LOCKED_OUT, 'verify-lockout')
+
+    def test_verify_error_password_required(self):
+        self.assertVerifyError(FPrint.DeviceError.PASSWORD_REQUIRED,
+                               'verify-password-required')
+
+    def test_verify_error_password_required_after_boot(self):
+        self.assertVerifyError(FPrint.DeviceError.PASSWORD_REQUIRED_AFTER_BOOT,
+                               'verify-password-required-after-boot')
+
     def test_multiple_verify(self):
         self.send_image('tented_arch')
         self.assertVerifyNoMatch()
diff --git a/tests/pam/test_pam_fprintd.py b/tests/pam/test_pam_fprintd.py
index 54943e4..cfe6871 100644
--- a/tests/pam/test_pam_fprintd.py
+++ b/tests/pam/test_pam_fprintd.py
@@ -122,6 +122,29 @@ class TestPamFprintd(dbusmock.DBusTestCase):
         self.assertRegex(res.info[0], r'Swipe your left little finger across the fingerprint reader')
         self.assertEqual(len(res.errors), 0)
 
+    def assert_password_message(self, result, message):
+        self.setup_device()
+        self.device_mock.SetVerifyScript([ ( result, True, 2 ) ])
+
+        tc = pypamtest.TestCase(pypamtest.PAMTEST_AUTHENTICATE, expected_rv=PAM_AUTHINFO_UNAVAIL)
+        res = pypamtest.run_pamtest("toto", "fprintd-pam-test", [tc], [ 'unused' ])
+
+        self.assertRegex(res.info[0], r'Swipe your left little finger across the fingerprint reader')
+        self.assertEqual(len(res.errors), 1)
+        self.assertEqual(res.errors[0], message)
+
+    def test_pam_fprintd_lockout(self):
+        self.assert_password_message('verify-lockout',
+                                     'Too many failed fingerprint attempts. Use your password.')
+
+    def test_pam_fprintd_password_required_after_boot(self):
+        self.assert_password_message('verify-password-required-after-boot',
+                                     'Your password is required to enable Touch ID.')
+
+    def test_pam_fprintd_password_required(self):
+        self.assert_password_message('verify-password-required',
+                                     'Your password is required to use Touch ID.')
+
     def test_pam_fprintd_identify_error3(self):
         self.setup_device()
         script = [

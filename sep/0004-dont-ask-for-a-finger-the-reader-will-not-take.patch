+    def set_password_required(self, device_error):
+        self.send_command('SET_PASSWORD_REQUIRED', int(device_error))
+
     def enroll_print(self, nick, finger='right-index-finger', expected_result='enroll-completed'):
         # Using the name of the image as the print id
         super().enroll_image(img=nick, finger=finger, expected_result=expected_result)
@@ -2429,6 +2432,68 @@ class FPrintdVirtualDeviceClaimedTest(FPrintdVirtualDeviceBaseTest):
             self.device.DeleteEnrolledFingers('(s)', 'nottestuser')
 
 
+class FPrintdVirtualDevicePasswordRequiredTests(FPrintdVirtualStorageDeviceBaseTest):
+
+    def setUp(self):
+        super().setUp()
+        self.device.Claim('(s)', 'testuser')
+
+    def tearDown(self):
+        self.try_release()
+        super().tearDown()
+
+    def assertVerifyNeedsPassword(self, device_error, expected_result, finger):
+        self.set_password_required(device_error)
+        self.device.VerifyStart('(s)', finger)
+        # The device refuses the match as soon as it starts.
+        self.send_error(error=device_error)
+        self.wait_for_result()
+        self.assertTrue(self._verify_stopped)
+        self.assertEqual(self._last_result, expected_result)
+        # No finger was asked for.
+        self.assertIsNone(self._selected_finger)
+        self.device.VerifyStop()
+
+    def test_verify_password_required_after_boot_asks_no_finger(self):
+        self.enroll_image('whorl', finger='left-thumb')
+        self.assertVerifyNeedsPassword(FPrint.DeviceError.PASSWORD_REQUIRED_AFTER_BOOT,
+                                       'verify-password-required-after-boot', 'any')
+
+    def test_verify_finger_password_required_after_boot_asks_no_finger(self):
+        self.enroll_image('whorl', finger='left-thumb')
+        self.assertVerifyNeedsPassword(FPrint.DeviceError.PASSWORD_REQUIRED_AFTER_BOOT,
+                                       'verify-password-required-after-boot', 'left-thumb')
+
+    def test_verify_lockout_asks_no_finger(self):
+        self.enroll_image('whorl', finger='left-thumb')
+        self.assertVerifyNeedsPassword(FPrint.DeviceError.LOCKED_OUT,
+                                       'verify-lockout', 'any')
+
+    def test_identify_password_required_after_boot_asks_no_finger(self):
+        self.enroll_image('whorl', finger='left-thumb')
+        self.enroll_image('tented_arch', finger='right-thumb')
+        self.assertVerifyNeedsPassword(FPrint.DeviceError.PASSWORD_REQUIRED_AFTER_BOOT,
+                                       'verify-password-required-after-boot', 'any')
+
+    def test_verify_after_password_asks_for_finger(self):
+        self.enroll_image('whorl', finger='left-thumb')
+        self.assertVerifyNeedsPassword(FPrint.DeviceError.PASSWORD_REQUIRED_AFTER_BOOT,
+                                       'verify-password-required-after-boot', 'any')
+        self.set_password_required(0)
+        self.device.VerifyStart('(s)', 'any')
+        self.send_image('whorl')
+        self.wait_for_result()
+        self.assertTrue(self._verify_stopped)
+        self.assertEqual(self._last_result, 'verify-match')
+        self.assertEqual(self._selected_finger, 'left-thumb')
+        self.device.VerifyStop()
+
+
+class FPrintdVirtualNoStorageDevicePasswordRequiredTests(FPrintdVirtualNoStorageDeviceBaseTest,
+                                                        FPrintdVirtualDevicePasswordRequiredTests):
+    pass
+

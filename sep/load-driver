#!/bin/sh
set -eu

# Prefix for the /proc, /etc, /run, /sys and /var/lib paths below, for tests.
root=${AURORA_SEP_ROOT:-}

keybag=$root/var/lib/aurora-sep-keybag.bin
refkey=$root/var/lib/aurora-sep-refkey.bin
devices=${AURORA_SEP_SYSFS:-/sys/bus/platform/devices}

# Seconds to wait for the enclave's bring-up to end. On the J700 the key store
# has arrived around 43 s after boot, and the driver waits up to 90 s for it
# before it brings Touch ID up, so this has to outlast that. Set it in the
# environment, for example with a drop-in for aurora-sep.service.
ready_timeout=${AURORA_SEP_READY_TIMEOUT:-120}

# How often to look at diag/keystore while the bring-up runs. The bring-up
# ends 1.5 to 4 s after the driver loads (diag/ready_ms on the J700, M1 Pro,
# M2 and J616s), so this adds at most a tenth of a second.
poll_interval=0.1

log() {
    echo "aurora-sep-load: $*" >&2
}

case "$ready_timeout" in
    '' | *[!0-9]*)
        log "AURORA_SEP_READY_TIMEOUT must be whole seconds, not '$ready_timeout'"
        exit 2
        ;;
esac

# Seconds since boot. Unlike the wall clock it cannot jump when the time is
# first synchronised during boot.
uptime_s() {
    read -r up _ </proc/uptime
    echo "${up%%.*}"
}

# An SSH/sudo caller cannot change its parent's session keyring with
# `keyctl new_session`. Run the whole probe in a child keyring instead; the
# marker prevents re-exec recursion and the keyring dies with this process.
if [ "${AURORA_SEP_SESSION:-0}" != 1 ]; then
    exec keyctl session aurora-sep-load env AURORA_SEP_SESSION=1 "$0" "$@"
fi

# The M5 Pro and Max (T6050) keep SEP writes off unless the owner opts in.
# xART is shared with macOS, and the paths that write it (keybag
# provisioning, Touch ID enrolment) have had no trial on a T6050; every M5
# Pro gate ran read-only. /etc/modprobe.d/aurora-sep.conf is the owner's
# choice, here as on every Mac; on a T6050 it must set both parameters.
# See XART-SAFETY.md.
read_only='xart_writes=0 provision_keybag=0'
owner_options=$root/etc/modprobe.d/aurora-sep.conf
run_options=$root/run/modprobe.d/aurora-sep.conf
# Set when the options in force on a T6050 provision no keybag.
no_provisioning=false

t6050() {
    tr '\0' '\n' 2>/dev/null <"$root/proc/device-tree/compatible" | grep -qx 'apple,t6050'
}

# The xart_writes and provision_keybag words modprobe will give apple_sep,
# from modprobe.d and the kernel command line, sorted and space-separated.
# Names are read as the kernel reads them ('-' as '_'); a bare name stays.
given_options() {
    modprobe -c 2>/dev/null | grep -E '^options apple[-_]sep ' | tr -s ' \t' '\n\n' |
        while IFS= read -r word; do
            name=$(printf '%s\n' "${word%%=*}" | tr - _)
            case "$name=$word" in
            xart_writes=*=* | provision_keybag=*=*) echo "$name=${word#*=}" ;;
            xart_writes=* | provision_keybag=*) echo "$name" ;;
            esac
        done | sort | tr '\n' ' '
}

# On a T6050, what apple_sep will get must be each parameter once, 0 or 1,
# with provision_keybag=1 only beside xart_writes=1; with $1, exactly that.
# A second value makes the kernel refuse the driver; a missing one leaves
# the kernel's default, which turns writes on. Sets $given.
check_options() {
    given=$(given_options)
    given=${given% }
    case "$given" in
    'provision_keybag=0 xart_writes=0' | 'provision_keybag=0 xart_writes=1' | 'provision_keybag=1 xart_writes=1')
        if [ -z "${1:-}" ] || [ "$given" = "$1" ]; then
            case "$given" in
            provision_keybag=0*) no_provisioning=true ;;
            esac
            return 0
        fi
        ;;
    esac
    if [ -n "${1:-}" ]; then
        log "modprobe would give apple_sep '$given', not '$read_only'; not loading it"
    else
        log "on this Mac (T6050), $owner_options must set apple_sep's xart_writes and provision_keybag once each, to 0 or 1 (provision_keybag=1 needs xart_writes=1), but modprobe would give '$given'. Other apple_sep options go in a file of another name; see XART-SAFETY.md"
    fi
    return 1
}

# Stand in for the packaged defaults for this boot. kmod takes each
# modprobe.d file name from the first of /etc, /run and /usr/lib that has
# it, so this replaces /usr/lib/modprobe.d/aurora-sep.conf (on NixOS, its
# copy in /run), and the owner's /etc file would replace this. The kernel
# refuses a second value of an apple_sep parameter and then does not load
# the driver, so each must reach it once.
set_read_only() {
    if ! { mkdir -p "${run_options%/*}" &&
        printf 'options apple_sep %s\n' "$read_only" >"$run_options.new" &&
        mv -f "$run_options.new" "$run_options"; }; then
        log "could not write $run_options; not loading apple_sep, whose defaults turn SEP writes on"
        return 1
    fi
    # If kmod did not take the file, or something else (the kernel command
    # line included) sets these too, stop here.
    check_options 'provision_keybag=0 xart_writes=0' || return 1
    log "SEP writes are off by default on this Mac (T6050): apple_sep loads with $read_only, so no keybag is provisioned and Touch ID cannot enrol. To opt in, see XART-SAFETY.md"
}

# apple_sep loaded before this ran (by hand, or this is a restart): only the
# driver can say how. Its diag/policy names the options it took.
loaded_read_only() {
    policy=
    for f in "$devices"/*.sep/diag/policy; do
        [ -r "$f" ] && read -r policy <"$f" && break
    done
    case " $policy " in
    *" xart_writes=0 "*)
        case " $policy " in
        *" provision_keybag=0 "*)
            no_provisioning=true
            log "apple_sep was already loaded, read-only ($read_only)"
            return 0
            ;;
        esac
        ;;
    esac
    log "apple_sep was loaded before aurora-sep-load on this Mac (T6050), whose SEP writes are off by default, and its diag/policy reads '${policy:-nothing}'; reboot to load it read-only"
    return 1
}

# Root unlocked by the Secure Enclave: the initrd loaded the driver in its
# key-store-only phase (1, or 2 for a root sealed to a user's password).
# Finish that attach on the real root; modprobe would do nothing for the
# loaded module and Touch ID would stay off. The SEP takes one attach per
# boot, so the driver cannot be loaded a second time.
case "$(cat "$root/sys/module/apple_sep/parameters/keystore_only" 2>/dev/null)" in
1 | 2 | Y)
    if t6050 && [ -e "$owner_options" ]; then
        # The owner's file must hold, as for a load; the initrd carries the
        # copy it was built with.
        if ! check_options; then
            log "not finishing the attach the initrd started"
            exit 1
        fi
    fi
    if t6050 && [ ! -e "$owner_options" ]; then
        # The initrd chose the driver's options, not the read-only default
        # above. The key-store-only phase writes nothing to xART here (the
        # T6050's xART guard), but finishing the attach would open it for
        # writing, and provision a keybag, if those options allow it.
        no_provisioning=true
        log "the initrd loaded apple_sep with options this Mac's (T6050) read-only default did not set, so its attach stays unfinished: the key store works, Touch ID stays off. See XART-SAFETY.md"
    else
        attached=false
        for attr in "$root"/sys/bus/platform/drivers/apple_sep/*/complete_attach; do
            [ -e "$attr" ] || continue
            if ! echo 1 >"$attr"; then
                log "could not finish the attach the initrd started"
                exit 1
            fi
            attached=true
        done
        if [ "$attached" != true ]; then
            log "the initrd loaded apple_sep for the key store, but it has no complete_attach"
            exit 1
        fi
        log "finished the attach the initrd started for the key store"
    fi
    ;;
*)
    if t6050; then
        if [ -e "$owner_options" ]; then
            if ! check_options; then
                log "not loading apple_sep"
                exit 1
            fi
            log "this Mac (T6050) keeps SEP writes off by default; $owner_options sets apple_sep's options instead ($given)"
        elif [ -e "$root/sys/module/apple_sep" ]; then
            loaded_read_only || exit 1
        else
            set_read_only || exit 1
        fi
    fi
    # Options come from modprobe.d, where /etc/modprobe.d/aurora-sep.conf replaces
    # the packaged defaults. Options given here would come after both, and the
    # kernel does not load apple_sep when a parameter is given twice.
    modprobe apple_sep
    ;;
esac

# On a SoC or board without a SEP profile the module loads but enables and
# probes nothing ("no platform profile for this SoC; the SEP stays disabled"),
# so no SEP device exists and no key will ever be sealed. Say so and stop,
# instead of holding the boot for the whole ready timeout.
sep_device=false
for d in "$devices"/*.sep; do
    [ -e "$d" ] && sep_device=true && break
done
if [ "$sep_device" != true ]; then
    log "the kernel enabled no SEP on this Mac; nothing to wait for"
    exit 0
fi

# Trusted keys are sealed under the identity keybag, and while provisioning
# is off (the T6050 default) none appears. So there is nothing to wait for,
# and nothing has failed: aurora-sep-ready then finds no keybag and reports
# Touch ID as not set up.
if [ "$no_provisioning" = true ] && [ ! -s "$keybag" ]; then
    log "this Mac (T6050) provisions no identity keybag while SEP writes are off, and it has none, so SEP trusted keys and Touch ID stay off; see XART-SAFETY.md"
    exit 0
fi

# One diag attribute of the SEP device, or "absent" when this kernel does not
# have it. Reading one takes no driver lock and sends nothing to the enclave.
diag_attr() {
    value=
    for f in "$devices"/*.sep/diag/"$1"; do
        [ -r "$f" ] && read -r value <"$f" && break
    done
    echo "${value:-absent}"
}

work=$(mktemp -d /run/aurora-sep-load.XXXXXX)
cleanup() {
    case "$work" in
        /run/aurora-sep-load.*) rm -rf -- "$work" ;;
    esac
}
trap cleanup EXIT HUP INT TERM

start=$(uptime_s)
deadline=$((start + ready_timeout))

# The kernel instantiates every key under one global mutex
# (key_construction_mutex), and a trusted key made before the enclave's
# bring-up has ended waits there for it, up to 90 s. Meanwhile no other key
# can be created, and systemd creates one for each service it starts, so the
# whole boot would stall behind the probe below. So wait first for
# diag/keystore to leave "unknown": "open" once the key store has opened,
# which leaves only the last bring-up steps (keybag provisioning, publishing
# the device nodes) for the probe to wait for, or "closed" once the bring-up
# has ended without it. The driver sends no event when it changes (no
# sysfs_notify, no uevent), so this polls;
# https://github.com/aurora-silicon/linux/issues/2313 tracks both.
keystore=$(diag_attr keystore)
while [ "$keystore" = unknown ]; do
    if [ "$(uptime_s)" -ge "$deadline" ]; then
        log "the enclave's bring-up did not end within ${ready_timeout} s (diag/keystore is still unknown)"
        exit 1
    fi
    sleep "$poll_interval"
    keystore=$(diag_attr keystore)
done

# The bring-up opens the key store at most once per boot; closed is final.
if [ "$keystore" = closed ]; then
    log "the enclave's key store did not open this boot, so no trusted key can be sealed; run 'aurora-sep status'"
    exit 1
fi

# Seal a new trusted key and load it back. The first call waits in the
# kernel for the rest of the bring-up (on a kernel without diag/keystore, for
# all of it), and after that the driver's answer is final for this boot: a
# retry gets the same one.
probe() {
    key_id=$(printf 'new 32' | keyctl padd trusted aurora-sep-check @s 2>/dev/null) || return 1
    ok=1
    if keyctl pipe "$key_id" >"$work/sealed"; then
        { printf 'load '; tr -d '\n\r ' <"$work/sealed"; } >"$work/load"
        if loaded_id=$(keyctl padd trusted aurora-sep-load-check @s <"$work/load" 2>/dev/null); then
            ok=0
            # Best effort: the session keyring dies with this process anyway.
            keyctl revoke "$loaded_id" >/dev/null 2>&1 || :
        fi
    fi
    keyctl revoke "$key_id" >/dev/null 2>&1 || :
    return "$ok"
}

if ! probe; then
    # The driver gives up creating the identity keybag for the rest of the
    # boot when it can't prove an earlier attempt left nothing; trusted keys
    # are sealed under it.
    if [ "$(diag_attr keybag)" = failed ]; then
        log "the enclave has no Touch ID keybag this boot, so no trusted key can be sealed; run 'aurora-xart status'"
    else
        log "the enclave did not seal and unseal a trusted key (key store $keystore, keybag $(diag_attr keybag)); run 'aurora-sep status'"
    fi
    exit 1
fi
log "trusted keys work after $(($(uptime_s) - start)) s"

if [ ! -s "$keybag" ] || [ ! -s "$refkey" ]; then
    log "$keybag or $refkey is missing or empty"
    exit 1
fi

# A model without a fingerprint reader can still provide SEP trusted keys.
# Biometric readiness is handled separately by aurora-sep-ready.service.
if [ -c /dev/sep-bio ]; then
    log "/dev/sep-bio is available"
else
    log "trusted keys are ready; no biometric device is present"
fi

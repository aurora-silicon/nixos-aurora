diff --git a/libfprint/drivers/aurora/aurora.c b/libfprint/drivers/aurora/aurora.c
index 3cb7509..c14db48 100644
--- a/libfprint/drivers/aurora/aurora.c
+++ b/libfprint/drivers/aurora/aurora.c
@@ -255,6 +255,26 @@ aurora_lockout_new (FpiDeviceAurora *self, const gchar *operation)
                                    operation);
 }
 
+/* Whether Touch ID refuses every match until the password, asked before a
+ * prompt shows: after a restart, as on macOS, the prompt goes straight to the
+ * password instead of asking for a finger first. A kernel that cannot say
+ * answers -ENOTTY, and the prompt asks for a finger as before. */
+static gboolean
+aurora_password_required (FpDevice *device, GError **reason)
+{
+  FpiDeviceAurora *self = FPI_DEVICE_AURORA (device);
+  struct aurora_lockout_state state = { 0 };
+
+  if (self->fd < 0 || ioctl (self->fd, AURORA_LOCKOUT_STATE, &state) < 0)
+    return FALSE;
+
+  if (!state.locked)
+    return FALSE;
+
+  g_propagate_error (reason, aurora_lockout_new (self, "verification"));
+  return TRUE;
+}
+
 static GError *
 aurora_failure_new (const gchar *operation, guint32 status)
 {
@@ -1335,6 +1355,7 @@ fpi_device_aurora_class_init (FpiDeviceAuroraClass *klass)
   dev_class->list = aurora_list;
   dev_class->delete = aurora_delete;
   dev_class->clear_storage = aurora_clear_storage;
+  dev_class->password_required = aurora_password_required;
 
   fpi_device_class_auto_initialize_features (dev_class);
 

 }
 
+static void
+test_driver_password_required_closed (void)
+{
+  g_autoptr(FpDevice) device = g_object_new (FPI_TYPE_DEVICE_FAKE, NULL);
+  FpiDeviceFake *fake_dev = FPI_DEVICE_FAKE (device);
+
+  g_autoptr(GError) reason = NULL;
+
+  fake_dev->ret_password_required = fpi_device_error_new (FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT);
+
+  /* A closed device is not asked */
+  g_assert_false (fp_device_get_password_required (device, &reason));
+  g_assert_no_error (reason);
+  g_assert_null (fake_dev->last_called_function);
+
+  g_clear_error (&fake_dev->ret_password_required);
+}
+
+static void
+test_driver_password_required_unsupported (void)
+{
+  g_autoptr(FpAutoResetClass) dev_class = auto_reset_device_class ();
+  g_autoptr(FpAutoCloseDevice) device = NULL;
+
+  g_autoptr(GError) reason = NULL;
+
+  dev_class->password_required = NULL;
+  device = auto_close_fake_device_new ();
+
+  g_assert_false (fp_device_get_password_required (device, &reason));
+  g_assert_no_error (reason);
+}
+
+static void
+test_driver_password_required_not_required (void)
+{
+  g_autoptr(FpAutoCloseDevice) device = auto_close_fake_device_new ();
+
+  g_autoptr(GError) reason = NULL;
+
+  g_assert_false (fp_device_get_password_required (device, &reason));
+  g_assert_no_error (reason);
+}
+
+static void
+test_driver_password_required_after_boot (void)
+{
+  g_autoptr(FpAutoCloseDevice) device = auto_close_fake_device_new ();
+  FpiDeviceFake *fake_dev = FPI_DEVICE_FAKE (device);
+
+  g_autoptr(GError) reason = NULL;
+
+  fake_dev->ret_password_required = fpi_device_error_new (FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT);
+
+  g_assert_true (fp_device_get_password_required (device, &reason));
+  g_assert_error (reason, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT);
+
+  /* Optional reason */
+  g_assert_true (fp_device_get_password_required (device, NULL));
+
+  g_clear_error (&fake_dev->ret_password_required);
+  g_clear_error (&reason);
+  g_assert_false (fp_device_get_password_required (device, &reason));
+  g_assert_no_error (reason);
+}
+
+static gboolean
+password_required_without_reason (FpDevice *device, GError **reason)
+{
+  return TRUE;
+}
+
+static void
+test_driver_password_required_default_reason (void)
+{
+  g_autoptr(FpAutoResetClass) dev_class = auto_reset_device_class ();
+  g_autoptr(FpAutoCloseDevice) device = NULL;
+
+  g_autoptr(GError) reason = NULL;
+
+  dev_class->password_required = password_required_without_reason;
+  device = auto_close_fake_device_new ();
+
+  g_assert_true (fp_device_get_password_required (device, &reason));
+  g_assert_error (reason, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PASSWORD_REQUIRED);
+}
+
 static void
 test_driver_set_scan_type_press (void)
 {
@@ -4110,6 +4197,11 @@ main (int argc, char *argv[])
   g_test_add_func ("/driver/is_open", test_driver_is_open);
   g_test_add_func ("/driver/get_scan_type/press", test_driver_get_scan_type_press);
   g_test_add_func ("/driver/get_scan_type/swipe", test_driver_get_scan_type_swipe);
+  g_test_add_func ("/driver/password_required/closed", test_driver_password_required_closed);
+  g_test_add_func ("/driver/password_required/unsupported", test_driver_password_required_unsupported);
+  g_test_add_func ("/driver/password_required/not_required", test_driver_password_required_not_required);
+  g_test_add_func ("/driver/password_required/after_boot", test_driver_password_required_after_boot);
+  g_test_add_func ("/driver/password_required/default_reason", test_driver_password_required_default_reason);
   g_test_add_func ("/driver/set_scan_type/press", test_driver_set_scan_type_press);
   g_test_add_func ("/driver/set_scan_type/swipe", test_driver_set_scan_type_swipe);
   g_test_add_func ("/driver/finger_status/inactive", test_driver_finger_status_inactive);

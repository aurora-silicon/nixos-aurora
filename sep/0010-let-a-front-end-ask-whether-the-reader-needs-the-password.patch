       else
         {
           g_ptr_array_add (self->pending_commands, g_steal_pointer (&cmd));
@@ -766,6 +776,18 @@ static const FpIdEntry driver_ids[] = {
   { .virtual_envvar = NULL }
 };
 
+static gboolean
+dev_password_required (FpDevice *dev, GError **reason)
+{
+  FpDeviceVirtualDevice *self = FP_DEVICE_VIRTUAL_DEVICE (dev);
+
+  if (self->password_required == 0)
+    return FALSE;
+
+  g_propagate_error (reason, fpi_device_error_new (self->password_required));
+  return TRUE;
+}
+

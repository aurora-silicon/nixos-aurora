+static gboolean
+fpi_device_fake_password_required (FpDevice *device, GError **reason)
+{
+  FpiDeviceFake *fake_dev = FPI_DEVICE_FAKE (device);
+
+  fake_dev->last_called_function = fpi_device_fake_password_required;
+
+  if (fake_dev->ret_password_required == NULL)
+    return FALSE;
+
+  g_propagate_error (reason, g_error_copy (fake_dev->ret_password_required));
+  return TRUE;
+}
+
 static void
 fpi_device_fake_class_init (FpiDeviceFakeClass *klass)
 {
@@ -351,6 +365,7 @@ fpi_device_fake_class_init (FpiDeviceFakeClass *klass)
   dev_class->clear_storage = fpi_device_fake_clear_storage;
   dev_class->suspend = fpi_device_fake_suspend;
   dev_class->resume = fpi_device_fake_resume;
+  dev_class->password_required = fpi_device_fake_password_required;
 
   fpi_device_class_auto_initialize_features (dev_class);
 }

   if ((hot_seconds = g_getenv ("FP_VIRTUAL_DEVICE_HOT_SECONDS")) &&
       *hot_seconds != '\0')
diff --git a/libfprint/fp-device.c b/libfprint/fp-device.c
index f488f71..4994774 100644
--- a/libfprint/fp-device.c
+++ b/libfprint/fp-device.c
@@ -737,6 +737,49 @@ fp_device_get_finger_status (FpDevice *device)
   return priv->finger_status;
 }
 
+/**
+ * fp_device_get_password_required:
+ * @device: A #FpDevice
+ * @reason: (out) (optional) (transfer full): Return location for the reason
+ *
+ * Tells whether the open @device refuses to match a finger until the user
+ * authenticates with their password, for example after a restart or after
+ * too many failed attempts. A verification or identification started now
+ * would end with the #FP_DEVICE_ERROR in @reason without waiting for a
+ * finger, so a front-end can ask for the password instead of a finger.
+ *
+ * The answer does not wait for the device. Devices that cannot tell, and
+ * devices that are not open, report %FALSE.
+ *
+ * Returns: %TRUE if the device refuses to match until the user
+ *   authenticates with their password
+ */
+gboolean
+fp_device_get_password_required (FpDevice *device,
+                                 GError  **reason)
+{
+  FpDevicePrivate *priv = fp_device_get_instance_private (device);
+  FpDeviceClass *cls;
+
+  g_autoptr(GError) why = NULL;
+
+  g_return_val_if_fail (FP_IS_DEVICE (device), FALSE);
+  g_return_val_if_fail (reason == NULL || *reason == NULL, FALSE);
+
+  cls = FP_DEVICE_GET_CLASS (device);
+  if (!priv->is_open || cls->password_required == NULL)
+    return FALSE;
+
+  if (!cls->password_required (device, &why))
+    return FALSE;
+
+  if (why == NULL)
+    why = fpi_device_error_new (FP_DEVICE_ERROR_PASSWORD_REQUIRED);
+
+  g_propagate_error (reason, g_steal_pointer (&why));
+  return TRUE;
+}
+
 /**
  * fp_device_get_nr_enroll_stages:
  * @device: A #FpDevice
diff --git a/libfprint/fp-device.h b/libfprint/fp-device.h
index ebb5277..a458c62 100644
--- a/libfprint/fp-device.h
+++ b/libfprint/fp-device.h
@@ -238,6 +238,8 @@ const gchar *fp_device_get_name (FpDevice *device);
 gboolean     fp_device_is_open (FpDevice *device);
 FpScanType   fp_device_get_scan_type (FpDevice *device);
 FpFingerStatusFlags fp_device_get_finger_status (FpDevice *device);
+gboolean            fp_device_get_password_required (FpDevice *device,
+                                                     GError  **reason);
 gint         fp_device_get_nr_enroll_stages (FpDevice *device);
 FpTemperature fp_device_get_temperature (FpDevice *device);
 
diff --git a/libfprint/fpi-device.h b/libfprint/fpi-device.h
index db87295..c1ec0c0 100644
--- a/libfprint/fpi-device.h
+++ b/libfprint/fpi-device.h
@@ -128,6 +128,9 @@ struct _FpIdEntry
  *    IDENTIFY or CAPTURE) and the system is about to go into suspend.
  * @resume: Called to resume an ongoing interactive action after the system has
  *    resumed from suspend.
+ * @password_required: Tells, without waiting, whether the open device refuses
+ *   to match until the user authenticates with their password; set @reason to
+ *   the #FpDeviceError a verify or identify would end with. Optional.
  *
  * NOTE: If your driver is image based, then you should subclass #FpImageDevice
  * instead. #FpImageDevice based drivers use a different way of interacting
@@ -192,6 +195,11 @@ struct _FpDeviceClass
   void (*cancel)   (FpDevice *device);
   void (*suspend)  (FpDevice *device);
   void (*resume)   (FpDevice *device);
+
+  /* Synchronous: whether an open device refuses to match until the user
+   * authenticates with their password. See fp_device_get_password_required(). */
+  gboolean (*password_required) (FpDevice *device,
+                                 GError  **reason);
 };
 
 void fpi_device_class_auto_initialize_features (FpDeviceClass *device_class);

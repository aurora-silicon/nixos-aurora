@@ -117,8 +118,31 @@
 
 
 def proton_settings_files():
-    tools = STEAM / "compatibilitytools.d"
-    return [d / "user_settings.py" for d in sorted(tools.glob("Aurora-Proton*")) if d.is_dir()]
+    """Discover native Wine tools, including Steam's configured extra paths."""
+    roots = [STEAM / "compatibilitytools.d"]
+    roots.extend(Path(p) for p in os.environ.get("STEAM_EXTRA_COMPAT_TOOLS_PATHS", "").split(":") if p)
+    tools = set()
+    for root in roots:
+        try:
+            candidates = [root, *root.iterdir()]
+        except OSError:
+            continue
+        for tool in candidates:
+            if not tool.is_dir():
+                continue
+            native = False
+            if (tool / "proton").is_file():
+                for relative in ("files/bin/wine", "files/bin/wine64", "dist/bin/wine",
+                                 "files/lib/wine/aarch64-unix/wine"):
+                    try:
+                        with (tool / relative).open("rb") as stream:
+                            header = stream.read(20)
+                    except OSError:
+                        continue
+                    native |= header[:6] == b"\x7fELF\x02\x01" and header[18:20] == b"\xb7\x00"
+            if native:
+                tools.add(tool.resolve() / "user_settings.py")
+    return sorted(tools)
 
 
 def read_settings(f):
